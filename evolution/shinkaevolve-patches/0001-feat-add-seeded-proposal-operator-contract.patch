+
+    first = asyncio.run(
+        runner._run_controlled_operator_async(
+            parent_program=_program(),
+            inspirations=(),
+            generation=3,
+            novelty_attempt=1,
+            resample_attempt=1,
+            exec_fname=str(target),
+            needs_fix=False,
+        )
