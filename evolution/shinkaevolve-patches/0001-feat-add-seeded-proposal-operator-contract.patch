@@ -0,0 +1,147 @@
+from __future__ import annotations
+
+import asyncio
+import random
+
+import pytest
+
+from shinka.core.async_runner import ShinkaEvolveRunner
+from shinka.core.proposal_operator import (
+    ProposalOffspring,
+    derive_operator_seed,
+    invoke_proposal_operator,
+)
+from shinka.database import Program
+from shinka.edit.apply_numeric import apply_numeric_patch
+
+
+def _program(code: str = "parent") -> Program:
+    return Program(id="p", code=code, language="python", correct=True)
+
+
+class SeedEchoOperator:
+    name = "seed-echo"
+
+    def __call__(self, parent, inspirations, rng):
+        del inspirations
+        return ProposalOffspring(
+            source=f"{parent.code}:{rng.randrange(1_000_000)}",
+            metadata={"arm": self.name},
+        )
