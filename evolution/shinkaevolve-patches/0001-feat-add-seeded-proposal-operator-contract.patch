+++ b/tests/test_numeric_patch.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+import asyncio
+
+from shinka.core.sampler import PromptSampler
+from shinka.database import Program
+from shinka.edit.apply_numeric import apply_numeric_patch
+from shinka.edit.async_apply import apply_patch_async
+
+
+PYTHON_PROGRAM = """IMMUTABLE_LIMIT = 10
+
+# EVOLVE-BLOCK-START
+def policy(x):
+    label = "keep 20 in this string"
+    # keep 80 in this comment
+    fast_window = 20
+    entry_band = 0.0005
+    return x * fast_window + entry_band
+# EVOLVE-BLOCK-END
+
+def outside():
+    return IMMUTABLE_LIMIT
+"""
+
+
+def test_apply_numeric_patch_mutates_named_constants_inside_evolve_block(tmp_path):
+    updated, num_applied, output_path, error, patch_txt, diff_path = (
+        apply_numeric_patch(
+            original_str=PYTHON_PROGRAM,
+            patch_dir=tmp_path,
+            language="python",
+            mutation_count=2,
+            seed=3,
+        )
+    )
+
+    assert error is None
+    assert num_applied == 2
+    assert output_path == tmp_path / "main.py"
+    assert diff_path == tmp_path / "edit.diff"
+    assert patch_txt is not None and "fast_window" in patch_txt
+    assert updated != PYTHON_PROGRAM
+    assert "IMMUTABLE_LIMIT = 10" in updated
+    assert '"keep 20 in this string"' in updated
+    assert "# keep 80 in this comment" in updated
+    compile(updated, "candidate.py", "exec")
+
+
+def test_apply_numeric_patch_rejects_program_without_numeric_literals():
+    program = """# EVOLVE-BLOCK-START
+def f():
+    return name
+# EVOLVE-BLOCK-END
+"""
+
+    updated, num_applied, output_path, error, patch_txt, diff_path = (
+        apply_numeric_patch(original_str=program, language="python", seed=1)
+    )
+
+    assert updated == program
+    assert num_applied == 0
+    assert output_path is None
+    assert error == "No numeric constants found inside EVOLVE blocks"
+    assert patch_txt is None
+    assert diff_path is None
+
+
+def test_apply_patch_async_dispatches_numeric_patch(tmp_path):
+    updated, num_applied, output_path, error, patch_txt, diff_path = asyncio.run(
+        apply_patch_async(
+            original_str=PYTHON_PROGRAM,
+            patch_str="",
+            patch_dir=str(tmp_path),
+            language="python",
+            patch_type="numeric",
+            seed=7,
+        )
+    )
+
+    assert error is None
+    assert num_applied >= 1
+    assert output_path == tmp_path / "main.py"
+    assert patch_txt is not None
+    assert diff_path == tmp_path / "edit.diff"
+    assert updated is not None and updated != PYTHON_PROGRAM
+
+
+def test_prompt_sampler_accepts_numeric_patch_type():
+    sampler = PromptSampler(
+        patch_types=["numeric"],
+        patch_type_probs=[1.0],
+        language="python",
+    )
+    parent = Program(
+        id="parent",
+        code=PYTHON_PROGRAM,
+        language="python",
+        generation=0,
+        combined_score=1.0,
+        public_metrics={},
+    )
+
+    _system_msg, user_msg, patch_type = sampler.sample(
+        parent=parent,
+        archive_inspirations=[],
+        top_k_inspirations=[],
+    )
+
+    assert patch_type == "numeric"
+    assert "does not query the LLM" in user_msg
