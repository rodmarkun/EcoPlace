+++ b/shinka/core/proposal_operator.py
@@ -0,0 +1,107 @@
+"""Common proposal-operator contract for controlled evolutionary ablations.
+
+The runner owns parent/inspiration selection, retry policy, evaluation, persistence,
+and survivor selection.  An operator owns only offspring construction.  This keeps
+the LLM and grammar-guided GP arms on the same pipeline while making every source of
+operator randomness explicit and replayable.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import inspect
+import random
+from dataclasses import dataclass, field
+from typing import Any, Awaitable, Protocol, runtime_checkable
+
+from shinka.database import Program
+
+
+def derive_operator_seed(root_seed: int, *path: int) -> int:
+    """Stable, explicit 63-bit seed derivation for proposal attempts."""
+
+    if not isinstance(root_seed, int) or isinstance(root_seed, bool) or root_seed < 0:
+        raise ValueError("proposal root seed must be a non-negative int")
+    digest = hashlib.sha256(f"root:{root_seed}".encode("ascii"))
+    for component in path:
+        if (
+            not isinstance(component, int)
+            or isinstance(component, bool)
+            or component < 0
+        ):
+            raise ValueError("proposal seed path components must be non-negative ints")
+        digest.update(b"\x00")
+        digest.update(str(component).encode("ascii"))
+    return int.from_bytes(digest.digest()[:8], "big") & ((1 << 63) - 1)
+
+
+@dataclass(frozen=True)
+class ProposalOffspring:
+    """One operator result before evaluation.
+
+    ``source`` is ``None`` for an invalid proposal attempt.  Invalid attempts are
+    first-class results so the shared runner can count and archive them identically
+    for every arm instead of relying on operator-specific exceptions.
+    """
+
+    source: str | None
+    metadata: dict[str, Any] = field(default_factory=dict)
+    error: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.source is None and not self.error:
+            raise ValueError("an invalid proposal needs a non-empty error")
+        if self.source is not None and not isinstance(self.source, str):
+            raise TypeError("proposal source must be a string or None")
+        if not isinstance(self.metadata, dict):
+            raise TypeError("proposal metadata must be a dict")
+
+    @property
+    def valid(self) -> bool:
+        return self.source is not None
+
+
+@runtime_checkable
+class ProposalOperator(Protocol):
+    """Minimal controlled-ablation interface.
+
+    Implementations may be synchronous or asynchronous.  The RNG is constructed by
+    the runner from an explicit root seed and a stable proposal-attempt path; an
+    operator must not consult global randomness or OS entropy.
+    """
+
+    name: str
+
+    def __call__(
+        self,
+        parent: Program,
+        inspirations: tuple[Program, ...],
+        rng: random.Random,
+    ) -> ProposalOffspring | Awaitable[ProposalOffspring]: ...
+
+
+async def invoke_proposal_operator(
+    operator: ProposalOperator,
+    parent: Program,
+    inspirations: tuple[Program, ...],
+    rng: random.Random,
+) -> ProposalOffspring:
+    """Invoke and validate either form of the common operator contract."""
+
+    result = operator(parent, inspirations, rng)
+    if inspect.isawaitable(result):
+        result = await result
+    if not isinstance(result, ProposalOffspring):
+        raise TypeError(
+            f"proposal operator {operator.name!r} returned {type(result).__name__}; "
+            "expected ProposalOffspring"
+        )
+    return result
+
+
+__all__ = [
+    "ProposalOffspring",
+    "ProposalOperator",
+    "derive_operator_seed",
+    "invoke_proposal_operator",
+]
