+def test_contract_accepts_sync_and_async_operators():
+    parent = _program()
+    sync_result = asyncio.run(
+        invoke_proposal_operator(SeedEchoOperator(), parent, (), random.Random(7))
+    )
+    assert sync_result.valid
+
+    class AsyncOperator:
+        name = "async"
+
+        async def __call__(self, parent, inspirations, rng):
+            del inspirations, rng
+            return ProposalOffspring(source=parent.code + ":async")
+
+    async_result = asyncio.run(
+        invoke_proposal_operator(AsyncOperator(), parent, (), random.Random(7))
+    )
+    assert async_result.source == "parent:async"
