--- /dev/null
+++ b/shinka/edit/apply_numeric.py
@@ -0,0 +1,390 @@
+"""Numeric-constant mutation patches for local, LLM-free exploration."""
+
+from __future__ import annotations
+
+import ast
+import random
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Optional, Union
+
+from shinka.utils.languages import get_language_extension, normalize_language
+
+from .apply_diff import _inside, _mutable_ranges, write_git_diff
+from .marker_validation import validate_evolve_markers
+
+
+@dataclass(frozen=True)
+class NumericLiteral:
+    start: int
+    end: int
+    text: str
+    prefer_int: bool
+    assigned_name: str | None = None
+
+
+_NUMBER_RE = re.compile(
+    r"(?<![\w.])[-+]?(?:(?:\d+\.\d*)|(?:\.\d+)|(?:\d+))(?:[eE][-+]?\d+)?(?![\w.])"
+)
+
+
+def _line_offsets(text: str) -> list[int]:
+    offsets = [0]
+    for line in text.splitlines(keepends=True):
+        offsets.append(offsets[-1] + len(line))
+    return offsets
+
+
+def _node_span(node: ast.AST, line_offsets: list[int]) -> tuple[int, int] | None:
+    if not all(
+        hasattr(node, attr)
+        for attr in ("lineno", "col_offset", "end_lineno", "end_col_offset")
+    ):
+        return None
+    start = line_offsets[node.lineno - 1] + node.col_offset
+    end = line_offsets[node.end_lineno - 1] + node.end_col_offset
+    return start, end
+
+
+def _line_for_offset(text: str, offset: int) -> str:
+    line_start = text.rfind("\n", 0, offset) + 1
+    line_end = text.find("\n", offset)
+    if line_end == -1:
+        line_end = len(text)
+    return text[line_start:line_end]
+
+
+def _is_python_number(value: object) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def _literal_from_value_node(
+    original: str,
+    mutable: list[tuple[int, int]],
+    line_offsets: list[int],
+    value_node: ast.AST,
+    assigned_name: str | None,
+) -> NumericLiteral | None:
+    if not isinstance(value_node, ast.Constant) or not _is_python_number(
+        value_node.value
+    ):
+        return None
+
+    span = _node_span(value_node, line_offsets)
+    if span is None or not _inside(span, mutable):
+        return None
+
+    start, end = span
+    literal = original[start:end]
+    if not literal.strip():
+        return None
+
+    prefer_int = isinstance(value_node.value, int)
+    return NumericLiteral(
+        start=start,
+        end=end,
+        text=literal,
+        prefer_int=prefer_int,
+        assigned_name=assigned_name,
+    )
+
+
+def _python_named_numeric_literals(
+    original: str, mutable: list[tuple[int, int]]
+) -> list[NumericLiteral]:
+    try:
+        tree = ast.parse(original)
+    except SyntaxError:
+        return []
+
+    offsets = _line_offsets(original)
+    literals: list[NumericLiteral] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Assign):
+            target_names = [t.id for t in node.targets if isinstance(t, ast.Name)]
+            if not target_names:
+                continue
+            literal = _literal_from_value_node(
+                original,
+                mutable,
+                offsets,
+                node.value,
+                assigned_name=target_names[0],
+            )
+            if literal is not None:
+                literals.append(literal)
+        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
+            literal = _literal_from_value_node(
+                original,
+                mutable,
+                offsets,
+                node.value,
+                assigned_name=node.target.id,
+            )
+            if literal is not None:
+                literals.append(literal)
+
+    return literals
+
+
+def _python_numeric_literals(
+    original: str, mutable: list[tuple[int, int]]
+) -> list[NumericLiteral]:
+    """Fallback for Python code without named numeric hyperparameters."""
+    try:
+        tree = ast.parse(original)
+    except SyntaxError:
+        return []
+
+    offsets = _line_offsets(original)
+    literals: list[NumericLiteral] = []
+    seen: set[tuple[int, int]] = set()
+    for node in ast.walk(tree):
+        literal = _literal_from_value_node(
+            original,
+            mutable,
+            offsets,
+            node,
+            assigned_name=None,
+        )
+        if literal is None:
+            continue
+        if (literal.start, literal.end) in seen:
+            continue
+        if "clip(" in _line_for_offset(original, literal.start):
+            continue
+        seen.add((literal.start, literal.end))
+        literals.append(literal)
+    return literals
+
+
+def _regex_numeric_literals(
+    original: str, mutable: list[tuple[int, int]]
+) -> list[NumericLiteral]:
+    literals: list[NumericLiteral] = []
+    for start, end in mutable:
+        for match in _NUMBER_RE.finditer(original[start:end]):
+            span_start = start + match.start()
+            span_end = start + match.end()
+            text = match.group(0)
+            prefer_int = "." not in text and "e" not in text.lower()
+            literals.append(
+                NumericLiteral(
+                    start=span_start,
+                    end=span_end,
+                    text=text,
+                    prefer_int=prefer_int,
+                )
+            )
+    return literals
+
+
+def _numeric_literals(
+    original: str,
+    mutable: list[tuple[int, int]],
+    language: str,
+) -> list[NumericLiteral]:
+    try:
+        normalized = normalize_language(language)
+    except ValueError:
+        normalized = language.strip().lower()
+
+    if normalized == "python":
+        named = _python_named_numeric_literals(original, mutable)
+        if named:
+            return named
+        return _python_numeric_literals(original, mutable)
+
+    return _regex_numeric_literals(original, mutable)
+
+
+def _parse_literal(literal: NumericLiteral) -> int | float | None:
+    try:
+        if literal.prefer_int:
+            return int(literal.text.replace("_", ""), 10)
+        return float(literal.text.replace("_", ""))
+    except ValueError:
+        return None
+
+
+def _mutate_int(value: int, rng: random.Random) -> int:
+    if value == 0:
+        return rng.choice([-1, 1])
+
+    magnitude = max(1, abs(value))
+    step = max(1, int(round(magnitude * rng.choice([0.05, 0.1, 0.15, 0.2]))))
+    mutated = value + rng.choice([-step, step])
+    if value > 0:
+        return max(1, mutated)
+    return min(-1, mutated)
+
+
+def _mutate_float(value: float, rng: random.Random) -> float:
+    if value == 0.0:
+        return rng.choice([-1.0, 1.0]) * rng.choice([1e-4, 1e-3, 1e-2])
+    return value * rng.choice([0.5, 0.7, 0.85, 0.9, 1.1, 1.15, 1.3, 1.5, 2.0])
+
+
+def _format_mutated_value(value: int | float, literal: NumericLiteral) -> str:
+    if literal.prefer_int:
+        return str(int(value))
+
+    text = f"{float(value):.12g}"
+    original = literal.text.lower()
+    if "e" not in text and "." not in text and ("." in original or "e" in original):
+        text += ".0"
+    return text
+
+
+def _mutated_text(literal: NumericLiteral, rng: random.Random) -> str | None:
+    value = _parse_literal(literal)
+    if value is None:
+        return None
+
+    for _ in range(10):
+        if literal.prefer_int:
+            mutated: int | float = _mutate_int(int(value), rng)
+        else:
+            mutated = _mutate_float(float(value), rng)
+        new_text = _format_mutated_value(mutated, literal)
+        if new_text != literal.text:
+            return new_text
+    return None
+
+
+def _build_patch_notes(
+    selected: list[tuple[NumericLiteral, str]],
+) -> str:
+    lines = ["Numeric constant mutation:"]
+    for literal, replacement in selected:
+        name = f"{literal.assigned_name}: " if literal.assigned_name else ""
+        lines.append(f"- {name}{literal.text} -> {replacement}")
+    return "\n".join(lines) + "\n"
+
+
+def apply_numeric_patch(
+    patch_str: str = "",
+    original_str: Optional[str] = None,
+    patch_dir: Optional[Union[str, Path]] = None,
+    original_path: Optional[Union[str, Path]] = None,
+    language: str = "python",
+    verbose: bool = True,
+    mutation_count: int | None = None,
+    *,
+    seed: int,
+) -> tuple[str, int, Optional[Path], Optional[str], Optional[str], Optional[Path]]:
+    """Mutate numeric constants inside EVOLVE blocks and emit normal patch files.
+
+    `patch_str` is accepted for interface compatibility with LLM-driven patch
+    applicators, but local numeric mutation does not read it.
+    """
+    del patch_str, verbose
+
+    if not isinstance(seed, int) or isinstance(seed, bool) or seed < 0:
+        raise ValueError("numeric mutation seed must be an explicit non-negative int")
+
+    if original_str is None and original_path is None:
+        raise ValueError("Either original_str or original_path must be provided")
+    if original_str is None:
+        if original_path is None:
+            raise ValueError("original_path cannot be None")
+        original = Path(original_path).read_text("utf-8")
+    else:
+        original = original_str
+
+    mutable = _mutable_ranges(original)
+    if not mutable:
+        return (
+            original,
+            0,
+            None,
+            "No EVOLVE-BLOCK regions found in original content",
+            None,
+            None,
+        )
+
+    literals = _numeric_literals(original, mutable, language)
+    if not literals:
+        return (
+            original,
+            0,
+            None,
+            "No numeric constants found inside EVOLVE blocks",
+            None,
+            None,
+        )
+
+    rng = random.Random(seed)
+    max_mutations = min(len(literals), 2)
+    if mutation_count is None:
+        mutation_count = rng.randint(1, max_mutations)
+    mutation_count = max(1, min(mutation_count, len(literals)))
+
+    candidates = literals[:]
+    rng.shuffle(candidates)
+    selected: list[tuple[NumericLiteral, str]] = []
+    used_spans: set[tuple[int, int]] = set()
+    for literal in candidates:
+        span = (literal.start, literal.end)
+        if span in used_spans:
+            continue
+        replacement = _mutated_text(literal, rng)
+        if replacement is None:
+            continue
+        selected.append((literal, replacement))
+        used_spans.add(span)
+        if len(selected) >= mutation_count:
+            break
+
+    if not selected:
+        return (
+            original,
+            0,
+            None,
+            "Numeric mutation could not produce a changed literal",
+            None,
+            None,
+        )
+
+    updated = original
+    for literal, replacement in sorted(
+        selected, key=lambda item: item[0].start, reverse=True
+    ):
+        updated = updated[: literal.start] + replacement + updated[literal.end :]
+
+    marker_err = validate_evolve_markers(updated, language)
+    if marker_err is not None:
+        return original, 0, None, marker_err, None, None
+
+    if updated == original:
+        return original, 0, None, "Numeric mutation produced no change", None, None
+
+    suffix = f".{get_language_extension(language)}"
+    patch_txt: Optional[str] = None
+    patch_path: Optional[Path] = None
+    output_path: Optional[Path] = None
+
+    if patch_dir is not None:
+        patch_dir = Path(patch_dir)
+        patch_dir.mkdir(parents=True, exist_ok=True)
+        (patch_dir / "numeric_mutation.txt").write_text(
+            _build_patch_notes(selected),
+            encoding="utf-8",
+        )
+
+        backup_path = patch_dir / f"original{suffix}"
+        backup_path.write_text(original, encoding="utf-8")
+
+        output_path = patch_dir / f"main{suffix}"
+        output_path.write_text(updated, encoding="utf-8")
+
+        patch_path = write_git_diff(
+            original,
+            updated,
+            filename=backup_path.name,
+            out_path=patch_dir / "edit.diff",
+        )
+        patch_txt = patch_path.read_text(encoding="utf-8")
+
+    return updated, len(selected), output_path, None, patch_txt, patch_path
