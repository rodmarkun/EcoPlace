def free_fraction_after(pod: Pod, node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request)
    mem_after = float(node.mem_allocated + pod.mem_request)
    cpu_free = max(cpu_cap - cpu_after, 0.0) / cpu_cap
    mem_free = max(mem_cap - mem_after, 0.0) / mem_cap
    balanced_free = min(cpu_free, mem_free)
    average_free = (cpu_free + mem_free) / 2.0
    imbalance = max(cpu_free, mem_free) - balanced_free
    return balanced_free * 0.70 + average_free * 0.25 - imbalance * 0.05


def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1.0
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    if cpu_after > node.cpu_capacity or mem_after > node.mem_capacity:
        return -1.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after_util = float(cpu_after) / cpu_cap
    mem_after_util = float(mem_after) / mem_cap
    after_pressure = max(cpu_after_util, mem_after_util)
    balanced_headroom = free_fraction_after(pod, node)
    return balanced_headroom * 0.85 + (1.0 - after_pressure) * 0.15
