# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def is_used(used: list[int], target: int) -> bool:
    for i in range(len(used)):
        if used[i] == target:
            return True
    return False

def count_pods_on_node(state: ClusterState, node_id: int) -> int:
    count = 0
    for i in range(len(state.pods)):
        if state.pods[i].current_node == node_id:
            count += 1
    return count

def count_neighbors_on_node(pod: Pod, state: ClusterState, graph: CallGraphCtx, node_id: int) -> int:
    count = 0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node == node_id:
                count += 1
    return count

def find_best_neighbor_node(pod: Pod, state: ClusterState, graph: CallGraphCtx) -> int:
    target = -1
    best_count = -1
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0 and neighbor.current_node != pod.current_node:
                candidate = neighbor.current_node
                count = count_neighbors_on_node(pod, state, graph, candidate)
                if count > best_count:
                    best_count = count
                    target = candidate
    return target

def latency_cost(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
    return total

def cpu_util_after(pod: Pod, node: NodeState) -> float:
    if node.cpu_capacity <= 0:
        return 1.0
    return float(node.cpu_allocated + pod.cpu_request) / float(node.cpu_capacity)

def mem_util_after(pod: Pod, node: NodeState) -> float:
    if node.mem_capacity <= 0:
        return 1.0
    return float(node.mem_allocated + pod.mem_request) / float(node.mem_capacity)

def power_increment(pod: Pod, node: NodeState) -> float:
    if node.cpu_capacity <= 0:
        return 0.0
    cpu_share = float(pod.cpu_request) / float(node.cpu_capacity)
    return (node.power_max_w - node.power_idle_w) * cpu_share

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    lat = latency_cost(pod, node, ctx)
    cpu = cpu_util_after(pod, node)
    mem = mem_util_after(pod, node)
    press = cpu + mem
    power = power_increment(pod, node)
    headroom_penalty = 0.0
    if cpu > 0.8:
        headroom_penalty += (cpu - 0.8) * 1000.0
    if mem > 0.8:
        headroom_penalty += (mem - 0.8) * 1000.0
    cost = lat * 1000.0 + press * 200.0 + power * 0.5 + headroom_penalty
    if node.suspended:
        cost += 20000.0
    if node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        cost += 10000.0
    if not node.suspendable:
        cost -= 100.0
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    used: list[int] = []
    for i in range(len(state.pods)):
        if len(out) >= budget:
            return out
        pod = state.pods[i]
        if pod.current_node >= 0 and not pod.stateful and not pod.has_pdb:
            count = count_pods_on_node(state, pod.current_node)
            if count == 1:
                current_neighbors = count_neighbors_on_node(pod, state, graph, pod.current_node)
                target = find_best_neighbor_node(pod, state, graph)
                if target >= 0 and target != pod.current_node:
                    target_neighbors = count_neighbors_on_node(pod, state, graph, target)
                    if target_neighbors > current_neighbors:
                        already = is_used(used, target)
                        if not already:
                            used.append(target)
                            move = move_pod(pod.id, target)
                            out.append(move)
    return out
# EVOLVE-BLOCK-END
