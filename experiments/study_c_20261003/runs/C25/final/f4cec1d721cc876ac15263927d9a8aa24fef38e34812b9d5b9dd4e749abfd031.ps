# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def headroom_ratio(used: int, capacity: int) -> float:
    if capacity <= 0:
        return 0.0
    remain = capacity - used
    if remain < 0:
        return 0.0
    return float(remain) / float(capacity)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cpu_h = headroom_ratio(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem_h = headroom_ratio(node.mem_allocated + pod.mem_request, node.mem_capacity)
    min_h = cpu_h
    if mem_h < min_h:
        min_h = mem_h

    headroom = min_h * 30.0
    if min_h < 0.20:
        headroom -= (0.20 - min_h) * 200.0

    pack = 0.0
    if node.cpu_allocated > 0 or node.mem_allocated > 0:
        if min_h > 0.25:
            pack = 30.0

    penalty = 0.0
    if node.suspended:
        penalty = 200.0

    lat = 0.0
    count = 0
    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                lat += node.latency_to_ms[neighbor.current_node]
                count += 1

    avg_lat = 0.0
    if count > 0:
        avg_lat = lat / float(count)

    latency_penalty = avg_lat * 4.0
    return headroom + pack - penalty - latency_penalty

def node_score_for(pod: Pod, node: NodeState, state: ClusterState, graph: CallGraphCtx) -> float:
    cpu_h = headroom_ratio(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem_h = headroom_ratio(node.mem_allocated + pod.mem_request, node.mem_capacity)
    min_h = cpu_h
    if mem_h < min_h:
        min_h = mem_h

    headroom = min_h * 30.0
    if min_h < 0.20:
        headroom -= (0.20 - min_h) * 200.0

    pack = 0.0
    if node.cpu_allocated > 0 or node.mem_allocated > 0:
        if min_h > 0.25:
            pack = 30.0

    penalty = 0.0
    if node.suspended:
        penalty = 200.0

    lat = 0.0
    count = 0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                lat += node.latency_to_ms[neighbor.current_node]
                count += 1

    avg_lat = 0.0
    if count > 0:
        avg_lat = lat / float(count)

    latency_penalty = avg_lat * 4.0
    return headroom + pack - penalty - latency_penalty

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out

    for i in range(len(state.pods)):
        if len(out) >= budget:
            return out

        pod = state.pods[i]
        movable = pod.current_node >= 0 and not pod.stateful and not pod.has_pdb
        if movable:
            current = pod.current_node
            current_score = node_score_for(pod, state.nodes[current], state, graph)
            best_score = current_score
            best_node = -1

            for j in range(len(state.nodes)):
                candidate = state.nodes[j]
                fits = candidate.cpu_allocated + pod.cpu_request <= candidate.cpu_capacity and candidate.mem_allocated + pod.mem_request <= candidate.mem_capacity
                if j != current and fits and not candidate.suspended:
                    s = node_score_for(pod, candidate, state, graph)
                    if s > best_score + 5.0:
                        best_score = s
                        best_node = j

            if best_node >= 0:
                out.append(move_pod(pod.id, best_node))

    return out
# EVOLVE-BLOCK-END
