# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def compute_score(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0
    cpu_before = float(node.cpu_allocated) / cpu_cap
    mem_before = float(node.mem_allocated) / mem_cap
    peak_before = max(cpu_before, mem_before)
    headroom = 1.0 - peak

    power_range = node.power_max_w - node.power_idle_w
    delta_util = peak - peak_before
    if delta_util < 0.0:
        delta_util = 0.0
    power_delta = power_range * delta_util
    empty = node.cpu_allocated == 0 and node.mem_allocated == 0
    if empty and node.suspendable:
        power_delta = power_delta + node.power_idle_w
    energy_cost = power_delta / 120.0
    if energy_cost > 1.0:
        energy_cost = 1.0

    weighted = 0.0
    weight = 0.0
    edges = len(graph.src)
    for e in range(edges):
        s = graph.src[e]
        d = graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                rate = graph.rate[e]
                weighted = weighted + rate * node.latency_to_ms[neighbor.current_node]
                weight = weight + rate
    proximity = 0.5
    if weight > 0.0:
        mean_latency = weighted / weight
        scaled = mean_latency / 45.0
        if scaled > 1.0:
            scaled = 1.0
        proximity = 1.0 - scaled

    headroom_score = headroom
    if headroom < 0.2:
        headroom_score = headroom * 0.2

    # Re-balanced toward energy: the L2 candidate is feasible with SLO margin, so
    # shifting weight from proximity/headroom (SLO levers that are already satisfied)
    # onto the negated power term gives the scheduler more reason to prefer
    # already-consolidated, low-power nodes without breaking queueing margins.
    return proximity * 0.32 + headroom_score * 0.35 - energy_cost * 0.33

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return compute_score(pod, node, ctx.pods, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    for i in range(len(state.pods)):
        pod = state.pods[i]
        if moved < budget and pod.current_node >= 0 and not pod.stateful and not pod.has_pdb:
            current_node = state.nodes[pod.current_node]
            current_score = compute_score(pod, current_node, state.pods, graph)
            best_node = -1
            best_score = -1000000.0
            for j in range(len(state.nodes)):
                node = state.nodes[j]
                if not node.suspended and j != pod.current_node:
                    cpu_cap = float(max(node.cpu_capacity, 1))
                    mem_cap = float(max(node.mem_capacity, 1))
                    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
                    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
                    peak = max(cpu_after, mem_after)
                    if peak < 0.85:
                        s = compute_score(pod, node, state.pods, graph)
                        if s > best_score:
                            best_score = s
                            best_node = j
            if best_node >= 0 and best_score > current_score + 0.05:
                out.append(move_pod(pod.id, best_node))
                moved = moved + 1
    return out
# EVOLVE-BLOCK-END
