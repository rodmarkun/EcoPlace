# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0:
        return 0
    used = min(requested, capacity)
    return (used * 2) // capacity

def overload_penalty(node: NodeState, pod: Pod) -> float:
    cpu_used = node.cpu_allocated + pod.cpu_request
    mem_used = node.mem_allocated + pod.mem_request
    penalty = 0.0
    if node.cpu_capacity > 0:
        cpu_ratio = float(cpu_used) / float(node.cpu_capacity)
        if cpu_ratio > 0.80:
            penalty += (cpu_ratio - 0.80) * (cpu_ratio - 0.80)
    if node.mem_capacity > 0:
        mem_ratio = float(mem_used) / float(node.mem_capacity)
        if mem_ratio > 0.80:
            penalty += (mem_ratio - 0.80) * (mem_ratio - 0.80)
    return penalty

def dependency_latency(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
    return total

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    latency = dependency_latency(pod, node, ctx)
    penalty = overload_penalty(node, pod)
    cpu_used = node.cpu_allocated + pod.cpu_request
    mem_used = node.mem_allocated + pod.mem_request
    cpu_score = resource_score(cpu_used, node.cpu_capacity)
    mem_score = resource_score(mem_used, node.mem_capacity)
    packing = float(cpu_score + mem_score) * 0.5
    return packing * 6.0 - latency * 10.0 - penalty * 200.0

def node_cpu_used(state: ClusterState, node_index: int) -> int:
    total: int = 0
    for j in range(len(state.pods)):
        pod = state.pods[j]
        if pod.current_node == node_index:
            total += pod.cpu_request
    return total

def node_mem_used(state: ClusterState, node_index: int) -> int:
    total: int = 0
    for j in range(len(state.pods)):
        pod = state.pods[j]
        if pod.current_node == node_index:
            total += pod.mem_request
    return total

def node_pod_count(state: ClusterState, node_index: int) -> int:
    total: int = 0
    for j in range(len(state.pods)):
        pod = state.pods[j]
        if pod.current_node == node_index:
            total += 1
    return total

def fits(state: ClusterState, pod: Pod, node_index: int) -> bool:
    node = state.nodes[node_index]
    cpu_after = node_cpu_used(state, node_index) + pod.cpu_request
    mem_after = node_mem_used(state, node_index) + pod.mem_request
    if cpu_after > node.cpu_capacity:
        return False
    if mem_after > node.mem_capacity:
        return False
    return True

def contains_int(items: list[int], value: int) -> bool:
    found: bool = False
    for i in range(len(items)):
        if items[i] == value:
            found = True
    return found

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    moved: int = 0
    moved_from: list[int] = []
    moved_to: list[int] = []
    for i in range(len(state.pods)):
        if moved >= budget:
            return out
        pod = state.pods[i]
        cur = pod.current_node
        can_move = cur >= 0 and not pod.stateful and not pod.has_pdb
        if can_move:
            already_from = contains_int(moved_from, cur)
            if not already_from:
                cur_count = node_pod_count(state, cur)
                if cur_count > 0 and cur_count <= 2:
                    best = -1
                    best_count = 0
                    for n in range(len(state.nodes)):
                        eligible = n != cur and not state.nodes[n].suspended and fits(state, pod, n) and not contains_int(moved_to, n)
                        if eligible:
                            count = node_pod_count(state, n)
                            if count > best_count:
                                best_count = count
                                best = n
                    if best >= 0:
                        out.append(move_pod(pod.id, best))
                        moved += 1
                        moved_from.append(cur)
                        moved_to.append(best)
    return out
# EVOLVE-BLOCK-END
