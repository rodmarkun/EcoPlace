# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def latency_penalty(pod: Pod, node: NodeState, pods: list[Pod], nodes: list[NodeState], graph: CallGraphCtx) -> float:
    total = 0.0
    count = 0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                neighbor_node = nodes[neighbor.current_node]
                lat = node.latency_to_ms[neighbor.current_node]
                if node.tier != neighbor_node.tier:
                    lat = lat * 2.0
                total += lat
                count += 1
    if count > 0:
        return total / float(count)
    return 0.0

def energy_at(cpu_alloc: int, mem_alloc: int, node: NodeState) -> float:
    cpu_util = 0.0
    mem_util = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(cpu_alloc) / float(node.cpu_capacity)
    if node.mem_capacity > 0:
        mem_util = float(mem_alloc) / float(node.mem_capacity)
    util = cpu_util
    if mem_util > util:
        util = mem_util
    if util > 1.0:
        util = 1.0
    return (node.power_max_w - node.power_idle_w) * util

def node_utility_at(pod: Pod, node: NodeState, pods: list[Pod], nodes: list[NodeState], graph: CallGraphCtx, cpu_alloc: int, mem_alloc: int) -> float:
    if node.suspended:
        return -1000000.0
    if node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        return -1000.0
    cpu = resource_score(cpu_alloc, node.cpu_capacity)
    mem = resource_score(mem_alloc, node.mem_capacity)
    headroom = float((cpu + mem) // 2)
    lat = latency_penalty(pod, node, pods, nodes, graph)
    energy = energy_at(cpu_alloc, mem_alloc, node)
    return headroom - lat * 4.0 - energy * 0.2

def node_utility(pod: Pod, node: NodeState, pods: list[Pod], nodes: list[NodeState], graph: CallGraphCtx) -> float:
    cpu_alloc = node.cpu_allocated + pod.cpu_request
    mem_alloc = node.mem_allocated + pod.mem_request
    return node_utility_at(pod, node, pods, nodes, graph, cpu_alloc, mem_alloc)

def node_utility_current(pod: Pod, node: NodeState, pods: list[Pod], nodes: list[NodeState], graph: CallGraphCtx) -> float:
    return node_utility_at(pod, node, pods, nodes, graph, node.cpu_allocated, node.mem_allocated)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return node_utility(pod, node, ctx.pods, ctx.nodes, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    for i in range(len(state.pods)):
        if len(out) >= budget:
            return out
        pod = state.pods[i]
        eligible = not pod.stateful and not pod.has_pdb and pod.current_node >= 0
        if eligible:
            current = pod.current_node
            current_node = state.nodes[current]
            current_util = node_utility_current(pod, current_node, state.pods, state.nodes, graph)
            best_node = current
            best_util = current_util
            for j in range(len(state.nodes)):
                if j != current:
                    node = state.nodes[j]
                    fits = node.cpu_allocated + pod.cpu_request <= node.cpu_capacity and node.mem_allocated + pod.mem_request <= node.mem_capacity and not node.suspended
                    if fits:
                        util = node_utility(pod, node, state.pods, state.nodes, graph)
                        if util > best_util:
                            best_util = util
                            best_node = j
            empty_after = current_node.suspendable and current_node.cpu_allocated == pod.cpu_request and current_node.mem_allocated == pod.mem_request
            threshold = 5.0 + float(pod.image_mb) * 0.002
            if empty_after:
                threshold = 1.0
            if best_node != current and best_util > current_util + threshold:
                out.append(move_pod(pod.id, best_node))
    return out
# EVOLVE-BLOCK-END
