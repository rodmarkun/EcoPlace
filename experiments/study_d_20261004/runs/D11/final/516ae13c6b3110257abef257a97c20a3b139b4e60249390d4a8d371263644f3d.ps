# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_before = float(node.cpu_allocated) / cpu_cap
    mem_before = float(node.mem_allocated) / mem_cap
    peak_before = max(cpu_before, mem_before)
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0
    headroom = 1.0 - peak
    queue = headroom * headroom
    weighted = 0.0
    weight = 0.0
    max_latency = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * latency
                weight = weight + rate
                max_latency = max(max_latency, latency)
    proximity = 0.5
    if weight > 0.0:
        mean_latency = weighted / weight
        prox_mean = 45.0 / (45.0 + mean_latency)
        prox_max = 45.0 / (45.0 + max_latency)
        proximity = prox_mean * 0.5 + prox_max * 0.5
    delta = peak - peak_before
    marginal = (node.power_max_w - node.power_idle_w) * delta
    energy_term = 1.0 - min(marginal / 50.0, 1.0)
    active = 0.0
    if node.cpu_allocated > 0 or node.mem_allocated > 0:
        active = 1.0
    wake_penalty = 0.0
    if node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        wake_penalty = 1.0
    return queue * 0.25 + proximity * 0.35 + energy_term * 0.25 + active * 0.15 - wake_penalty * 0.15

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        source_pod = state.pods[graph.src[e]]
        dest_pod = state.pods[graph.dst[e]]
        movable = (
            moved < budget
            and graph.rate[e] > 1.0
            and source_pod.current_node >= 0
            and dest_pod.current_node >= 0
            and source_pod.current_node != dest_pod.current_node
            and not source_pod.stateful
            and not source_pod.has_pdb
            and not state.nodes[source_pod.current_node].suspended
        )
        if movable:
            src_node = state.nodes[source_pod.current_node]
            dst_node = state.nodes[dest_pod.current_node]
            cpu_cap = float(max(dst_node.cpu_capacity, 1))
            mem_cap = float(max(dst_node.mem_capacity, 1))
            cpu_after = float(dst_node.cpu_allocated + source_pod.cpu_request) / cpu_cap
            mem_after = float(dst_node.mem_allocated + source_pod.mem_request) / mem_cap
            target_ok = not dst_node.suspended and max(cpu_after, mem_after) < 0.75
            frees_cpu = src_node.cpu_allocated <= source_pod.cpu_request
            frees_mem = src_node.mem_allocated <= source_pod.mem_request
            frees = frees_cpu and frees_mem and src_node.suspendable
            move_ok = target_ok and (frees or src_node.power_idle_w > dst_node.power_idle_w)
            if move_ok:
                out.append(move_pod(source_pod.id, dest_pod.current_node))
                moved = moved + 1
    return out
# EVOLVE-BLOCK-END
