# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def util_from_alloc(allocated: int, capacity: int) -> float:
    if capacity == 0:
        return 0.0
    if allocated > capacity:
        return 1.0
    return float(allocated) / float(capacity)

def node_power(node: NodeState, cpu_util: float, mem_util: float) -> float:
    max_util = max(cpu_util, mem_util)
    return node.power_idle_w + (node.power_max_w - node.power_idle_w) * max_util

def placement_score_alloc(pod: Pod, node: NodeState, cpu_alloc: int, mem_alloc: int) -> float:
    cpu_util = util_from_alloc(cpu_alloc, node.cpu_capacity)
    mem_util = util_from_alloc(mem_alloc, node.mem_capacity)
    power = node_power(node, cpu_util, mem_util)
    headroom_penalty = (cpu_util + mem_util) * 50.0
    if cpu_util > 0.8:
        headroom_penalty = headroom_penalty + (cpu_util - 0.8) * 500.0
    if mem_util > 0.8:
        headroom_penalty = headroom_penalty + (mem_util - 0.8) * 500.0
    tier_penalty = float(node.tier) * 5.0
    suspend_penalty = 0.0
    if node.suspended:
        suspend_penalty = 100.0
    total_cost = power + headroom_penalty + tier_penalty + suspend_penalty
    return -total_cost

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cpu_util = util_from_alloc(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem_util = util_from_alloc(node.mem_allocated + pod.mem_request, node.mem_capacity)
    power = node_power(node, cpu_util, mem_util)
    headroom_penalty = (cpu_util + mem_util) * 50.0
    if cpu_util > 0.8:
        headroom_penalty = headroom_penalty + (cpu_util - 0.8) * 500.0
    if mem_util > 0.8:
        headroom_penalty = headroom_penalty + (mem_util - 0.8) * 500.0
    tier_penalty = float(node.tier) * 5.0
    suspend_penalty = 0.0
    if node.suspended:
        suspend_penalty = 100.0
    edge_penalty = 0.0
    pod_idx = -1
    for i in range(len(ctx.pods)):
        if ctx.pods[i].id == pod.id:
            pod_idx = i
    if pod_idx >= 0:
        for e in range(len(ctx.graph.src)):
            if ctx.graph.src[e] == pod_idx or ctx.graph.dst[e] == pod_idx:
                other = ctx.graph.dst[e]
                if ctx.graph.src[e] == pod_idx:
                    other = ctx.graph.dst[e]
                else:
                    other = ctx.graph.src[e]
                if other >= 0 and other < len(ctx.pods):
                    other_node = ctx.pods[other].current_node
                    if other_node != -1:
                        if node.tier != ctx.nodes[other_node].tier:
                            edge_penalty = edge_penalty + 20.0
    total_cost = power + headroom_penalty + tier_penalty + suspend_penalty + edge_penalty
    return -total_cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    count = 0
    for i in range(len(state.pods)):
        if count >= budget:
            return out
        pod = state.pods[i]
        if pod.current_node != -1 and not pod.stateful and not pod.has_pdb:
            current_node = state.nodes[pod.current_node]
            cpu_alloc = current_node.cpu_allocated - pod.cpu_request
            mem_alloc = current_node.mem_allocated - pod.mem_request
            if cpu_alloc < 0:
                cpu_alloc = 0
            if mem_alloc < 0:
                mem_alloc = 0
            current_score = placement_score_alloc(pod, current_node, cpu_alloc, mem_alloc)
            best_node = -1
            best_score = current_score
            for j in range(len(state.nodes)):
                if j != pod.current_node:
                    node = state.nodes[j]
                    cpu_ok = node.cpu_allocated + pod.cpu_request <= node.cpu_capacity
                    mem_ok = node.mem_allocated + pod.mem_request <= node.mem_capacity
                    if cpu_ok and mem_ok:
                        cand_cpu = node.cpu_allocated + pod.cpu_request
                        cand_mem = node.mem_allocated + pod.mem_request
                        cand_score = placement_score_alloc(pod, node, cand_cpu, cand_mem)
                        if cand_score > best_score:
                            best_node = j
                            best_score = cand_score
            if best_node != -1:
                improvement = best_score - current_score
                if improvement > 5.0:
                    out.append(move_pod(pod.id, best_node))
                    count = count + 1
    return out
# EVOLVE-BLOCK-END
