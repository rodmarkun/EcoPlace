# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def marginal_power(pod: Pod, node: NodeState) -> float:
    cap = float(max(node.cpu_capacity, 1))
    span = max(node.power_max_w - node.power_idle_w, 0.0)
    return span * (float(pod.cpu_request) / cap)

def idle_efficiency(node: NodeState) -> float:
    return node.power_idle_w / float(max(node.cpu_capacity, 1))

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cost = marginal_power(pod, node)
    if node.suspended:
        cost += node.power_idle_w + 5.0
    if node.cpu_allocated == 0 and not node.suspended:
        cost += node.power_idle_w * 0.5
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0 or len(state.nodes) < 2:
        return out
    drain = -1
    drain_u = 2.0
    for node in state.nodes:
        if node.suspendable and not node.suspended:
            u = float(node.cpu_allocated) / float(max(node.cpu_capacity, 1))
            if u < drain_u and u < 0.3:
                drain_u = u
                drain = node.id
    if drain < 0:
        return out
    target = -1
    best = 1e18
    moved = 0
    for node in state.nodes:
        if not node.suspended and node.id != drain:
            eff = idle_efficiency(node)
            if eff < best:
                best = eff
                target = node.id
    if target < 0:
        for node in state.nodes:
            if node.suspended and node.id != drain:
                eff = idle_efficiency(node)
                if eff < best:
                    best = eff
                    target = node.id
        if target < 0 or budget < 2:
            return out
        # Waking is an explicit priced action and counts against the budget (spec §5.5).
        out.append(wake(target))
        moved = 1
    for pod in state.pods:
        if moved < budget and pod.current_node == drain:
            if not pod.stateful and not pod.has_pdb:
                out.append(move_pod(pod.id, target))
                moved += 1
    return out
# EVOLVE-BLOCK-END
