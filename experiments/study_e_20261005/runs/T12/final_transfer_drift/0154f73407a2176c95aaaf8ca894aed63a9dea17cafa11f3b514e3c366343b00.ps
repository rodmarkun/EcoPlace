# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_headroom(requested: int, capacity: int) -> float:
    if capacity == 0:
        return 0.0
    if requested > capacity:
        return 0.0
    free = capacity - requested
    return float(free) / float(capacity)


def graph_latency_total(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
    return total


def graph_latency_max(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    max_lat = 0.0
    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                lat = node.latency_to_ms[neighbor.current_node]
                if lat > max_lat:
                    max_lat = lat
    return max_lat


def queue_pressure(node: NodeState, pod: Pod) -> float:
    pen = 0.0
    if node.cpu_capacity > 0:
        cpu_after = node.cpu_allocated + pod.cpu_request
        cpu_util = float(cpu_after) / float(node.cpu_capacity)
        if cpu_util > 0.65:
            pen += (cpu_util - 0.65) * 700.0
    if node.mem_capacity > 0:
        mem_after = node.mem_allocated + pod.mem_request
        mem_util = float(mem_after) / float(node.mem_capacity)
        if mem_util > 0.65:
            pen += (mem_util - 0.65) * 700.0
    return pen


def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    latency_total = graph_latency_total(pod, node, ctx)
    latency_max = graph_latency_max(pod, node, ctx)
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_free = resource_headroom(cpu_after, node.cpu_capacity)
    mem_free = resource_headroom(mem_after, node.mem_capacity)

    head_pen = 0.0
    if cpu_free < 0.25:
        head_pen += (0.25 - cpu_free) * 320.0
    if mem_free < 0.25:
        head_pen += (0.25 - mem_free) * 320.0

    queue_pen = queue_pressure(node, pod)

    active_pen = 0.0
    if node.suspended:
        active_pen = 40.0

    util_bonus = 0.0
    if node.cpu_capacity > 0:
        util = float(node.cpu_allocated) / float(node.cpu_capacity)
        util_bonus = util * 4.0

    cost = latency_total * 7.0 + latency_max * 4.0 + head_pen + queue_pen + active_pen - util_bonus
    return -cost


def move_latency_total(pod: Pod, target: int, state: ClusterState, graph: CallGraphCtx) -> float:
    total = 0.0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                total += state.nodes[target].latency_to_ms[neighbor.current_node]
    return total


def move_latency_max(pod: Pod, target: int, state: ClusterState, graph: CallGraphCtx) -> float:
    max_lat = 0.0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                lat = state.nodes[target].latency_to_ms[neighbor.current_node]
                if lat > max_lat:
                    max_lat = lat
    return max_lat


def move_score(pod: Pod, target: int, state: ClusterState, graph: CallGraphCtx) -> float:
    latency_total = move_latency_total(pod, target, state, graph)
    latency_max = move_latency_max(pod, target, state, graph)
    cand = state.nodes[target]
    cpu_after = cand.cpu_allocated + pod.cpu_request
    mem_after = cand.mem_allocated + pod.mem_request
    cpu_free = resource_headroom(cpu_after, cand.cpu_capacity)
    mem_free = resource_headroom(mem_after, cand.mem_capacity)

    head_pen = 0.0
    if cpu_free < 0.25:
        head_pen += (0.25 - cpu_free) * 320.0
    if mem_free < 0.25:
        head_pen += (0.25 - mem_free) * 320.0

    queue_pen = queue_pressure(cand, pod)

    util_bonus = 0.0
    if cand.cpu_capacity > 0:
        util = float(cand.cpu_allocated) / float(cand.cpu_capacity)
        util_bonus = util * 4.0

    cost = latency_total * 7.0 + latency_max * 4.0 + head_pen + queue_pen - util_bonus
    return -cost


def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    for pod in state.pods:
        if len(out) >= budget:
            return out
        movable = pod.current_node >= 0 and not pod.has_pdb and not pod.stateful
        if movable:
            current = state.nodes[pod.current_node]
            cpu_ratio = 0.0
            if current.cpu_capacity > 0:
                cpu_ratio = float(current.cpu_allocated) / float(current.cpu_capacity)
            mem_ratio = 0.0
            if current.mem_capacity > 0:
                mem_ratio = float(current.mem_allocated) / float(current.mem_capacity)
            overloaded = cpu_ratio > 0.70 or mem_ratio > 0.70
            if overloaded:
                current_lat = move_latency_total(pod, pod.current_node, state, graph)
                target = -1
                best_score = -1000000.0
                for i in range(len(state.nodes)):
                    cand = state.nodes[i]
                    cpu_fit = cand.cpu_capacity - cand.cpu_allocated >= pod.cpu_request
                    mem_fit = cand.mem_capacity - cand.mem_allocated >= pod.mem_request
                    eligible = i != pod.current_node and not cand.suspended and cpu_fit and mem_fit
                    if eligible:
                        cpu_after = cand.cpu_allocated + pod.cpu_request
                        mem_after = cand.mem_allocated + pod.mem_request
                        cpu_free = resource_headroom(cpu_after, cand.cpu_capacity)
                        mem_free = resource_headroom(mem_after, cand.mem_capacity)
                        roomy = cpu_free >= 0.25 and mem_free >= 0.25
                        target_lat = move_latency_total(pod, i, state, graph)
                        lat_ok = target_lat <= current_lat * 1.15
                        if roomy and lat_ok:
                            score_val = move_score(pod, i, state, graph)
                            if score_val > best_score:
                                best_score = score_val
                                target = i
                if target >= 0:
                    out.append(move_pod(pod.id, target))
    return out
# EVOLVE-BLOCK-END
