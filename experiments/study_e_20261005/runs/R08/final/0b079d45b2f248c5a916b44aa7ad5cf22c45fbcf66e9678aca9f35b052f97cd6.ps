# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def graph_latency(pod: Pod, node: NodeState, graph: CallGraphCtx, pods: list[Pod]) -> float:
    total: float = 0.0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
    return total

def node_power(node: NodeState) -> float:
    cpu_util = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(node.cpu_allocated) / float(node.cpu_capacity)
    mem_util = 0.0
    if node.mem_capacity > 0:
        mem_util = float(node.mem_allocated) / float(node.mem_capacity)
    util = max(cpu_util, mem_util)
    return node.power_idle_w + (node.power_max_w - node.power_idle_w) * util

def node_power_with(node: NodeState, pod: Pod) -> float:
    cpu_util = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(node.cpu_allocated + pod.cpu_request) / float(node.cpu_capacity)
    mem_util = 0.0
    if node.mem_capacity > 0:
        mem_util = float(node.mem_allocated + pod.mem_request) / float(node.mem_capacity)
    util = max(cpu_util, mem_util)
    return node.power_idle_w + (node.power_max_w - node.power_idle_w) * util

def candidate_score(pod: Pod, node: NodeState, graph: CallGraphCtx, pods: list[Pod]) -> float:
    cpu = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    headroom = float((cpu + mem) // 2)
    latency = graph_latency(pod, node, graph, pods)
    penalty = latency * 0.1
    activation = 0.0
    if node.cpu_allocated == 0 and node.mem_allocated == 0:
        activation = 50.0
    power = node_power_with(node, pod)
    power_penalty = power * 0.05
    return headroom - penalty - activation - power_penalty

def fits(pod: Pod, node: NodeState) -> bool:
    if node.suspended:
        return False
    if node.cpu_allocated + pod.cpu_request > node.cpu_capacity:
        return False
    if node.mem_allocated + pod.mem_request > node.mem_capacity:
        return False
    return True

def best_consolidation_target(pod: Pod, state: ClusterState, graph: CallGraphCtx, current: NodeState) -> int:
    current_latency = graph_latency(pod, current, graph, state.pods)
    current_power = node_power(current)
    best_saving = 0.0
    best_node = -1
    for i in range(len(state.nodes)):
        if i != pod.current_node:
            node = state.nodes[i]
            has_load = node.cpu_allocated > 0 or node.mem_allocated > 0
            cpu_ok = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity) >= 5
            mem_ok = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity) >= 5
            if has_load and fits(pod, node) and cpu_ok and mem_ok:
                latency = graph_latency(pod, node, graph, state.pods)
                if latency <= current_latency + 20.0:
                    target_before = node_power(node)
                    target_after = node_power_with(node, pod)
                    increase = target_after - target_before
                    saving = current_power - increase
                    if saving > best_saving:
                        best_saving = saving
                        best_node = i
    return best_node

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    return candidate_score(pod, node, ctx.graph, ctx.pods)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    moves: int = 0
    for pod in state.pods:
        if moves < budget:
            eligible = not pod.stateful and not pod.has_pdb and pod.current_node >= 0
            if eligible:
                current = state.nodes[pod.current_node]
                alone = current.cpu_allocated <= pod.cpu_request and current.mem_allocated <= pod.mem_request
                if alone and current.suspendable:
                    target = best_consolidation_target(pod, state, graph, current)
                    if target >= 0:
                        out.append(move_pod(pod.id, target))
                        moves += 1
    return out
# EVOLVE-BLOCK-END
