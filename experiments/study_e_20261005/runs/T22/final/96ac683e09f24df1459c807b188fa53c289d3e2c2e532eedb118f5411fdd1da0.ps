# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 0.92:
        return -1000000.0

    total = 0.0
    weight = 0.0
    m = len(ctx.graph.src)
    for e in range(m):
        s = ctx.graph.src[e]
        d = ctx.graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                r = ctx.graph.rate[e]
                total += r * node.latency_to_ms[neighbor.current_node]
                weight += r

    proximity = 0.5
    if weight > 0.0:
        scaled = (total / weight) / 45.0
        proximity = 1.0 - min(scaled, 1.0)

    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)

    active = 0.0
    if node.cpu_allocated > 0 or node.mem_allocated > 0:
        active = 1.0

    return proximity * 0.45 + active * 0.35 + efficiency * 0.20

def peak_of(node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_used = float(node.cpu_allocated) / cpu_cap
    mem_used = float(node.mem_allocated) / mem_cap
    return max(cpu_used, mem_used)

def fits(node: NodeState, pod: Pod) -> bool:
    if node.suspended:
        return False
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak_after = max(cpu_after, mem_after)
    return peak_after < 0.85

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        if moved < budget:
            src_pod = state.pods[graph.src[e]]
            dst_pod = state.pods[graph.dst[e]]
            placed = src_pod.current_node >= 0 and dst_pod.current_node >= 0
            same = src_pod.current_node == dst_pod.current_node
            movable = placed and not same and not src_pod.stateful and not src_pod.has_pdb and not dst_pod.stateful and not dst_pod.has_pdb
            if movable:
                src_node = state.nodes[src_pod.current_node]
                dst_node = state.nodes[dst_pod.current_node]
                src_peak = peak_of(src_node)
                dst_peak = peak_of(dst_node)
                pull_src = src_peak < 0.50 and src_peak < dst_peak and fits(dst_node, src_pod)
                if pull_src:
                    out.append(move_pod(src_pod.id, dst_pod.current_node))
                    moved = moved + 1
                else:
                    pull_dst = dst_peak < 0.50 and dst_peak < src_peak and fits(src_node, dst_pod)
                    if pull_dst:
                        out.append(move_pod(dst_pod.id, src_pod.current_node))
                        moved = moved + 1
    return out
# EVOLVE-BLOCK-END
