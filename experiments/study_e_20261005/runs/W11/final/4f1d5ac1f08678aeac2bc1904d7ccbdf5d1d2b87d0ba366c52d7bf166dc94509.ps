# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def util_after(allocated: int, requested: int, capacity: int) -> float:
    if capacity == 0:
        return 1.0
    used = allocated + requested
    if used >= capacity:
        return 1.0
    return float(used) / float(capacity)

def compute_latency(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    pod_idx = -1
    for i in range(len(pods)):
        if pods[i].id == pod.id:
            pod_idx = i
    if pod_idx < 0:
        return 0.0
    total = 0.0
    count = 0
    n_edges = len(graph.src)
    for e in range(n_edges):
        src = graph.src[e]
        dst = graph.dst[e]
        other = -1
        if src == pod_idx:
            other = dst
        if dst == pod_idx:
            other = src
        if other >= 0:
            other_node = pods[other].current_node
            if other_node >= 0 and other_node < len(node.latency_to_ms):
                lat = node.latency_to_ms[other_node]
                total = total + lat
                count = count + 1
    if count == 0:
        return 0.0
    return total / float(count)

def node_power_after(pod: Pod, node: NodeState) -> float:
    cpu_u = util_after(node.cpu_allocated, pod.cpu_request, node.cpu_capacity)
    mem_u = util_after(node.mem_allocated, pod.mem_request, node.mem_capacity)
    u = cpu_u
    if mem_u > u:
        u = mem_u
    if u < 0.0:
        u = 0.0
    if u > 1.0:
        u = 1.0
    return node.power_idle_w + (node.power_max_w - node.power_idle_w) * u

def node_score(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    if node.suspended:
        return -1.0e18
    cpu = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    head = float((cpu + mem) // 2)
    cpu_u = util_after(node.cpu_allocated, pod.cpu_request, node.cpu_capacity)
    mem_u = util_after(node.mem_allocated, pod.mem_request, node.mem_capacity)
    u = cpu_u
    if mem_u > u:
        u = mem_u
    q = u * u * 60.0
    lat = compute_latency(pod, node, pods, graph)
    p = node_power_after(pod, node)
    return head * 0.05 - lat * 3.0 - q - p * 0.02

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return node_score(pod, node, ctx.pods, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    moves = 0
    n_pods = len(state.pods)
    n_nodes = len(state.nodes)
    for i in range(n_pods):
        if moves >= budget:
            return out
        pod = state.pods[i]
        cur = pod.current_node
        cur_score = -1.0e18
        if cur >= 0:
            cur_score = node_score(pod, state.nodes[cur], state.pods, graph)
        best_node = -1
        best_score = cur_score
        for j in range(n_nodes):
            node = state.nodes[j]
            eligible = (j != cur) and (not node.suspended)
            eligible = eligible and (node.cpu_allocated + pod.cpu_request <= node.cpu_capacity)
            eligible = eligible and (node.mem_allocated + pod.mem_request <= node.mem_capacity)
            if eligible:
                s = node_score(pod, node, state.pods, graph)
                if s > best_score:
                    best_score = s
                    best_node = j
        if best_node >= 0:
            threshold = 3.0
            if pod.stateful or pod.has_pdb:
                threshold = 10.0
            if pod.image_mb > 500:
                threshold = threshold + 3.0
            if best_score > cur_score + threshold:
                out.append(move_pod(pod.id, best_node))
                moves = moves + 1
    return out
# EVOLVE-BLOCK-END
