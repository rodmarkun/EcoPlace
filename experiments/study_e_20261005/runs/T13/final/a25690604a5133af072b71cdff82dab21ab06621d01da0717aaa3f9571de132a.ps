# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def marginal_power(pod: Pod, node: NodeState) -> float:
    cap = float(max(node.cpu_capacity, 1))
    span = max(node.power_max_w - node.power_idle_w, 0.0)
    return span * (float(pod.cpu_request) / cap)

def idle_efficiency(node: NodeState) -> float:
    return node.power_idle_w / float(max(node.cpu_capacity, 1))

def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def find_pod_index(pod: Pod, ctx: ClusterCtx) -> int:
    for i in range(len(ctx.pods)):
        if ctx.pods[i].id == pod.id:
            return i
    return -1

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cost = marginal_power(pod, node)
    if node.suspended:
        cost += node.power_idle_w + 5.0
    if node.cpu_allocated == 0 and not node.suspended:
        cost += node.power_idle_w * 0.5
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_head = resource_score(cpu_after, node.cpu_capacity)
    mem_head = resource_score(mem_after, node.mem_capacity)
    avg_head = (cpu_head + mem_head) // 2
    cost += float(100 - avg_head) * 0.15
    pod_idx = find_pod_index(pod, ctx)
    lat_sum = 0.0
    edges = 0
    if pod_idx >= 0:
        for i in range(len(ctx.graph.src)):
            if ctx.graph.src[i] == pod_idx or ctx.graph.dst[i] == pod_idx:
                other = ctx.graph.src[i]
                if other == pod_idx:
                    other = ctx.graph.dst[i]
                other_node = ctx.pods[other].current_node
                if other_node >= 0:
                    lat = 0.0
                    if other_node != node.id:
                        lat = node.latency_to_ms[other_node]
                    lat_sum += lat
                    edges += 1
    if edges > 0:
        cost += (lat_sum / float(edges)) * 0.05
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0 or len(state.nodes) < 2:
        return out
    drain = -1
    drain_u = 0.4
    for node in state.nodes:
        if node.suspendable and not node.suspended:
            u = float(node.cpu_allocated) / float(max(node.cpu_capacity, 1))
            if u < drain_u:
                drain_u = u
                drain = node.id
    if drain < 0:
        return out
    target = -1
    best = 1e18
    target_node = state.nodes[0]
    for node in state.nodes:
        if not node.suspended and node.id != drain:
            eff = idle_efficiency(node)
            if eff < best:
                best = eff
                target = node.id
                target_node = node
    if target < 0:
        return out
    t_cpu = target_node.cpu_allocated
    t_mem = target_node.mem_allocated
    moved = 0
    for pod in state.pods:
        eligible = pod.current_node == drain and not pod.stateful and not pod.has_pdb
        fits = t_cpu + pod.cpu_request <= target_node.cpu_capacity and t_mem + pod.mem_request <= target_node.mem_capacity
        if eligible and fits and moved < budget:
            cpu_after = t_cpu + pod.cpu_request
            mem_after = t_mem + pod.mem_request
            cpu_head = resource_score(cpu_after, target_node.cpu_capacity)
            mem_head = resource_score(mem_after, target_node.mem_capacity)
            if cpu_head >= 20 and mem_head >= 20:
                out.append(move_pod(pod.id, target))
                t_cpu += pod.cpu_request
                t_mem += pod.mem_request
                moved += 1
    return out
# EVOLVE-BLOCK-END
