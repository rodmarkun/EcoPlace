# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_pressure(requested: int, allocated: int, capacity: int) -> float:
    if capacity <= 0:
        return 100.0
    after = allocated + requested
    if after < 0:
        after = 0
    util = float(after) / float(capacity)
    if util < 0.0:
        return 0.0
    if util > 1.0:
        return 100.0 + (util - 1.0) * 100.0
    return util * util * 100.0

def marginal_power(pod: Pod, node: NodeState) -> float:
    cap = max(node.cpu_capacity, 1)
    span = max(node.power_max_w - node.power_idle_w, 0.0)
    return span * (float(pod.cpu_request) / float(cap))

def idle_efficiency(node: NodeState) -> float:
    cap = max(node.cpu_capacity, 1)
    return node.power_idle_w / float(cap)

def tier_latency_penalty(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    pid = -1
    for i in range(len(ctx.pods)):
        if ctx.pods[i].id == pod.id:
            pid = i
    if pid < 0:
        return 0.0
    penalty = 0.0
    for k in range(len(ctx.graph.src)):
        src = ctx.graph.src[k]
        dst = ctx.graph.dst[k]
        other = -1
        if src == pid:
            other = dst
        elif dst == pid:
            other = src
        if other >= 0 and other < len(ctx.pods):
            other_node = ctx.pods[other].current_node
            if other_node >= 0 and other_node != node.id:
                oidx = -1
                for j in range(len(ctx.nodes)):
                    if ctx.nodes[j].id == other_node:
                        oidx = j
                if oidx >= 0:
                    if ctx.nodes[oidx].tier != node.tier:
                        penalty += 1.0
    return penalty

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_p = resource_pressure(pod.cpu_request, node.cpu_allocated, node.cpu_capacity)
    mem_p = resource_pressure(pod.mem_request, node.mem_allocated, node.mem_capacity)
    pressure = cpu_p + mem_p
    cost = marginal_power(pod, node)
    if node.cpu_allocated == 0:
        cost += node.power_idle_w * 0.5
    if pod.current_node == node.id:
        cost -= 5.0
    cost += pressure * 0.5
    cost += idle_efficiency(node) * 0.1
    cost += tier_latency_penalty(pod, node, ctx) * 2.0
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0 or len(state.nodes) < 2:
        return out
    drain = -1
    best_util = 1000
    for node in state.nodes:
        if node.suspendable and not node.suspended and node.cpu_capacity > 0:
            util = (node.cpu_allocated * 100) // node.cpu_capacity
            if util < best_util and util < 30:
                best_util = util
                drain = node.id
    if drain < 0:
        return out
    target = -1
    best_eff = 1e18
    target_node = state.nodes[0]
    for node in state.nodes:
        if not node.suspended and node.id != drain:
            eff = idle_efficiency(node)
            if eff < best_eff:
                best_eff = eff
                target = node.id
                target_node = node
    if target < 0:
        return out
    target_cpu = target_node.cpu_allocated
    target_mem = target_node.mem_allocated
    moved = 0
    for pod in state.pods:
        if moved >= budget or moved >= 2:
            return out
        if pod.current_node == drain and not pod.stateful and not pod.has_pdb:
            cpu_ok = target_cpu + pod.cpu_request <= (target_node.cpu_capacity * 4) // 5
            mem_ok = target_mem + pod.mem_request <= (target_node.mem_capacity * 4) // 5
            if cpu_ok and mem_ok:
                out.append(move_pod(pod.id, target))
                target_cpu += pod.cpu_request
                target_mem += pod.mem_request
                moved += 1
    return out
# EVOLVE-BLOCK-END
