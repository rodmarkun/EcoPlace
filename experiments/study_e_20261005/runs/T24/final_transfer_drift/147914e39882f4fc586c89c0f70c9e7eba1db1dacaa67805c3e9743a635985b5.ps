# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def cpu_util(node: NodeState) -> float:
    if node.cpu_capacity <= 0:
        return 1.0
    return float(node.cpu_allocated) / float(node.cpu_capacity)

def mem_util(node: NodeState) -> float:
    if node.mem_capacity <= 0:
        return 1.0
    return float(node.mem_allocated) / float(node.mem_capacity)

def fits(pod: Pod, node: NodeState) -> bool:
    cpu_ok = node.cpu_allocated + pod.cpu_request <= node.cpu_capacity
    mem_ok = node.mem_allocated + pod.mem_request <= node.mem_capacity
    return cpu_ok and mem_ok

def estimated_power(node: NodeState, pod: Pod) -> float:
    if node.cpu_capacity <= 0:
        return node.power_max_w
    cpu_after = node.cpu_allocated + pod.cpu_request
    util = float(cpu_after) / float(node.cpu_capacity)
    return node.power_idle_w + (node.power_max_w - node.power_idle_w) * util

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return -1000000.0
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    if cpu_after > node.cpu_capacity or mem_after > node.mem_capacity:
        return -1000000.0
    power = estimated_power(node, pod)
    cu = float(cpu_after) / float(node.cpu_capacity)
    mu = float(mem_after) / float(node.mem_capacity)
    queue_penalty = cu * cu * 80.0 + mu * mu * 40.0
    cost = power + queue_penalty
    return -cost

def best_target(pod: Pod, cur_node: NodeState, state: ClusterState) -> int:
    best_id: int = -1
    best_power: float = 1000000.0
    for node in state.nodes:
        if node.id != cur_node.id and node.suspended == False:
            if node.power_idle_w < cur_node.power_idle_w:
                if fits(pod, node):
                    target_util = cpu_util(node)
                    if target_util < 0.8:
                        power = estimated_power(node, pod)
                        if power < best_power:
                            best_power = power
                            best_id = node.id
    return best_id

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    count: int = 0
    if budget <= 0:
        return out
    for pod in state.pods:
        if count >= budget:
            return out
        current = pod.current_node
        if current >= 0:
            if pod.stateful == False and pod.has_pdb == False:
                cur_node = state.nodes[0]
                for node in state.nodes:
                    if node.id == current:
                        cur_node = node
                cur_util = cpu_util(cur_node)
                if cur_util < 0.5:
                    target = best_target(pod, cur_node, state)
                    if target >= 0:
                        out.append(move_pod(pod.id, target))
                        count += 1
    return out
# EVOLVE-BLOCK-END
