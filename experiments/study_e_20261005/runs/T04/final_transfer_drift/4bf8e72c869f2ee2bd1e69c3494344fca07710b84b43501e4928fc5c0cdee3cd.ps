# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def node_util(node: NodeState) -> float:
    cpu = float(node.cpu_allocated) / float(max(node.cpu_capacity, 1))
    mem = float(node.mem_allocated) / float(max(node.mem_capacity, 1))
    return max(cpu, mem)

def node_headroom(node: NodeState) -> float:
    cpu = 1.0 - float(node.cpu_allocated) / float(max(node.cpu_capacity, 1))
    mem = 1.0 - float(node.mem_allocated) / float(max(node.mem_capacity, 1))
    return min(cpu, mem)

def idle_efficiency(node: NodeState) -> float:
    return node.power_idle_w / float(max(node.cpu_capacity, 1))

def marginal_power(pod: Pod, node: NodeState) -> float:
    cap = float(max(node.cpu_capacity, 1))
    span = max(node.power_max_w - node.power_idle_w, 0.0)
    return span * (float(pod.cpu_request) / cap)

def latency_cost(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    idx = -1
    for i in range(len(ctx.pods)):
        if ctx.pods[i].id == pod.id:
            idx = i
    if idx < 0:
        return 0.0
    total = 0.0
    for e in range(len(ctx.graph.src)):
        src = ctx.graph.src[e]
        dst = ctx.graph.dst[e]
        other = -1
        if src == idx:
            other = dst
        elif dst == idx:
            other = src
        if other >= 0:
            other_node = ctx.pods[other].current_node
            if other_node >= 0:
                total += node.latency_to_ms[other_node]
    return total

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cost = marginal_power(pod, node)
    if node.suspended:
        cost += node.power_idle_w + 5.0
    if node.cpu_allocated == 0 and not node.suspended:
        cost += node.power_idle_w * 0.5
    lat = latency_cost(pod, node, ctx)
    cost += lat * 0.01
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / float(max(node.cpu_capacity, 1))
    mem_after = float(node.mem_allocated + pod.mem_request) / float(max(node.mem_capacity, 1))
    pressure = max(cpu_after, mem_after)
    cost += pressure * 10.0
    return -cost

def pod_index(state: ClusterState, pod: Pod) -> int:
    for i in range(len(state.pods)):
        if state.pods[i].id == pod.id:
            return i
    return -1

def pod_degree(graph: CallGraphCtx, idx: int) -> int:
    deg = 0
    for e in range(len(graph.src)):
        if graph.src[e] == idx or graph.dst[e] == idx:
            deg += 1
    return deg

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0 or len(state.nodes) < 2:
        return out
    drain = -1
    drain_u = 2.0
    for node in state.nodes:
        if node.suspendable and not node.suspended:
            u = node_util(node)
            if u < drain_u and u < 0.35:
                drain_u = u
                drain = node.id
    if drain < 0:
        return out
    target = -1
    best = 1e18
    for node in state.nodes:
        if not node.suspended and node.id != drain:
            eff = idle_efficiency(node)
            if eff < best:
                best = eff
                target = node.id
    if target < 0:
        for node in state.nodes:
            if node.suspended and node.id != drain:
                eff = idle_efficiency(node)
                if eff < best:
                    best = eff
                    target = node.id
        if target < 0 or budget < 2:
            return out
        out.append(wake(target))
        moved = 1
    else:
        moved = 0
    target_node = state.nodes[0]
    for node in state.nodes:
        if node.id == target:
            target_node = node
    moved_cpu = 0
    moved_mem = 0
    for pod in state.pods:
        if moved < budget and pod.current_node == drain:
            if not pod.stateful and not pod.has_pdb:
                cpu_ok = target_node.cpu_allocated + moved_cpu + pod.cpu_request <= target_node.cpu_capacity
                mem_ok = target_node.mem_allocated + moved_mem + pod.mem_request <= target_node.mem_capacity
                if cpu_ok and mem_ok:
                    idx = pod_index(state, pod)
                    deg = 0
                    if idx >= 0:
                        deg = pod_degree(graph, idx)
                    if deg <= 4:
                        out.append(move_pod(pod.id, target))
                        moved += 1
                        moved_cpu += pod.cpu_request
                        moved_mem += pod.mem_request
    return out
# EVOLVE-BLOCK-END
