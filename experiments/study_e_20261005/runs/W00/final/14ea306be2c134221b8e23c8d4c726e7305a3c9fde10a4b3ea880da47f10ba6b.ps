# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def graph_penalty(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    penalty: float = 0.0
    n: int = len(graph.src)
    for i in range(n):
        src_i: int = graph.src[i]
        dst_i: int = graph.dst[i]
        src_pod: Pod = pods[src_i]
        dst_pod: Pod = pods[dst_i]
        if src_pod.id == pod.id:
            other_node: int = dst_pod.current_node
            if other_node >= 0:
                lat: float = node.latency_to_ms[other_node]
                penalty = penalty + lat
        elif dst_pod.id == pod.id:
            other_node: int = src_pod.current_node
            if other_node >= 0:
                lat: float = node.latency_to_ms[other_node]
                penalty = penalty + lat
    return penalty

def base_score(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx, cpu_after: int, mem_after: int) -> float:
    if node.suspended:
        return -1000000.0
    if node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return -1000000.0
    if cpu_after > node.cpu_capacity or mem_after > node.mem_capacity:
        return -1000000.0
    cpu_util: float = float(cpu_after) / float(node.cpu_capacity)
    mem_util: float = float(mem_after) / float(node.mem_capacity)
    max_util: float = cpu_util
    if mem_util > max_util:
        max_util = mem_util
    headroom: float = 1.0 - max_util
    if headroom < 0.0:
        headroom = 0.0
    headroom2: float = headroom * headroom
    power: float = node.power_idle_w + (node.power_max_w - node.power_idle_w) * max_util
    comm: float = graph_penalty(pod, node, pods, graph)
    over: float = 0.0
    if max_util > 0.70:
        over = (max_util - 0.70) * (max_util - 0.70) * 50000.0
    if cpu_util > 0.80:
        over = over + (cpu_util - 0.80) * (cpu_util - 0.80) * 80000.0
    if mem_util > 0.80:
        over = over + (mem_util - 0.80) * (mem_util - 0.80) * 80000.0
    return 40000.0 * headroom2 - 2.0 * power - 15.0 * comm - over

def score_node(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    return base_score(pod, node, pods, graph, node.cpu_allocated + pod.cpu_request, node.mem_allocated + pod.mem_request)

def score_current(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    return base_score(pod, node, pods, graph, node.cpu_allocated, node.mem_allocated)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return score_node(pod, node, ctx.pods, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    limit: int = budget
    if limit > 2:
        limit = 2
    moves_made: int = 0
    for pod in state.pods:
        if moves_made >= limit:
            return out
        cur: int = pod.current_node
        if cur >= 0:
            cur_node: NodeState = state.nodes[cur]
            cur_score: float = score_current(pod, cur_node, state.pods, graph)
            best_j: int = -1
            best_score: float = cur_score
            j: int = 0
            for node in state.nodes:
                if j != cur:
                    s: float = score_node(pod, node, state.pods, graph)
                    if s > best_score:
                        best_score = s
                        best_j = j
                j = j + 1
            move_cost: float = 2000.0
            if pod.stateful:
                move_cost = move_cost + 5000.0
            if pod.has_pdb:
                move_cost = move_cost + 1000.0
            move_cost = move_cost + 0.2 * float(pod.image_mb)
            if best_j >= 0 and best_score > cur_score + move_cost:
                out.append(move_pod(pod.id, best_j))
                moves_made = moves_made + 1
    return out
# EVOLVE-BLOCK-END
