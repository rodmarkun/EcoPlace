# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 45.0
    return 1.0 - min(scaled, 1.0)

def node_util(node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu = float(node.cpu_allocated) / cpu_cap
    mem = float(node.mem_allocated) / mem_cap
    return max(cpu, mem)

def node_util_after(node: NodeState, pod: Pod) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after)

def count_pods_on_node(state: ClusterState, node_id: int) -> int:
    count = 0
    for p in state.pods:
        if p.current_node == node_id:
            count = count + 1
    return count

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 0.82:
        return -1000000.0
    packing = peak / 0.82
    weighted = 0.0
    weight = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                weighted = weighted + rate * node.latency_to_ms[neighbor.current_node]
                weight = weight + rate
    proximity = 0.5
    if weight > 0.0:
        proximity = proximity_of(weighted / weight)
    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    activation_penalty = 0.0
    if node.cpu_allocated == 0 and node.suspendable:
        activation_penalty = -0.08
    return packing * 0.65 + proximity * 0.20 + efficiency * 0.10 + activation_penalty

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            pass
        else:
            sp = state.pods[graph.src[e]]
            dp = state.pods[graph.dst[e]]
            sp_movable = not sp.stateful and not sp.has_pdb and sp.current_node >= 0
            condition = sp_movable and dp.current_node >= 0 and sp.current_node != dp.current_node and not state.nodes[dp.current_node].suspended
            if condition:
                target = state.nodes[dp.current_node]
                util_after = node_util_after(target, sp)
                if util_after <= 0.82:
                    source_node = state.nodes[sp.current_node]
                    target_util = node_util(target)
                    source_util = node_util(source_node)
                    beneficial = target_util >= source_util
                    if count_pods_on_node(state, sp.current_node) == 1:
                        beneficial = True
                    if beneficial:
                        out.append(move_pod(sp.id, dp.current_node))
                        moved = moved + 1
            if moved < budget:
                dp_movable = not dp.stateful and not dp.has_pdb and dp.current_node >= 0
                condition2 = dp_movable and sp.current_node >= 0 and dp.current_node != sp.current_node and not state.nodes[sp.current_node].suspended
                if condition2:
                    target2 = state.nodes[sp.current_node]
                    util_after2 = node_util_after(target2, dp)
                    if util_after2 <= 0.82:
                        source_node2 = state.nodes[dp.current_node]
                        target_util2 = node_util(target2)
                        source_util2 = node_util(source_node2)
                        beneficial2 = target_util2 >= source_util2
                        if count_pods_on_node(state, dp.current_node) == 1:
                            beneficial2 = True
                        if beneficial2:
                            out.append(move_pod(dp.id, sp.current_node))
                            moved = moved + 1
    return out
# EVOLVE-BLOCK-END
