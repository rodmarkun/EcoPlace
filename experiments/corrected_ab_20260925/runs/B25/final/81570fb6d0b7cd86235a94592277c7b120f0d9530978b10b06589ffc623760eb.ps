# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    m = len(ctx.graph.src)
    for e in range(m):
        s = ctx.graph.src[e]
        d = ctx.graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                total += ctx.graph.rate[e] * node.latency_to_ms[neighbor.current_node]
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_cap = node.cpu_capacity
    mem_cap = node.mem_capacity
    cpu_ratio = 0.0
    if cpu_cap > 0:
        cpu_ratio = float(cpu_after) / float(cpu_cap)
    mem_ratio = 0.0
    if mem_cap > 0:
        mem_ratio = float(mem_after) / float(mem_cap)
    load_penalty = (cpu_ratio * cpu_ratio + mem_ratio * mem_ratio) * 300.0
    power_est = node.power_idle_w + (node.power_max_w - node.power_idle_w) * cpu_ratio
    power_penalty = power_est * 0.5
    susp_penalty = 0.0
    if node.suspended:
        susp_penalty = 10000.0
    stateful_penalty = 0.0
    if pod.stateful and node.id != pod.current_node:
        stateful_penalty = 5000.0
    consolidation = 0.0
    if node.cpu_allocated > 0:
        consolidation = -25.0
    elif node.suspendable and node.cpu_allocated == 0:
        consolidation = 80.0
    return -total - load_penalty - power_penalty - susp_penalty - stateful_penalty - consolidation

def node_cost(state: ClusterState, graph: CallGraphCtx, pod: Pod, node_idx: int) -> float:
    node = state.nodes[node_idx]
    total = 0.0
    m = len(graph.src)
    for e in range(m):
        s = graph.src[e]
        d = graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                total += graph.rate[e] * node.latency_to_ms[neighbor.current_node]
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_cap = node.cpu_capacity
    mem_cap = node.mem_capacity
    cpu_ratio = 0.0
    if cpu_cap > 0:
        cpu_ratio = float(cpu_after) / float(cpu_cap)
    mem_ratio = 0.0
    if mem_cap > 0:
        mem_ratio = float(mem_after) / float(mem_cap)
    load_penalty = (cpu_ratio * cpu_ratio + mem_ratio * mem_ratio) * 300.0
    power_est = node.power_idle_w + (node.power_max_w - node.power_idle_w) * cpu_ratio
    power_penalty = power_est * 0.5
    susp_penalty = 0.0
    if node.suspended:
        susp_penalty = 10000.0
    stateful_penalty = 0.0
    if pod.stateful and node_idx != pod.current_node:
        stateful_penalty = 5000.0
    consolidation = 0.0
    if node.cpu_allocated > 0:
        consolidation = -25.0
    elif node.suspendable and node.cpu_allocated == 0:
        consolidation = 80.0
    return total + load_penalty + power_penalty + susp_penalty + stateful_penalty + consolidation

def best_node_for_pod(state: ClusterState, graph: CallGraphCtx, pod: Pod) -> int:
    best = -1
    best_cost = 0.0
    n = len(state.nodes)
    for i in range(n):
        node = state.nodes[i]
        cpu_after = node.cpu_allocated + pod.cpu_request
        mem_after = node.mem_allocated + pod.mem_request
        fits = cpu_after <= node.cpu_capacity and mem_after <= node.mem_capacity and not node.suspended
        if fits:
            cost = node_cost(state, graph, pod, i)
            if best < 0 or cost < best_cost:
                best = i
                best_cost = cost
    return best

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    n = len(state.pods)
    for i in range(n):
        if moved >= budget:
            return out
        pod = state.pods[i]
        eligible = pod.current_node >= 0 and not pod.stateful and not pod.has_pdb
        if eligible:
            best = best_node_for_pod(state, graph, pod)
            if best >= 0 and best != pod.current_node:
                cur_cost = node_cost(state, graph, pod, pod.current_node)
                new_cost = node_cost(state, graph, pod, best)
                src = state.nodes[pod.current_node]
                empties = src.suspendable and src.cpu_allocated <= pod.cpu_request and src.mem_allocated <= pod.mem_request
                bonus = 0.0
                if empties:
                    bonus = src.power_idle_w * 0.5
                improvement = cur_cost - new_cost + bonus
                if improvement > 30.0:
                    out.append(move_pod(pod.id, best))
                    moved += 1
    return out
# EVOLVE-BLOCK-END
