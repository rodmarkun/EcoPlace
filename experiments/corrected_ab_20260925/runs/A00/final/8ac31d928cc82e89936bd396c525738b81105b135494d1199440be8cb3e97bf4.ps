# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def node_peak_after(node: NodeState, pod: Pod) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after)

def node_peak_now(node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_now = float(node.cpu_allocated) / cpu_cap
    mem_now = float(node.mem_allocated) / mem_cap
    return max(cpu_now, mem_now)

def node_peak_after_removal(node: NodeState, pod: Pod) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated - pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated - pod.mem_request) / mem_cap
    if cpu_after < 0.0:
        cpu_after = 0.0
    if mem_after < 0.0:
        mem_after = 0.0
    return max(cpu_after, mem_after)

def node_marginal_energy(node: NodeState, pod: Pod) -> float:
    if node.suspended:
        return 1000000.0
    peak = node_peak_after(node, pod)
    if peak > 0.85:
        return 1000000.0
    existing = node_peak_now(node)
    span = node.power_max_w - node.power_idle_w
    delta = peak - existing
    if existing > 0.0:
        return span * delta
    return node.power_idle_w + span * peak

def node_removal_savings(node: NodeState, pod: Pod) -> float:
    existing = node_peak_now(node)
    after = node_peak_after_removal(node, pod)
    span = node.power_max_w - node.power_idle_w
    savings = span * (existing - after)
    if after <= 0.0 and node.suspendable:
        savings = savings + node.power_idle_w
    return savings

def contains_int(ids: list[int], value: int) -> bool:
    for i in range(len(ids)):
        if ids[i] == value:
            return True
    return False

def latency_to_neighbors(pod: Pod, node: NodeState, graph: CallGraphCtx, state: ClusterState) -> float:
    weighted = 0.0
    weight = 0.0
    edges = len(graph.src)
    for e in range(edges):
        source = graph.src[e]
        destination = graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                rate = graph.rate[e]
                weighted = weighted + rate * node.latency_to_ms[neighbor.current_node]
                weight = weight + rate
    if weight <= 0.0:
        return 0.0
    return weighted / weight

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    peak = node_peak_after(node, pod)
    if peak > 0.85:
        return -1000000.0
    weighted = 0.0
    weight = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                weighted = weighted + rate * node.latency_to_ms[neighbor.current_node]
                weight = weight + rate
    proximity = 0.5
    if weight > 0.0:
        mean_lat = weighted / weight
        proximity = 1.0 - min(mean_lat / 60.0, 1.0)
    marginal = node_marginal_energy(node, pod)
    if marginal >= 1000000.0:
        return -1000000.0
    existing = node_peak_now(node)
    packing = 0.0
    if existing > 0.0:
        packing = 0.2
    energy_penalty = marginal * 0.01
    return proximity * 0.5 + packing - energy_penalty

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    moved_ids: list[int] = []
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            return out
        sp = state.pods[graph.src[e]]
        dp = state.pods[graph.dst[e]]
        placed = sp.current_node >= 0 and dp.current_node >= 0
        different = sp.current_node != dp.current_node
        if placed and different:
            sp_movable = not sp.stateful and not sp.has_pdb
            dp_movable = not dp.stateful and not dp.has_pdb
            if sp_movable and not contains_int(moved_ids, sp.id):
                target = state.nodes[dp.current_node]
                source = state.nodes[sp.current_node]
                delta = node_marginal_energy(target, sp) - node_removal_savings(source, sp)
                lat = latency_to_neighbors(sp, target, graph, state)
                if delta < 0.0 and lat < 80.0:
                    out.append(move_pod(sp.id, dp.current_node))
                    moved = moved + 1
                    moved_ids.append(sp.id)
            if moved < budget and dp_movable and not contains_int(moved_ids, dp.id):
                target = state.nodes[sp.current_node]
                source = state.nodes[dp.current_node]
                delta = node_marginal_energy(target, dp) - node_removal_savings(source, dp)
                lat = latency_to_neighbors(dp, target, graph, state)
                if delta < 0.0 and lat < 80.0:
                    out.append(move_pod(dp.id, sp.current_node))
                    moved = moved + 1
                    moved_ids.append(dp.id)
    return out
# EVOLVE-BLOCK-END
