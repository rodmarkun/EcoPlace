# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def list_contains_int(items: list[int], value: int) -> bool:
    for i in range(len(items)):
        if items[i] == value:
            return True
    return False

def pod_criticality(pod: Pod, graph: CallGraphCtx) -> float:
    crit = 0.0
    for e in range(len(graph.src)):
        if graph.src[e] == pod.id or graph.dst[e] == pod.id:
            crit += graph.rate[e]
    return crit

def placement_cost(pod: Pod, node: NodeState, nodes: list[NodeState], pods: list[Pod], graph: CallGraphCtx) -> float:
    cpu_ratio = float(pod.cpu_request) / float(node.cpu_capacity)
    mem_ratio = float(pod.mem_request) / float(node.mem_capacity)
    inc = (node.power_max_w - node.power_idle_w) * cpu_ratio
    cost = inc
    if node.cpu_allocated == 0:
        cost += node.power_idle_w
    if node.suspended:
        cost += node.power_idle_w * 2.0
    util = float(node.cpu_allocated) / float(node.cpu_capacity)
    util_after = util + cpu_ratio
    mem_util = float(node.mem_allocated) / float(node.mem_capacity)
    mem_after = mem_util + mem_ratio
    if util_after > 0.60:
        cost += (util_after - 0.60) * 200.0
    if mem_after > 0.75:
        cost += (mem_after - 0.75) * 150.0
    cost += util_after * util_after * 30.0
    cost -= util * 1.0
    lat = 0.0
    for e in range(len(graph.src)):
        s = graph.src[e]
        d = graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                lat += graph.rate[e] * node.latency_to_ms[neighbor.current_node]
    cost += lat * 0.25
    return cost

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return -placement_cost(pod, node, ctx.nodes, ctx.pods, ctx.graph)

def find_best_target(pod: Pod, current_node: int, state: ClusterState, graph: CallGraphCtx, used: list[int]) -> int:
    current = state.nodes[current_node]
    current_cost = placement_cost(pod, current, state.nodes, state.pods, graph)
    best_id = -1
    best_cost = current_cost
    crit = pod_criticality(pod, graph)
    margin = 2.0 + crit * 0.5
    for j in range(len(state.nodes)):
        if j != current_node and not list_contains_int(used, j):
            target = state.nodes[j]
            if not target.suspended:
                fits_cpu = target.cpu_allocated + pod.cpu_request <= target.cpu_capacity
                fits_mem = target.mem_allocated + pod.mem_request <= target.mem_capacity
                if fits_cpu and fits_mem:
                    target_cost = placement_cost(pod, target, state.nodes, state.pods, graph)
                    if target_cost < current_cost - margin:
                        if target_cost < best_cost:
                            best_cost = target_cost
                            best_id = j
    return best_id

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    used_targets: list[int] = []
    for i in range(len(state.pods)):
        if moved < budget:
            pod = state.pods[i]
            if pod.current_node >= 0 and not pod.stateful and not pod.has_pdb:
                best_id = find_best_target(pod, pod.current_node, state, graph, used_targets)
                if best_id >= 0:
                    out.append(move_pod(pod.id, best_id))
                    used_targets.append(best_id)
                    moved += 1
    return out
# EVOLVE-BLOCK-END
