# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def pod_latency(pod_id: int, node_id: int, state: ClusterState, graph: CallGraphCtx) -> float:
    total = 0.0
    m = len(graph.src)
    for e in range(m):
        s = graph.src[e]
        d = graph.dst[e]
        other = -1
        if s == pod_id:
            other = d
        if d == pod_id:
            other = s
        if other >= 0 and other != pod_id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                total += graph.rate[e] * state.nodes[node_id].latency_to_ms[neighbor.current_node]
    return total

def cost_of(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    if node.suspended:
        return 1000000000.0
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    if cpu_after > node.cpu_capacity:
        return 1000000000.0
    if mem_after > node.mem_capacity:
        return 1000000000.0
    total = 0.0
    m = len(graph.src)
    for e in range(m):
        s = graph.src[e]
        d = graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                total += graph.rate[e] * node.latency_to_ms[neighbor.current_node]
    eff = (node.power_max_w - node.power_idle_w) / float(node.cpu_capacity)
    util_after = float(cpu_after) / float(node.cpu_capacity)
    mem_util_after = float(mem_after) / float(node.mem_capacity)
    energy = eff * float(pod.cpu_request)
    overload = 0.0
    if util_after > 0.85:
        overload = (util_after - 0.85) * 10000.0
    if mem_util_after > 0.90:
        overload += (mem_util_after - 0.90) * 10000.0
    active_bonus = 0.0
    if node.cpu_allocated > 0:
        active_bonus = 1.0
    queue_penalty = 0.0
    if util_after > 0.70:
        queue_penalty = (util_after - 0.70) * 500.0
    return total + 50.0 * energy + 200.0 * overload + queue_penalty - active_bonus

def current_cost(pod: Pod, node_id: int, state: ClusterState, graph: CallGraphCtx) -> float:
    node = state.nodes[node_id]
    if node.suspended:
        return 1000000000.0
    total = pod_latency(pod.id, node_id, state, graph)
    eff = (node.power_max_w - node.power_idle_w) / float(node.cpu_capacity)
    util = float(node.cpu_allocated) / float(node.cpu_capacity)
    mem_util = float(node.mem_allocated) / float(node.mem_capacity)
    energy = eff * float(pod.cpu_request)
    overload = 0.0
    if util > 0.85:
        overload = (util - 0.85) * 10000.0
    if mem_util > 0.90:
        overload += (mem_util - 0.90) * 10000.0
    active_bonus = 0.0
    if node.cpu_allocated > 0:
        active_bonus = 1.0
    queue_penalty = 0.0
    if util > 0.70:
        queue_penalty = (util - 0.70) * 500.0
    return total + 50.0 * energy + 200.0 * overload + queue_penalty - active_bonus

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return -cost_of(pod, node, ctx.pods, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    n_pods = len(state.pods)
    for i in range(n_pods):
        if moved >= budget:
            return out
        pod = state.pods[i]
        if pod.current_node >= 0 and not pod.stateful and not pod.has_pdb:
            src_cost = current_cost(pod, pod.current_node, state, graph)
            best_target = -1
            best_cost = src_cost
            n_nodes = len(state.nodes)
            for j in range(n_nodes):
                node = state.nodes[j]
                if j != pod.current_node and not node.suspended:
                    cpu_after = node.cpu_allocated + pod.cpu_request
                    mem_after = node.mem_allocated + pod.mem_request
                    if cpu_after <= node.cpu_capacity and mem_after <= node.mem_capacity:
                        headroom_ok = float(cpu_after) <= 0.90 * float(node.cpu_capacity)
                        mem_ok = float(mem_after) <= 0.90 * float(node.mem_capacity)
                        if headroom_ok and mem_ok:
                            cost = cost_of(pod, node, state.pods, graph)
                            if cost < best_cost:
                                best_cost = cost
                                best_target = j
            if best_target >= 0 and best_cost < src_cost - 2.0:
                out.append(move_pod(pod.id, best_target))
                moved += 1
    return out
# EVOLVE-BLOCK-END
