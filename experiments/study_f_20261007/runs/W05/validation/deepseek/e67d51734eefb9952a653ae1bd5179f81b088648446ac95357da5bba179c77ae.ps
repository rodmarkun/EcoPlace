# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def headroom(pod: Pod, node: NodeState) -> int:
    cpu = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    return (cpu + mem) // 2

def find_pod_index(pod: Pod, pods: list[Pod]) -> int:
    for i in range(len(pods)):
        if pods[i].id == pod.id:
            return i
    return -1

def latency_cost(node: NodeState, pods: list[Pod], graph: CallGraphCtx, pod_index: int) -> float:
    if pod_index < 0:
        return 0.0
    total: float = 0.0
    count: int = 0
    for e in range(len(graph.src)):
        src = graph.src[e]
        dst = graph.dst[e]
        other = -1
        if src == pod_index:
            other = dst
        elif dst == pod_index:
            other = src
        if other >= 0 and other < len(pods):
            other_node = pods[other].current_node
            if other_node >= 0 and other_node < len(node.latency_to_ms):
                lat = node.latency_to_ms[other_node]
                total += lat
                count += 1
    if count == 0:
        return 0.0
    return total / float(count)

def node_rank(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx, pod_index: int) -> float:
    if node.suspended:
        return -1000000.0
    hr = headroom(pod, node)
    lat = latency_cost(node, pods, graph, pod_index)
    cpu_after = node.cpu_allocated + pod.cpu_request
    cpu_util: float = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(cpu_after) / float(node.cpu_capacity)
    mem_after = node.mem_allocated + pod.mem_request
    mem_util: float = 0.0
    if node.mem_capacity > 0:
        mem_util = float(mem_after) / float(node.mem_capacity)
    util = (cpu_util + mem_util) / 2.0
    power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * util
    queue_pen = util * util * 30.0
    return float(hr) - power * 0.02 - lat * 2.0 - queue_pen

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    pod_index = find_pod_index(pod, ctx.pods)
    return node_rank(pod, node, ctx.pods, ctx.graph, pod_index)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    for i in range(len(state.pods)):
        pod = state.pods[i]
        eligible = pod.current_node >= 0 and pod.current_node < len(state.nodes) and not (pod.stateful and pod.has_pdb)
        if eligible:
            current_node = state.nodes[pod.current_node]
            current_rank = node_rank(pod, current_node, state.pods, graph, i)
            best_node = -1
            best_rank = current_rank + 15.0
            for j in range(len(state.nodes)):
                if j != pod.current_node:
                    node = state.nodes[j]
                    feasible = node.cpu_allocated + pod.cpu_request <= node.cpu_capacity and node.mem_allocated + pod.mem_request <= node.mem_capacity and not node.suspended
                    if feasible:
                        rank = node_rank(pod, node, state.pods, graph, i)
                        if rank > best_rank:
                            best_rank = rank
                            best_node = j
            if best_node >= 0:
                move = move_pod(pod.id, best_node)
                out.append(move)
                if len(out) >= budget:
                    return out
    return out
# EVOLVE-BLOCK-END
