# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def projected_energy(node: NodeState, cpu: int, mem: int) -> float:
    if node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return node.power_max_w
    cpu_frac = float(cpu) / float(node.cpu_capacity)
    mem_frac = float(mem) / float(node.mem_capacity)
    if cpu_frac > 1.0:
        cpu_frac = 1.0
    if mem_frac > 1.0:
        mem_frac = 1.0
    util = (cpu_frac + mem_frac) * 0.5
    energy = node.power_idle_w + (node.power_max_w - node.power_idle_w) * util
    return energy

def fits_after(node: NodeState, pod: Pod) -> bool:
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    return cpu_after <= node.cpu_capacity and mem_after <= node.mem_capacity

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    if node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return -1000000.0
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    if cpu_after > node.cpu_capacity or mem_after > node.mem_capacity:
        return -1000000.0
    energy = projected_energy(node, cpu_after, mem_after)
    cpu_frac = float(cpu_after) / float(node.cpu_capacity)
    mem_frac = float(mem_after) / float(node.mem_capacity)
    util = (cpu_frac + mem_frac) * 0.5
    return -energy - util * 20.0

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved: int = 0
    n: int = len(state.nodes)
    p: int = len(state.pods)
    for i in range(p):
        if moved >= budget:
            return out
        pod = state.pods[i]
        cn = pod.current_node
        eligible = cn >= 0 and not pod.stateful and not pod.has_pdb
        if eligible:
            cur = state.nodes[cn]
            cur_energy = projected_energy(cur, cur.cpu_allocated, cur.mem_allocated)
            cur_cpu_after = cur.cpu_allocated - pod.cpu_request
            cur_mem_after = cur.mem_allocated - pod.mem_request
            if cur_cpu_after < 0:
                cur_cpu_after = 0
            if cur_mem_after < 0:
                cur_mem_after = 0
            cur_after_energy = projected_energy(cur, cur_cpu_after, cur_mem_after)
            best = -1
            best_energy = 1000000.0
            for j in range(n):
                node = state.nodes[j]
                if j != cn and not node.suspended:
                    if fits_after(node, pod):
                        target_energy = projected_energy(node, node.cpu_allocated + pod.cpu_request, node.mem_allocated + pod.mem_request)
                        if target_energy < best_energy:
                            best_energy = target_energy
                            best = j
            if best >= 0:
                target = state.nodes[best]
                target_before = projected_energy(target, target.cpu_allocated, target.mem_allocated)
                new_total = cur_after_energy + best_energy
                old_total = cur_energy + target_before
                if new_total < old_total - 0.5:
                    out.append(move_pod(pod.id, best))
                    moved += 1
    return out
# EVOLVE-BLOCK-END
