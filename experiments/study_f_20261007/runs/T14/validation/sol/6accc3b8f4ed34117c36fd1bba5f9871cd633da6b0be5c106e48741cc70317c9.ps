# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def queue_cost(utilization: float) -> float:
    excess = max(utilization - 0.65, 0.0)
    return utilization * 0.50 + excess * excess * 4.0

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0

    cpu_before = node.cpu_allocated
    mem_before = node.mem_allocated
    if pod.current_node == node.id:
        cpu_before = max(cpu_before - pod.cpu_request, 0)
        mem_before = max(mem_before - pod.mem_request, 0)

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(cpu_before + pod.cpu_request) / cpu_cap
    mem_after = float(mem_before + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    weighted_latency = 0.0
    total_rate = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        incoming = False
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source
            incoming = True
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                latency = 0.0
                if neighbor.current_node != node.id:
                    latency = node.latency_to_ms[neighbor.current_node]
                    if incoming:
                        latency = ctx.nodes[neighbor.current_node].latency_to_ms[node.id]
                rate = max(ctx.graph.rate[e], 0.0)
                weighted_latency = weighted_latency + rate * latency
                total_rate = total_rate + rate

    latency_cost = 0.175
    if total_rate > 0.0:
        mean_latency = weighted_latency / total_rate
        latency_cost = 0.35 * mean_latency / 45.0

    # Charge the incremental CPU power and the idle draw of activating an empty
    # suspendable node. Occupied nodes can absorb work without another idle draw.
    power_range = max(node.power_max_w - node.power_idle_w, 0.0)
    incremental_power = power_range * float(pod.cpu_request) / cpu_cap
    if cpu_before == 0 and mem_before == 0 and node.suspendable:
        incremental_power = incremental_power + node.power_idle_w

    # A small standing-power term still favors efficient nodes when activation
    # costs are already sunk. Queue risk grows rapidly beyond the safe margin.
    energy_cost = incremental_power / 120.0
    standing_cost = node.power_idle_w / 120.0
    cost = queue_cost(peak) + latency_cost
    cost = cost + 0.20 * energy_cost + 0.05 * standing_cost
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # The exposed state provides no remaining cumulative disruption allowance
    # or horizon-aware migration benefit. Avoid spending it speculatively;
    # placement improvements take effect as offered pods are scheduled.
    return out
# EVOLVE-BLOCK-END
