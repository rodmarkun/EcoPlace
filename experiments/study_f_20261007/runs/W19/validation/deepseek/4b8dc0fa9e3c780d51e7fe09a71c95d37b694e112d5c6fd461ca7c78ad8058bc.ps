# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def post_peak(pod: Pod, node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after)

def node_peak(node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_util = float(node.cpu_allocated) / cpu_cap
    mem_util = float(node.mem_allocated) / mem_cap
    return max(cpu_util, mem_util)

def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 25.0
    if scaled > 1.0:
        return 0.0
    return 1.0 - scaled

def already_moved(moved_ids: list[int], pid: int) -> bool:
    found = False
    n = len(moved_ids)
    for i in range(n):
        if moved_ids[i] == pid:
            found = True
    return found

def try_move(pod: Pod, target: NodeState, target_idx: int, moved_ids: list[int], out: list[Move], max_peak: float) -> int:
    if pod.stateful:
        return 0
    if pod.has_pdb:
        return 0
    if already_moved(moved_ids, pod.id):
        return 0
    if target.suspended:
        return 0
    peak = post_peak(pod, target)
    if peak > max_peak:
        return 0
    out.append(move_pod(pod.id, target_idx))
    moved_ids.append(pod.id)
    return 1

def best_balance_target(pod: Pod, state: ClusterState, current_peak: float) -> int:
    best_idx = -1
    best_peak = 1.0
    nodes = len(state.nodes)
    for n in range(nodes):
        if n != pod.current_node:
            target = state.nodes[n]
            if not target.suspended:
                target_peak = post_peak(pod, target)
                if target_peak < best_peak and target_peak < 0.60:
                    if target_peak < current_peak - 0.10:
                        best_peak = target_peak
                        best_idx = n
    return best_idx

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    peak = post_peak(pod, node)
    if peak > 0.92:
        return -1000000.0

    headroom = 1.0 - peak
    if peak > 0.65:
        headroom = headroom * 0.55
    if peak > 0.78:
        headroom = headroom * 0.45
    if peak > 0.88:
        headroom = headroom * 0.35

    weighted = 0.0
    weight = 0.0
    max_latency = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                lat = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * lat
                weight = weight + rate
                if lat > max_latency:
                    max_latency = lat

    proximity = 0.4
    if weight > 0.0:
        mean_latency = weighted / weight
        proximity_mean = proximity_of(mean_latency)
        proximity_max = proximity_of(max_latency)
        proximity = proximity_mean * 0.35 + proximity_max * 0.65

    marginal = node.power_max_w - node.power_idle_w
    efficiency = 1.0 - min(marginal / 120.0, 1.0)
    existing_peak = node_peak(node)

    return headroom * 0.48 + proximity * 0.42 + efficiency * 0.05 + (1.0 - existing_peak) * 0.05

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    moved_ids: list[int] = []
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            return out
        rate = graph.rate[e]
        source_pod = state.pods[graph.src[e]]
        dest_pod = state.pods[graph.dst[e]]
        different = source_pod.current_node >= 0 and dest_pod.current_node >= 0 and source_pod.current_node != dest_pod.current_node
        if rate >= 1.0 and different:
            src_idx = source_pod.current_node
            dst_idx = dest_pod.current_node
            src_node = state.nodes[src_idx]
            dst_node = state.nodes[dst_idx]
            link_lat = src_node.latency_to_ms[dst_idx]
            src_peak = node_peak(src_node)
            dst_peak = node_peak(dst_node)
            source_movable = not source_pod.stateful and not source_pod.has_pdb and not already_moved(moved_ids, source_pod.id)
            dest_movable = not dest_pod.stateful and not dest_pod.has_pdb and not already_moved(moved_ids, dest_pod.id)
            useful = link_lat > 1.2 or src_peak > dst_peak + 0.15 or dst_peak > src_peak + 0.15
            if useful:
                if source_movable and dest_movable:
                    move_source = False
                    if src_peak > dst_peak + 0.05:
                        move_source = True
                    elif dst_peak > src_peak + 0.05:
                        move_source = False
                    else:
                        source_target_peak = post_peak(source_pod, dst_node)
                        dest_target_peak = post_peak(dest_pod, src_node)
                        if source_target_peak <= dest_target_peak:
                            move_source = True
                    if move_source:
                        moved = moved + try_move(source_pod, dst_node, dst_idx, moved_ids, out, 0.60)
                    else:
                        moved = moved + try_move(dest_pod, src_node, src_idx, moved_ids, out, 0.60)
                elif source_movable:
                    moved = moved + try_move(source_pod, dst_node, dst_idx, moved_ids, out, 0.60)
                elif dest_movable:
                    moved = moved + try_move(dest_pod, src_node, src_idx, moved_ids, out, 0.60)

    if moved < budget:
        pods = len(state.pods)
        for p in range(pods):
            if moved >= budget:
                return out
            pod = state.pods[p]
            if pod.current_node >= 0:
                movable = not pod.stateful and not pod.has_pdb and not already_moved(moved_ids, pod.id)
                if movable:
                    current = state.nodes[pod.current_node]
                    current_peak = node_peak(current)
                    if current_peak > 0.70:
                        best_idx = best_balance_target(pod, state, current_peak)
                        if best_idx >= 0:
                            out.append(move_pod(pod.id, best_idx))
                            moved_ids.append(pod.id)
                            moved = moved + 1
    return out
# EVOLVE-BLOCK-END
