# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 45.0
    return 1.0 - min(scaled, 1.0)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0

    cpu_cap = max(node.cpu_capacity, 1)
    mem_cap = max(node.mem_capacity, 1)
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    if cpu_after > cpu_cap or mem_after > mem_cap:
        return -1000000.0

    cpu_ratio = float(cpu_after) / float(cpu_cap)
    mem_ratio = float(mem_after) / float(mem_cap)
    peak = max(cpu_ratio, mem_ratio)
    headroom = 1.0 - peak

    weighted = 0.0
    weight = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        s = ctx.graph.src[e]
        d = ctx.graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                lat = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * lat
                weight = weight + rate

    proximity = 0.5
    if weight > 0.0:
        mean_lat = weighted / weight
        proximity = proximity_of(mean_lat)

    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    power_est = node.power_idle_w + (node.power_max_w - node.power_idle_w) * peak
    energy_penalty = min(power_est / 200.0, 1.0)

    return headroom * 0.50 + proximity * 0.35 + efficiency * 0.10 + (1.0 - energy_penalty) * 0.05

def move_benefit(state: ClusterState, graph: CallGraphCtx, pod: Pod, target_idx: int) -> float:
    delta = 0.0
    edges = len(graph.src)
    for k in range(edges):
        s = graph.src[k]
        d = graph.dst[k]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                old_lat = state.nodes[pod.current_node].latency_to_ms[neighbor.current_node]
                new_lat = state.nodes[target_idx].latency_to_ms[neighbor.current_node]
                delta = delta + graph.rate[k] * (new_lat - old_lat)
    return delta

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out

    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            return out
        if graph.rate[e] > 1.0:
            sp = state.pods[graph.src[e]]
            dp = state.pods[graph.dst[e]]
            placed = sp.current_node >= 0 and dp.current_node >= 0
            if placed and sp.current_node != dp.current_node and not sp.stateful and not sp.has_pdb:
                dest = state.nodes[dp.current_node]
                if not dest.suspended:
                    cpu_cap = max(dest.cpu_capacity, 1)
                    mem_cap = max(dest.mem_capacity, 1)
                    cpu_after = dest.cpu_allocated + sp.cpu_request
                    mem_after = dest.mem_allocated + sp.mem_request
                    fits = cpu_after <= cpu_cap and mem_after <= mem_cap
                    if fits:
                        delta = move_benefit(state, graph, sp, dp.current_node)
                        if delta < 0.0:
                            out.append(move_pod(sp.id, dp.current_node))
                            moved = moved + 1
    return out
# EVOLVE-BLOCK-END
