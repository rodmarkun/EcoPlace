# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def utilization(cpu_after: int, mem_after: int, node: NodeState) -> float:
    if node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return 1.0
    cu = float(cpu_after) / float(node.cpu_capacity)
    mu = float(mem_after) / float(node.mem_capacity)
    if cu > mu:
        return cu
    return mu

def graph_latency(pod: Pod, node: NodeState, graph: CallGraphCtx, pods: list[Pod]) -> float:
    total = 0.0
    for e in range(len(graph.src)):
        s = graph.src[e]
        d = graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        elif d == pod.id:
            other = s
        if other >= 0:
            n = pods[other]
            if n.current_node >= 0:
                total += node.latency_to_ms[n.current_node]
    return total

def placement_utility(util: float, lat: float, power: float) -> float:
    util_pen = 0.0
    if util > 0.75:
        util_pen = (util - 0.75) * 200.0
    return 3.0 - 5.0 * util - 0.2 * lat - 0.001 * power - util_pen

def energy_utility(util: float, lat: float, power: float) -> float:
    util_pen = 0.0
    if util > 0.85:
        util_pen = (util - 0.85) * 100.0
    return 3.0 - 5.0 * util - 0.05 * lat - 0.03 * power - util_pen

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    if cpu_after > node.cpu_capacity or mem_after > node.mem_capacity:
        return -1000000.0
    util = utilization(cpu_after, mem_after, node)
    lat = graph_latency(pod, node, ctx.graph, ctx.pods)
    power = node.power_idle_w + util * (node.power_max_w - node.power_idle_w)
    base = placement_utility(util, lat, power)
    if node.cpu_allocated <= 0 and node.mem_allocated <= 0:
        base -= 0.5
    return base

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    for i in range(len(state.pods)):
        if len(out) >= budget:
            return out
        pod = state.pods[i]
        movable = pod.current_node >= 0 and not pod.stateful and not pod.has_pdb
        if movable:
            current = state.nodes[pod.current_node]
            cpu_after = current.cpu_allocated - pod.cpu_request
            mem_after = current.mem_allocated - pod.mem_request
            util_cur = utilization(cpu_after, mem_after, current)
            lat_cur = graph_latency(pod, current, graph, state.pods)
            power_cur = current.power_idle_w + util_cur * (current.power_max_w - current.power_idle_w)
            s_cur = energy_utility(util_cur, lat_cur, power_cur)
            frees_node = cpu_after <= 0 and mem_after <= 0 and current.suspendable
            if frees_node:
                s_cur -= 2.0
            best_j = -1
            best_s = s_cur + 0.5
            for j in range(len(state.nodes)):
                cand = state.nodes[j]
                same = j == pod.current_node
                fits_cpu = cand.cpu_allocated + pod.cpu_request <= cand.cpu_capacity
                fits_mem = cand.mem_allocated + pod.mem_request <= cand.mem_capacity
                eligible = not same and not cand.suspended and fits_cpu and fits_mem
                if eligible:
                    cpu_a = cand.cpu_allocated + pod.cpu_request
                    mem_a = cand.mem_allocated + pod.mem_request
                    util_a = utilization(cpu_a, mem_a, cand)
                    lat_a = graph_latency(pod, cand, graph, state.pods)
                    power_a = cand.power_idle_w + util_a * (cand.power_max_w - cand.power_idle_w)
                    s_a = energy_utility(util_a, lat_a, power_a)
                    target_idle = cand.cpu_allocated <= 0 and cand.mem_allocated <= 0
                    if target_idle:
                        s_a -= 1.0
                    if s_a > best_s:
                        best_s = s_a
                        best_j = j
            if best_j >= 0:
                out.append(move_pod(pod.id, best_j))
    return out
# EVOLVE-BLOCK-END
