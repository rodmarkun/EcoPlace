# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def queue_pressure(peak: float) -> float:
    return peak / max(1.0 - peak, 0.025)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    weighted_path = 0.0
    weight = 0.0
    longest_path = 0.0
    for e in range(len(ctx.graph.src)):
        other = -1
        if ctx.graph.src[e] == pod.id:
            other = ctx.graph.dst[e]
        if ctx.graph.dst[e] == pod.id:
            other = ctx.graph.src[e]
        if other >= 0 and other != pod.id and ctx.graph.rate[e] > 0.0:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                latency = node.latency_to_ms[neighbor.current_node]
                rate = ctx.graph.rate[e]
                weighted_path = weighted_path + rate * latency
                weight = weight + rate
                longest_path = max(longest_path, latency)

    mean_path = 0.5
    critical_path = 0.5
    if weight > 0.0:
        mean_path = weighted_path / weight / 45.0
        critical_path = longest_path / 45.0

    # Keep both average traffic and the slowest active dependency visible.
    # Long links retain their full cost instead of saturating at 45 ms.
    path_cost = (
        mean_path
        + critical_path * 0.75
        + critical_path * critical_path
    )
    pressure = queue_pressure(peak)
    burst_cost = max(peak - 0.50, 0.0)
    interaction = pressure * critical_path

    cpu_share = float(pod.cpu_request) / cpu_cap
    mem_share = float(pod.mem_request) / mem_cap
    dynamic_power = max(node.power_max_w - node.power_idle_w, 0.0)
    idle_share = node.power_idle_w * max(cpu_share, mem_share)
    if node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        idle_share = node.power_idle_w
    energy_cost = (dynamic_power * cpu_share + idle_share) / 120.0

    # Service margin dominates energy; energy resolves close placements.
    cost = (
        pressure * 0.75
        + burst_cost * 12.0
        + path_cost * 1.60
        + interaction * 0.35
        + energy_cost * 0.08
    )
    return -cost

def paths_do_not_worsen(
    pod: Pod,
    target_index: int,
    state: ClusterState,
    graph: CallGraphCtx
) -> bool:
    source = state.nodes[pod.current_node]
    target = state.nodes[target_index]
    for e in range(len(graph.src)):
        other = -1
        if graph.src[e] == pod.id:
            other = graph.dst[e]
        if graph.dst[e] == pod.id:
            other = graph.src[e]
        if other >= 0 and other != pod.id and graph.rate[e] > 0.0:
            neighbor = state.pods[other]
            if neighbor.current_node < 0:
                return False
            before = source.latency_to_ms[neighbor.current_node]
            after = target.latency_to_ms[neighbor.current_node]
            reverse_before = state.nodes[neighbor.current_node].latency_to_ms[pod.current_node]
            reverse_after = state.nodes[neighbor.current_node].latency_to_ms[target_index]
            if neighbor.current_node == pod.current_node:
                before = 0.0
                reverse_before = 0.0
            if neighbor.current_node == target_index:
                after = 0.0
                reverse_after = 0.0
            if after > before or reverse_after > reverse_before:
                return False
    return True

def consolidation_saving(
    pod: Pod,
    target_index: int,
    state: ClusterState,
    graph: CallGraphCtx
) -> float:
    source = state.nodes[pod.current_node]
    target = state.nodes[target_index]
    if target_index == pod.current_node or target.suspended:
        return 0.0
    if target.cpu_allocated <= 0:
        return 0.0

    source_cpu_cap = float(max(source.cpu_capacity, 1))
    source_mem_cap = float(max(source.mem_capacity, 1))
    target_cpu_cap = float(max(target.cpu_capacity, 1))
    target_mem_cap = float(max(target.mem_capacity, 1))
    source_cpu = float(source.cpu_allocated) / source_cpu_cap
    source_mem = float(source.mem_allocated) / source_mem_cap
    target_cpu = float(target.cpu_allocated + pod.cpu_request) / target_cpu_cap
    target_mem = float(target.mem_allocated + pod.mem_request) / target_mem_cap

    # Preserve burst margin and avoid increasing either resource's contention.
    if max(target_cpu, target_mem) > 0.45:
        return 0.0
    if target_cpu > source_cpu or target_mem > source_mem:
        return 0.0
    if not paths_do_not_worsen(pod, target_index, state, graph):
        return 0.0

    source_dynamic = max(source.power_max_w - source.power_idle_w, 0.0)
    target_dynamic = max(target.power_max_w - target.power_idle_w, 0.0)
    released_power = (
        source.power_idle_w
        + source_dynamic * float(pod.cpu_request) / source_cpu_cap
    )
    added_power = target_dynamic * float(pod.cpu_request) / target_cpu_cap
    return released_power - added_power

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out

    # One small, node-emptying move avoids overlapping reservations.
    # Cumulative disruption counters are not exposed by the observed records.
    best_pod = -1
    best_target = -1
    best_saving = 15.0
    for p in range(len(state.pods)):
        pod = state.pods[p]
        eligible = (
            pod.current_node >= 0
            and not pod.stateful
            and not pod.has_pdb
            and pod.image_mb <= 8
        )
        if eligible:
            source = state.nodes[pod.current_node]
            residents = 0
            for q in range(len(state.pods)):
                if state.pods[q].current_node == pod.current_node:
                    residents = residents + 1
            can_empty = (
                residents == 1
                and source.suspendable
                and not source.suspended
            )
            if can_empty:
                for t in range(len(state.nodes)):
                    saving = consolidation_saving(pod, t, state, graph)
                    if saving > best_saving:
                        best_saving = saving
                        best_pod = pod.id
                        best_target = t

    if best_pod >= 0:
        out.append(move_pod(best_pod, best_target))
    return out
# EVOLVE-BLOCK-END
