# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def queue_cost(utilization: float) -> float:
    bounded = min(max(utilization, 0.0), 0.995)
    return bounded * bounded / max(1.0 - bounded, 0.005)

def dependency_risk(latency: float, utilization: float) -> float:
    pressure = max(utilization - 0.55, 0.0)
    return (
        3.0 * max(latency, 0.0)
        + 20.0 * queue_cost(utilization)
        + 240.0 * pressure * pressure
    )

def dependency_cost(pod: Pod, node: NodeState, ctx: ClusterCtx, other: int, local_peak: float) -> float:
    neighbor = ctx.pods[other]
    if neighbor.current_node >= 0:
        target = ctx.nodes[neighbor.current_node]
        if target.suspended:
            return 1000000.0
        latency = node.latency_to_ms[neighbor.current_node]
        cpu = float(target.cpu_allocated) / float(max(target.cpu_capacity, 1))
        mem = float(target.mem_allocated) / float(max(target.mem_capacity, 1))
        peak = max(cpu, mem)
        if latency <= 0.0:
            peak = max(peak, local_peak)
        return dependency_risk(latency, peak)

    # Reserve both requests for a prospective co-located dependency.
    best_cost = 1000000.0
    for i in range(len(ctx.nodes)):
        target = ctx.nodes[i]
        if not target.suspended:
            latency = node.latency_to_ms[i]
            cpu_used = target.cpu_allocated + neighbor.cpu_request
            mem_used = target.mem_allocated + neighbor.mem_request
            if latency <= 0.0:
                cpu_used = cpu_used + pod.cpu_request
                mem_used = mem_used + pod.mem_request
            cpu = float(cpu_used) / float(max(target.cpu_capacity, 1))
            mem = float(mem_used) / float(max(target.mem_capacity, 1))
            peak = max(cpu, mem)
            if peak <= 1.0:
                best_cost = min(best_cost, dependency_risk(latency, peak))
    return best_cost

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000000.0

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_before = float(node.cpu_allocated) / cpu_cap
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000000.0

    weighted_cost = 0.0
    total_rate = 0.0
    worst_cost = 0.0
    incoming_cost = 0.0
    outgoing_cost = 0.0
    for e in range(len(ctx.graph.src)):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source
        if other >= 0 and other != pod.id and ctx.graph.rate[e] > 0.0:
            cost = dependency_cost(pod, node, ctx, other, peak)
            rate = ctx.graph.rate[e]
            weighted_cost = weighted_cost + rate * cost
            total_rate = total_rate + rate
            worst_cost = max(worst_cost, cost)
            if source == pod.id:
                outgoing_cost = outgoing_cost + cost
            else:
                incoming_cost = incoming_cost + cost

    mean_cost = 0.0
    if total_rate > 0.0:
        mean_cost = weighted_cost / total_rate

    # Tail risk and directional accumulation protect dependencies that
    # a traffic-weighted average can hide.
    path_cost = max(incoming_cost, outgoing_cost)
    pressure = max(peak - 0.55, 0.0)
    performance_cost = (
        50.0 * queue_cost(peak)
        + 650.0 * pressure * pressure
        + mean_cost
        + worst_cost
        + 0.25 * path_cost
    )

    dynamic_span = max(node.power_max_w - node.power_idle_w, 0.0)
    dynamic_increment = dynamic_span * max(
        cpu_after * cpu_after - cpu_before * cpu_before, 0.0
    )
    request_share = max(float(pod.cpu_request) / cpu_cap, float(pod.mem_request) / mem_cap)
    idle_increment = node.power_idle_w * request_share
    if node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        idle_increment = node.power_idle_w
    energy_cost = max(dynamic_increment + idle_increment, 0.0)
    bounded_energy = energy_cost / (energy_cost + 20.0)

    # Permit consolidation preference where local and dependency risk
    # leave substantial margin; keep power a bounded secondary cost.
    local_margin = max(0.55 - peak, 0.0) / 0.55
    dependency_margin = 15.0 / (15.0 + worst_cost + 0.25 * path_cost)
    energy_weight = 1.0 + 5.0 * local_margin * dependency_margin
    return -(performance_cost + energy_weight * bounded_energy)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # Remaining cumulative disruption allowances and offered-request
    # outcomes are not exposed. Preserve those allowances and avoid
    # migration-induced failures; improve placement without disruption.
    return out
# EVOLVE-BLOCK-END
