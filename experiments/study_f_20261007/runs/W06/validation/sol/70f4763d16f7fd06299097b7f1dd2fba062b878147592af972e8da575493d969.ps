# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity <= 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def endpoint_latency(pod: Pod, peer_pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    candidate_cpu = float(node.cpu_allocated + pod.cpu_request) / float(max(node.cpu_capacity, 1))
    peer_node = peer_pod.current_node
    if peer_node >= 0 and peer_node < len(node.latency_to_ms) and peer_node < len(ctx.nodes):
        peer = ctx.nodes[peer_node]
        peer_cpu = float(peer.cpu_allocated) / float(max(peer.cpu_capacity, 1))
        latency = node.latency_to_ms[peer_node]
        if latency == 0.0:
            peer_cpu = max(peer_cpu, candidate_cpu)
        peer_queue = peer_cpu * peer_cpu / max(1.0 - peer_cpu, 0.02)
        return latency + (latency + 2.0) * peer_queue

    best_latency: float = 1000000.0
    for i in range(len(ctx.nodes)):
        future = ctx.nodes[i]
        if i < len(node.latency_to_ms):
            latency = node.latency_to_ms[i]
            future_cpu = future.cpu_allocated + peer_pod.cpu_request
            future_mem = future.mem_allocated + peer_pod.mem_request
            if latency == 0.0:
                future_cpu = future_cpu + pod.cpu_request
                future_mem = future_mem + pod.mem_request
            fits = future_cpu <= future.cpu_capacity and future_mem <= future.mem_capacity
            if fits:
                utilization = float(future_cpu) / float(max(future.cpu_capacity, 1))
                memory = float(future_mem) / float(max(future.mem_capacity, 1))
                queue = utilization * utilization / max(1.0 - utilization, 0.02)
                cpu_excess = max(utilization - 0.55, 0.0)
                mem_excess = max(memory - 0.80, 0.0)
                projected_latency = latency + (latency + 2.0) * queue
                projected_latency = projected_latency + 120.0 * cpu_excess * cpu_excess
                projected_latency = projected_latency + 60.0 * mem_excess * mem_excess
                best_latency = min(best_latency, projected_latency)
    return best_latency

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cpu_capacity = float(max(node.cpu_capacity, 1))
    mem_capacity = float(max(node.mem_capacity, 1))
    cpu_before = float(node.cpu_allocated) / cpu_capacity
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_capacity
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_capacity

    cpu_headroom = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem_headroom = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    headroom_cost = 0.15 * float(100 - min(cpu_headroom, mem_headroom))

    queue_before = cpu_before * cpu_before / max(1.0 - cpu_before, 0.02)
    queue_after = cpu_after * cpu_after / max(1.0 - cpu_after, 0.02)
    queue_increase = max(queue_after - queue_before, 0.0)
    cpu_pressure = 40.0 * queue_after + 24.0 * queue_increase
    mem_pressure = 6.0 * mem_after * mem_after / max(1.0 - mem_after, 0.02)
    cpu_excess = max(cpu_after - 0.50, 0.0)
    mem_excess = max(mem_after - 0.75, 0.0)
    cpu_pressure = cpu_pressure + 360.0 * cpu_excess * cpu_excess
    mem_pressure = mem_pressure + 120.0 * mem_excess * mem_excess
    cpu_burst_excess = max(cpu_after - 0.60, 0.0)
    mem_burst_excess = max(mem_after - 0.85, 0.0)
    cpu_pressure = cpu_pressure + 2000.0 * cpu_burst_excess * cpu_burst_excess
    mem_pressure = mem_pressure + 600.0 * mem_burst_excess * mem_burst_excess

    resident_count: int = 0
    for i in range(len(ctx.pods)):
        resident_node = ctx.pods[i].current_node
        if resident_node >= 0 and resident_node < len(node.latency_to_ms):
            if node.latency_to_ms[resident_node] == 0.0:
                resident_count = resident_count + 1
    resident_cost = 4.0 * float(resident_count) * queue_increase

    dynamic_power = max(node.power_max_w - node.power_idle_w, 0.0)
    added_power = dynamic_power * max(cpu_after - cpu_before, 0.0)
    if node.suspended or (node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0):
        added_power = added_power + node.power_idle_w

    incoming_sum: float = 0.0
    outgoing_sum: float = 0.0
    incoming_max: float = 0.0
    outgoing_max: float = 0.0
    incoming_count: int = 0
    outgoing_count: int = 0

    for e in range(len(ctx.graph.src)):
        source = ctx.pods[ctx.graph.src[e]]
        target = ctx.pods[ctx.graph.dst[e]]

        if source.service == pod.service and source.app == pod.app:
            latency = endpoint_latency(pod, target, node, ctx)
            outgoing_sum = outgoing_sum + latency
            outgoing_max = max(outgoing_max, latency)
            outgoing_count = outgoing_count + 1

        if target.service == pod.service and target.app == pod.app:
            latency = endpoint_latency(pod, source, node, ctx)
            incoming_sum = incoming_sum + latency
            incoming_max = max(incoming_max, latency)
            incoming_count = incoming_count + 1

    incoming_mean = incoming_sum / float(max(incoming_count, 1))
    outgoing_mean = outgoing_sum / float(max(outgoing_count, 1))
    path_latency = incoming_max + outgoing_max
    mean_latency = incoming_mean + outgoing_mean

    latency_cost = 32.0 * path_latency + 6.0 * mean_latency
    queue_latency_cost = 8.0 * (path_latency + 2.0) * queue_after
    energy_weight = 0.40 / (1.0 + 0.05 * path_latency + queue_after)
    cost = cpu_pressure + mem_pressure + headroom_cost + latency_cost
    cost = cost + queue_latency_cost + resident_cost + energy_weight * added_power
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    # Preserve serving replicas and cumulative disruption allowance.
    # No demonstrated fields expose remaining allowance or migration SLO evidence.
    out: list[Move] = []
    return out
# EVOLVE-BLOCK-END
