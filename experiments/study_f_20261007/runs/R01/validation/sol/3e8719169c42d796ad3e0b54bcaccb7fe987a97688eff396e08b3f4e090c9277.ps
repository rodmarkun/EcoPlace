# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0

    cpu_capacity = float(max(node.cpu_capacity, 1))
    mem_capacity = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_capacity
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_capacity
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    weighted_latency = 0.0
    total_rate = 0.0
    worst_latency = 0.0
    for e in range(len(ctx.graph.src)):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor_node = ctx.pods[other].current_node
            rate = ctx.graph.rate[e]
            if neighbor_node >= 0 and rate > 0.0:
                latency = node.latency_to_ms[neighbor_node]
                if destination == pod.id:
                    latency = ctx.nodes[neighbor_node].latency_to_ms[node.id]
                weighted_latency = weighted_latency + rate * latency
                total_rate = total_rate + rate
                worst_latency = max(worst_latency, latency)

    latency_cost = 0.5
    if total_rate > 0.0:
        mean_latency = weighted_latency / total_rate
        latency_cost = 0.8 * mean_latency / 45.0 + 0.2 * worst_latency / 45.0

    # Preserve resource margin and penalize the steep part of the queueing curve.
    excess = max(peak - 0.65, 0.0)
    queue_cost = peak + 4.0 * excess * excess
    queue_cost = queue_cost + 0.05 * cpu_after / max(1.0 - cpu_after, 0.05)

    # Account for dynamic power and amortized idle draw without letting energy
    # dominate latency or resource headroom.
    cpu_increment = float(pod.cpu_request) / cpu_capacity
    idle_share = float(pod.cpu_request) / float(max(node.cpu_allocated + pod.cpu_request, 1))
    dynamic_power = max(node.power_max_w - node.power_idle_w, 0.0) * cpu_increment
    attributed_power = node.power_idle_w * idle_share + dynamic_power
    energy_cost = min(attributed_power / 120.0, 1.0)

    cost = 0.50 * queue_cost + 0.40 * latency_cost + 0.10 * energy_cost
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # Remaining cumulative disruption allowances and horizon completion metrics
    # are not exposed. Avoid adding migration count, bytes or unavailability;
    # improve placement as pods arrive through the scorer.
    return out
# EVOLVE-BLOCK-END
