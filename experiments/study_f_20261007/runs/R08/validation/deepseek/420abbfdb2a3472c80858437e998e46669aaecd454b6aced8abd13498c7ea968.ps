# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def node_util(node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_util = float(node.cpu_allocated) / cpu_cap
    mem_util = float(node.mem_allocated) / mem_cap
    return max(cpu_util, mem_util)

def util_after(node: NodeState, pod: Pod) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    peak = util_after(node, pod)
    if peak > 1.0:
        return -1000000.0

    # Queueing pressure is what breaks the SLO here, so we reward post-placement
    # margin quadratically: a node with 50% headroom is worth four times one with 25%.
    headroom = 1.0 - peak
    headroom_term = headroom * headroom

    # Rate-weighted mean latency to this pod's already-placed call-graph neighbours.
    weighted = 0.0
    weight = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * latency
                weight = weight + rate

    # A pod with no placed neighbours yet gets a neutral 0.5 rather than a free 1.0:
    # rewarding "no neighbours" would bias the very first replica of every service.
    proximity = 0.5
    if weight > 0.0:
        mean_latency = weighted / weight
        scaled = mean_latency / 40.0
        proximity = 1.0 - min(scaled, 1.0)

    # Prefer nodes that are themselves quiet, so we do not stack pods on a node
    # that is already busy even if the post-placement peak still looks legal.
    current_util = node_util(node)
    quiet = 1.0 - current_util
    if quiet < 0.0:
        quiet = 0.0

    # Idle draw spans 1.8 W (far edge) to 108 W (the dev-1 fog server); the divisor
    # keeps the term bounded without hard-coding a tier test.
    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    return headroom_term * 0.45 + proximity * 0.35 + quiet * 0.10 + efficiency * 0.10

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    moved_ids: list[int] = []
    edges = len(graph.src)
    for e in range(edges):
        if moved < budget:
            source_pod = state.pods[graph.src[e]]
            dest_pod = state.pods[graph.dst[e]]
            placed = source_pod.current_node >= 0 and dest_pod.current_node >= 0
            different = source_pod.current_node != dest_pod.current_node
            useful = graph.rate[e] > 0.0
            movable = placed and different and useful
            already_moved = False
            for i in range(len(moved_ids)):
                if moved_ids[i] == source_pod.id:
                    already_moved = True
            eligible = movable and not already_moved
            eligible = eligible and not source_pod.stateful and not source_pod.has_pdb
            if eligible:
                target = state.nodes[dest_pod.current_node]
                target_util = util_after(target, source_pod)
                # Only pull the pod when the destination keeps real margin
                # afterwards; an unconditional pull is what makes latency_greedy
                # overload and blow the SLO.
                good_target = not target.suspended and target_util < 0.70
                if good_target:
                    out.append(move_pod(source_pod.id, dest_pod.current_node))
                    moved = moved + 1
                    moved_ids.append(source_pod.id)
    return out
# EVOLVE-BLOCK-END
