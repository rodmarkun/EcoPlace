# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_headroom(requested: int, capacity: int) -> int:
    if capacity <= 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def neighbor_latency(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    count = 0
    for i in range(len(ctx.graph.src)):
        src = ctx.graph.src[i]
        dst = ctx.graph.dst[i]
        other = -1
        if src == pod.id:
            other = dst
        if dst == pod.id:
            other = src
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
                count += 1
    if count == 0:
        return 0.0
    return total / float(count)

def pod_latency(pod: Pod, node_id: int, state: ClusterState, graph: CallGraphCtx) -> float:
    total = 0.0
    count = 0
    node = state.nodes[node_id]
    for i in range(len(graph.src)):
        src = graph.src[i]
        dst = graph.dst[i]
        other = -1
        if src == pod.id:
            other = dst
        if dst == pod.id:
            other = src
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
                count += 1
    if count == 0:
        return 0.0
    return total / float(count)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cpu_req = node.cpu_allocated + pod.cpu_request
    mem_req = node.mem_allocated + pod.mem_request
    if node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return -1000000.0
    if cpu_req > node.cpu_capacity or mem_req > node.mem_capacity:
        return -1000000.0
    if node.suspended:
        return -500000.0
    cpu_head = resource_headroom(cpu_req, node.cpu_capacity)
    mem_head = resource_headroom(mem_req, node.mem_capacity)
    head = float((cpu_head + mem_head) // 2)
    cpu_util = float(cpu_req) / float(node.cpu_capacity)
    mem_util = float(mem_req) / float(node.mem_capacity)
    queue = cpu_util
    if mem_util > queue:
        queue = mem_util
    avg_latency = neighbor_latency(pod, node, ctx)
    power = node.power_idle_w
    if node.power_max_w > node.power_idle_w:
        power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * queue
    active_bonus = 0.0
    if node.cpu_allocated > 0 or node.mem_allocated > 0:
        active_bonus = 5.0
    score_val = head * 4.0 - queue * 120.0 - avg_latency * 2.0 - power * 0.05 + active_bonus
    return score_val

def best_target_for_pod(pod: Pod, state: ClusterState, graph: CallGraphCtx) -> int:
    if pod.current_node < 0:
        return -1
    source = state.nodes[pod.current_node]
    if not source.suspendable:
        return -1
    src_cpu_after = source.cpu_allocated - pod.cpu_request
    src_mem_after = source.mem_allocated - pod.mem_request
    if src_cpu_after > 0 or src_mem_after > 0:
        return -1
    best_target = -1
    best_score = -1000000.0
    for target_id in range(len(state.nodes)):
        if target_id != pod.current_node and not state.nodes[target_id].suspended:
            target = state.nodes[target_id]
            tgt_cpu = target.cpu_allocated + pod.cpu_request
            tgt_mem = target.mem_allocated + pod.mem_request
            if tgt_cpu <= target.cpu_capacity and tgt_mem <= target.mem_capacity:
                cpu_util = float(tgt_cpu) / float(target.cpu_capacity)
                mem_util = float(tgt_mem) / float(target.mem_capacity)
                if cpu_util < 0.8 and mem_util < 0.8:
                    src_idle = source.power_idle_w
                    tgt_inc = 0.0
                    if target.power_max_w > target.power_idle_w:
                        tgt_inc = (target.power_max_w - target.power_idle_w) * (float(pod.cpu_request) / float(target.cpu_capacity))
                    if src_idle > tgt_inc:
                        src_lat = pod_latency(pod, pod.current_node, state, graph)
                        tgt_lat = pod_latency(pod, target_id, state, graph)
                        score_t = -tgt_inc * 10.0 - tgt_lat * 1.0
                        if tgt_lat <= src_lat + 5.0 and score_t > best_score:
                            best_score = score_t
                            best_target = target_id
    return best_target

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    for pod in state.pods:
        if len(out) >= budget:
            return out
        if pod.current_node >= 0:
            target = best_target_for_pod(pod, state, graph)
            if target >= 0:
                out.append(move_pod(pod.id, target))
    return out
# EVOLVE-BLOCK-END
