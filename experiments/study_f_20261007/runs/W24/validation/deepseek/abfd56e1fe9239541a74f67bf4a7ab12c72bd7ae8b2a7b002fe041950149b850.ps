# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 45.0
    return 1.0 - min(scaled, 1.0)

def node_peak_after(node: NodeState, pod: Pod) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    peak = node_peak_after(node, pod)
    if peak > 1.0:
        return -1000000.0

    # Convex (squared) headroom: a node at 0.4 utilisation is worth far more than
    # two nodes at 0.8, because queueing pressure at the SLO boundary is what the
    # feedback attributes the shortfall to. Energy is a distant fourth term.
    headroom = 1.0 - peak
    headroom_sq = headroom * headroom

    weighted = 0.0
    weight = 0.0
    worst_lat = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                lat = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * lat
                weight = weight + rate
                if lat > worst_lat:
                    worst_lat = lat

    proximity = 0.5
    if weight > 0.0:
        proximity = proximity_of(weighted / weight)

    worst_term = 1.0 - min(worst_lat / 50.0, 1.0)
    worst_term_sq = worst_term * worst_term

    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    return headroom_sq * 0.52 + proximity * 0.30 + worst_term_sq * 0.16 + efficiency * 0.02

def utility_for_move(state: ClusterState, graph: CallGraphCtx, pod: Pod, node: NodeState, peak: float) -> float:
    if node.suspended:
        return -1000000.0
    if peak > 1.0:
        return -1000000.0

    headroom = 1.0 - peak
    headroom_sq = headroom * headroom

    weighted = 0.0
    weight = 0.0
    worst_lat = 0.0
    edges = len(graph.src)
    for e in range(edges):
        source = graph.src[e]
        destination = graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                rate = graph.rate[e]
                lat = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * lat
                weight = weight + rate
                if lat > worst_lat:
                    worst_lat = lat

    proximity = 0.5
    if weight > 0.0:
        proximity = proximity_of(weighted / weight)

    worst_term = 1.0 - min(worst_lat / 50.0, 1.0)
    worst_term_sq = worst_term * worst_term

    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    return headroom_sq * 0.52 + proximity * 0.30 + worst_term_sq * 0.16 + efficiency * 0.02

def best_target_for_pod(state: ClusterState, graph: CallGraphCtx, pod: Pod, origin: NodeState, origin_idx: int, o_peak: float) -> int:
    # Score every node with the same objective the placement scorer uses, so the
    # controller pulls pods toward the node the scorer would itself pick — this
    # keeps the ranking and the rebalancing controller consistent, which is what
    # closes the SLO gap on the call-graph-heavy workloads.
    best_target = -1
    best_gain = 0.0
    origin_util = utility_for_move(state, graph, pod, origin, o_peak)
    node_count = len(state.nodes)
    for j in range(node_count):
        if j != origin_idx:
            target = state.nodes[j]
            t_peak = node_peak_after(target, pod)
            if t_peak < 0.70:
                t_util = utility_for_move(state, graph, pod, target, t_peak)
                gain = t_util - origin_util
                if gain > best_gain and gain > 0.03:
                    best_gain = gain
                    best_target = j
    return best_target

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    pod_count = len(state.pods)
    for i in range(pod_count):
        if moved < budget:
            pod = state.pods[i]
            origin_idx = pod.current_node
            movable = origin_idx >= 0 and not pod.stateful and not pod.has_pdb
            if movable:
                origin = state.nodes[origin_idx]
                o_cpu_cap = float(max(origin.cpu_capacity, 1))
                o_mem_cap = float(max(origin.mem_capacity, 1))
                o_cpu = float(origin.cpu_allocated) / o_cpu_cap
                o_mem = float(origin.mem_allocated) / o_mem_cap
                o_peak = max(o_cpu, o_mem)
                target_idx = best_target_for_pod(state, graph, pod, origin, origin_idx, o_peak)
                if target_idx >= 0:
                    out.append(move_pod(pod.id, target_idx))
                    moved = moved + 1
    return out
# EVOLVE-BLOCK-END
