# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_pressure(node: NodeState, pod: Pod) -> float:
    cpu_used = 0.0
    if node.cpu_capacity > 0:
        cpu_used = float(node.cpu_allocated + pod.cpu_request) / float(node.cpu_capacity)
    mem_used = 0.0
    if node.mem_capacity > 0:
        mem_used = float(node.mem_allocated + pod.mem_request) / float(node.mem_capacity)
    pressure = cpu_used
    if mem_used > pressure:
        pressure = mem_used
    return pressure

def energy_estimate(node: NodeState, pod: Pod) -> float:
    cpu_frac = 0.0
    if node.cpu_capacity > 0:
        cpu_frac = float(node.cpu_allocated + pod.cpu_request) / float(node.cpu_capacity)
    return node.power_idle_w + (node.power_max_w - node.power_idle_w) * cpu_frac

def latency_cost(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    total = 0.0
    max_lat = 0.0
    count = 0
    for i in range(len(graph.src)):
        src = graph.src[i]
        dst = graph.dst[i]
        other = -1
        if src == pod.id:
            other = dst
        if dst == pod.id:
            other = src
        if other >= 0 and other != pod.id:
            nb = pods[other]
            if nb.current_node >= 0:
                lat = node.latency_to_ms[nb.current_node]
                total += lat
                if lat > max_lat:
                    max_lat = lat
                count += 1
    if count > 0:
        return max_lat * 0.6 + (total / float(count)) * 0.4
    return 0.0

def placement_cost(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    pressure = resource_pressure(node, pod)
    energy = energy_estimate(node, pod)
    latency = latency_cost(pod, node, pods, graph)
    cost = energy * 0.002 + pressure * 3.5 + latency * 0.22
    if node.suspended:
        cost += 3.0
    if pressure > 0.85:
        cost += (pressure - 0.85) * 25.0
    if pressure > 0.95:
        cost += (pressure - 0.95) * 150.0
    return cost

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cost = placement_cost(pod, node, ctx.pods, ctx.graph)
    return -cost

def service_count(state: ClusterState, pod: Pod) -> int:
    count = 0
    for p in state.pods:
        if p.service == pod.service:
            count += 1
    return count

def target_headroom(node: NodeState, pod: Pod) -> int:
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_frac = 0.0
    if node.cpu_capacity > 0:
        cpu_frac = float(cpu_after) / float(node.cpu_capacity)
    mem_frac = 0.0
    if node.mem_capacity > 0:
        mem_frac = float(mem_after) / float(node.mem_capacity)
    if cpu_frac > 0.85 or mem_frac > 0.85:
        return 0
    return 1

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    moves_made = 0
    for pod in state.pods:
        if moves_made >= budget:
            return out
        if pod.current_node < 0:
            pass
        elif pod.stateful or pod.has_pdb:
            pass
        else:
            count = service_count(state, pod)
            if count > 1:
                current = state.nodes[pod.current_node]
                current_cost = placement_cost(pod, current, state.pods, graph)
                best_target = -1
                best_cost = current_cost
                for i in range(len(state.nodes)):
                    if i != pod.current_node:
                        node = state.nodes[i]
                        target_cost = placement_cost(pod, node, state.pods, graph)
                        if target_cost < best_cost:
                            best_cost = target_cost
                            best_target = i
                if best_target >= 0:
                    improvement = current_cost - best_cost
                    if improvement > 0.35:
                        target = state.nodes[best_target]
                        ok = target_headroom(target, pod)
                        if ok == 1:
                            out.append(move_pod(pod.id, best_target))
                            moves_made += 1
    return out
# EVOLVE-BLOCK-END
