# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_headroom(requested: int, capacity: int) -> int:
    if capacity <= 0:
        return 0
    if requested >= capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def score_node(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    cpu = resource_headroom(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem = resource_headroom(node.mem_allocated + pod.mem_request, node.mem_capacity)
    headroom = float(min(cpu, mem))
    latency_sum = 0.0
    neighbors = 0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                latency_sum += node.latency_to_ms[neighbor.current_node]
                neighbors += 1
    if neighbors > 0:
        avg = latency_sum / float(neighbors)
        headroom -= avg * 5.0
    if node.suspended:
        headroom -= 100.0
    if node.cpu_allocated > 0 and headroom > 30.0:
        headroom += 10.0
    return headroom

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return score_node(pod, node, ctx.pods, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    for pod in state.pods:
        if len(out) >= budget:
            return out
        if pod.current_node >= 0:
            current = state.nodes[pod.current_node]
            current_score = score_node(pod, current, state.pods, graph)
            best = pod.current_node
            best_score = current_score
            for i in range(len(state.nodes)):
                if i != pod.current_node:
                    node = state.nodes[i]
                    fits = node.cpu_allocated + pod.cpu_request <= node.cpu_capacity and node.mem_allocated + pod.mem_request <= node.mem_capacity
                    if fits and not node.suspended:
                        candidate = score_node(pod, node, state.pods, graph)
                        if candidate > best_score:
                            best_score = candidate
                            best = i
            improvement = best_score - current_score
            threshold = 2.0
            if pod.stateful:
                threshold = 10.0
            elif pod.has_pdb:
                threshold = 5.0
            if best != pod.current_node and improvement > threshold:
                out.append(move_pod(pod.id, best))
    return out
# EVOLVE-BLOCK-END
