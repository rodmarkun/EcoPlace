# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 45.0
    return 1.0 - min(scaled, 1.0)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0
    headroom = 1.0 - peak
    weighted = 0.0
    weight = 0.0
    for e in range(len(ctx.graph.src)):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                weighted += rate * node.latency_to_ms[neighbor.current_node]
                weight += rate
    proximity = 0.5
    if weight > 0.0:
        proximity = proximity_of(weighted / weight)
    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    return headroom * 0.50 + proximity * 0.35 + efficiency * 0.15

def link_cost(
    pod_index: int,
    target: int,
    locations: list[int],
    state: ClusterState,
    graph: CallGraphCtx
) -> float:
    total = 0.0
    for e in range(len(graph.src)):
        source = graph.src[e]
        destination = graph.dst[e]
        if source == pod_index and destination != pod_index:
            other_node = locations[destination]
            if other_node >= 0:
                total += graph.rate[e] * state.nodes[target].latency_to_ms[other_node]
        elif destination == pod_index and source != pod_index:
            other_node = locations[source]
            if other_node >= 0:
                total += graph.rate[e] * state.nodes[other_node].latency_to_ms[target]
    return total

def links_safe(
    pod_index: int,
    source_node: int,
    target: int,
    locations: list[int],
    state: ClusterState,
    graph: CallGraphCtx
) -> bool:
    for e in range(len(graph.src)):
        source = graph.src[e]
        destination = graph.dst[e]
        if source == pod_index and destination != pod_index:
            other_node = locations[destination]
            if other_node >= 0:
                before = state.nodes[source_node].latency_to_ms[other_node]
                after = state.nodes[target].latency_to_ms[other_node]
                if after > before:
                    return False
        elif destination == pod_index and source != pod_index:
            other_node = locations[source]
            if other_node >= 0:
                before = state.nodes[other_node].latency_to_ms[source_node]
                after = state.nodes[other_node].latency_to_ms[target]
                if after > before:
                    return False
    return True

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    cpu: list[int] = []
    memory: list[int] = []
    locations: list[int] = []
    selected: list[bool] = []
    for n in range(len(state.nodes)):
        cpu.append(state.nodes[n].cpu_allocated)
        memory.append(state.nodes[n].mem_allocated)
    for p in range(len(state.pods)):
        locations.append(state.pods[p].current_node)
        selected.append(False)
    for step in range(budget):
        best_pod = -1
        best_target = -1
        best_value = 0.0
        for p in range(len(state.pods)):
            pod = state.pods[p]
            source_index = locations[p]
            eligible = source_index >= 0 and not selected[p] and not pod.stateful and not pod.has_pdb
            if eligible:
                source = state.nodes[source_index]
                source_cap = float(max(source.cpu_capacity, 1))
                source_dynamic = max(source.power_max_w - source.power_idle_w, 0.0)
                before_links = link_cost(p, source_index, locations, state, graph)
                for n in range(len(state.nodes)):
                    target = state.nodes[n]
                    eligible_target = n != source_index and not target.suspended and cpu[n] > 0
                    if eligible_target:
                        cpu_cap = float(max(target.cpu_capacity, 1))
                        mem_cap = float(max(target.mem_capacity, 1))
                        cpu_after = float(cpu[n] + pod.cpu_request) / cpu_cap
                        mem_after = float(memory[n] + pod.mem_request) / mem_cap
                        safe = max(cpu_after, mem_after) < 0.70
                        if safe and links_safe(p, source_index, n, locations, state, graph):
                            target_dynamic = max(target.power_max_w - target.power_idle_w, 0.0)
                            saving = float(pod.cpu_request) * (source_dynamic / source_cap - target_dynamic / cpu_cap)
                            empty_source = cpu[source_index] == pod.cpu_request and memory[source_index] == pod.mem_request
                            if empty_source and source.suspendable:
                                saving += source.power_idle_w
                            after_links = link_cost(p, n, locations, state, graph)
                            improvement = max(before_links - after_links, 0.0)
                            value = saving + improvement * 0.02
                            if saving > 0.0 and value > best_value:
                                best_value = value
                                best_pod = p
                                best_target = n
        if best_pod < 0:
            return out
        pod = state.pods[best_pod]
        source_index = locations[best_pod]
        out.append(move_pod(pod.id, best_target))
        next_cpu: list[int] = []
        next_memory: list[int] = []
        for n in range(len(state.nodes)):
            cpu_value = cpu[n]
            memory_value = memory[n]
            if n == source_index:
                cpu_value -= pod.cpu_request
                memory_value -= pod.mem_request
            elif n == best_target:
                cpu_value += pod.cpu_request
                memory_value += pod.mem_request
            next_cpu.append(cpu_value)
            next_memory.append(memory_value)
        cpu = next_cpu
        memory = next_memory
        next_locations: list[int] = []
        next_selected: list[bool] = []
        for p in range(len(state.pods)):
            location = locations[p]
            already_selected = selected[p]
            if p == best_pod:
                location = best_target
                already_selected = True
            next_locations.append(location)
            next_selected.append(already_selected)
        locations = next_locations
        selected = next_selected
    return out
# EVOLVE-BLOCK-END
