# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def neighbor_latency(pod_id: int, node_id: int, state: ClusterState, graph: CallGraphCtx) -> float:
    total = 0.0
    node = state.nodes[node_id]
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod_id:
            other = destination
        if destination == pod_id:
            other = source
        if other >= 0 and other != pod_id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
    return total

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
    cpu_free = node.cpu_capacity - node.cpu_allocated - pod.cpu_request
    mem_free = node.mem_capacity - node.mem_allocated - pod.mem_request
    headroom = float(cpu_free + mem_free)
    power_penalty = node.power_max_w * 0.001
    return -total - power_penalty + headroom * 0.0001

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    count = 0
    for i in range(len(state.pods)):
        if count >= budget:
            return out
        pod = state.pods[i]
        if pod.current_node >= 0:
            current = state.nodes[pod.current_node]
            current_lat = neighbor_latency(pod.id, pod.current_node, state, graph)
            lat_cap = current_lat * 1.5
            target_id = -1
            for j in range(len(state.nodes)):
                if j != pod.current_node:
                    target = state.nodes[j]
                    cpu_ok = target.cpu_allocated + pod.cpu_request <= target.cpu_capacity
                    mem_ok = target.mem_allocated + pod.mem_request <= target.mem_capacity
                    fits = cpu_ok and mem_ok and target.suspended == False
                    if fits:
                        target_lat = neighbor_latency(pod.id, j, state, graph)
                        lat_ok = target_lat <= lat_cap
                        cheaper = target_id < 0 or target.power_max_w < state.nodes[target_id].power_max_w
                        if lat_ok and cheaper:
                            target_id = j
            if target_id >= 0 and state.nodes[target_id].power_max_w < current.power_max_w:
                out.append(move_pod(pod.id, target_id))
                count += 1
    return out
# EVOLVE-BLOCK-END
