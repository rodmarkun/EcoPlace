# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def pressure_of(peak: float) -> float:
    headroom = max(1.0 - peak, 0.01)
    reserve_deficit = max(peak - 0.50, 0.0)
    return peak * peak / headroom + 32.0 * reserve_deficit * reserve_deficit

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_before = float(node.cpu_allocated) / cpu_cap
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    # Reserve serving capacity before burst pressure exhausts admission headroom.
    pressure = pressure_of(peak)
    weighted_latency = 0.0
    weighted_tail = 0.0
    weighted_dependency = 0.0
    weight = 0.0
    worst_latency = 0.0
    worst_path = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        outgoing = False
        if source == pod.id:
            other = destination
            outgoing = True
        elif destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            rate = ctx.graph.rate[e]
            if neighbor.current_node >= 0 and rate > 0.0:
                neighbor_node = ctx.nodes[neighbor.current_node]
                latency = neighbor_node.latency_to_ms[node.id]
                if outgoing:
                    latency = node.latency_to_ms[neighbor.current_node]

                neighbor_cpu = float(neighbor_node.cpu_allocated) / float(max(neighbor_node.cpu_capacity, 1))
                neighbor_mem = float(neighbor_node.mem_allocated) / float(max(neighbor_node.mem_capacity, 1))
                neighbor_peak = max(neighbor_cpu, neighbor_mem)
                if neighbor.current_node == node.id:
                    neighbor_peak = peak

                dependency_pressure = pressure_of(neighbor_peak)
                endpoint_peak = max(peak, neighbor_peak)
                link_risk = latency / 30.0
                link_risk = link_risk * link_risk
                link_risk = link_risk / max(1.0 - endpoint_peak, 0.10)
                weighted_latency = weighted_latency + rate * latency
                weighted_tail = weighted_tail + rate * link_risk
                weighted_dependency = weighted_dependency + rate * dependency_pressure
                weight = weight + rate
                worst_latency = max(worst_latency, latency)
                path_risk = latency / 30.0 + link_risk
                path_risk = path_risk + 0.35 * dependency_pressure
                worst_path = max(worst_path, path_risk)

    # Directional link tails and projected endpoint pressure protect dependencies.
    path_cost = 0.0
    dependency_cost = 0.0
    if weight > 0.0:
        path_cost = weighted_latency / weight / 15.0
        path_cost = path_cost + weighted_tail / weight
        path_cost = path_cost + worst_latency / 45.0
        dependency_cost = weighted_dependency / weight

    # Charge marginal dynamic power and the idle draw of opening an empty node.
    dynamic_power = max(node.power_max_w - node.power_idle_w, 0.0)
    power_cost = dynamic_power * max(cpu_after - cpu_before, 0.0)
    if node.cpu_allocated == 0 and node.mem_allocated == 0:
        power_cost = power_cost + node.power_idle_w

    cost = 2.0 * pressure + path_cost + 0.35 * dependency_cost
    cost = cost + 0.40 * worst_path + 0.25 * power_cost / 120.0
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # No cumulative disruption allowance is exposed. Avoid repeated migrations
    # and preserve serving capacity throughout the offered-request horizon.
    return out
# EVOLVE-BLOCK-END
