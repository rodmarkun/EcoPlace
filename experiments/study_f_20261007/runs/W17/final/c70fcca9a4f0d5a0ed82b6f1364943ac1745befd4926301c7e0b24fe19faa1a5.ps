# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def avg_latency_node(node: NodeState) -> float:
    n: int = len(node.latency_to_ms)
    if n == 0:
        return 0.0
    total: float = 0.0
    for i in range(n):
        total = total + node.latency_to_ms[i]
    return total / float(n)

def find_pod_index_state(pod: Pod, state: ClusterState) -> int:
    for i in range(len(state.pods)):
        if state.pods[i].id == pod.id:
            return i
    return -1

def find_pod_index_ctx(pod: Pod, ctx: ClusterCtx) -> int:
    for i in range(len(ctx.pods)):
        if ctx.pods[i].id == pod.id:
            return i
    return -1

def node_latency_to_pod(node: NodeState, pod_idx: int, state: ClusterState, graph: CallGraphCtx) -> float:
    total: float = 0.0
    count: int = 0
    for e in range(len(graph.src)):
        src: int = graph.src[e]
        dst: int = graph.dst[e]
        other: int = -1
        if src == pod_idx:
            other = dst
        elif dst == pod_idx:
            other = src
        if other >= 0:
            other_node: int = state.pods[other].current_node
            if other_node >= 0 and other_node < len(node.latency_to_ms):
                total = total + node.latency_to_ms[other_node]
                count = count + 1
    if count == 0:
        return avg_latency_node(node)
    return total / float(count)

def edge_latency_ctx(pod_index: int, node: NodeState, ctx: ClusterCtx) -> float:
    total: float = 0.0
    count: int = 0
    for e in range(len(ctx.graph.src)):
        src: int = ctx.graph.src[e]
        dst: int = ctx.graph.dst[e]
        other: int = -1
        if src == pod_index:
            other = dst
        elif dst == pod_index:
            other = src
        if other >= 0:
            other_node: int = ctx.pods[other].current_node
            if other_node >= 0 and other_node < len(node.latency_to_ms):
                total = total + node.latency_to_ms[other_node]
                count = count + 1
    if count == 0:
        return avg_latency_node(node)
    return total / float(count)

def fits_node(node: NodeState, cpu: int, mem: int) -> int:
    if node.cpu_capacity < node.cpu_allocated + cpu:
        return 0
    if node.mem_capacity < node.mem_allocated + mem:
        return 0
    return 1

def contains(lst: list[int], val: int) -> int:
    for i in range(len(lst)):
        if lst[i] == val:
            return 1
    return 0

def move_score(pod: Pod, node: NodeState, pod_idx: int, state: ClusterState, graph: CallGraphCtx) -> float:
    cpu = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    head = float(min(cpu, mem))
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_util: float = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(cpu_after) / float(node.cpu_capacity)
    mem_util: float = 0.0
    if node.mem_capacity > 0:
        mem_util = float(mem_after) / float(node.mem_capacity)
    util: float = cpu_util
    if mem_util > util:
        util = mem_util
    if util > 1.0:
        util = 1.0
    queue_penalty: float = util * util * 200.0
    power: float = node.power_idle_w
    if node.cpu_capacity > 0 and node.mem_capacity > 0:
        power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * util
    power_penalty: float = power * 0.005
    lat: float = avg_latency_node(node)
    if pod_idx >= 0:
        lat = node_latency_to_pod(node, pod_idx, state, graph)
    latency_penalty: float = lat * 2.0
    suspended_penalty: float = 0.0
    if node.suspended:
        suspended_penalty = 500.0
    return head - queue_penalty - power_penalty - latency_penalty - suspended_penalty

def select_target(pod: Pod, src: NodeState, pod_idx: int, state: ClusterState, graph: CallGraphCtx, used_targets: list[int]) -> int:
    current_score = move_score(pod, src, pod_idx, state, graph)
    best_idx: int = -1
    best_score: float = -1000000.0
    for j in range(len(state.nodes)):
        if j != pod.current_node:
            if contains(used_targets, j) == 0:
                cand = state.nodes[j]
                if cand.suspended == False:
                    if fits_node(cand, pod.cpu_request, pod.mem_request) == 1:
                        cand_score = move_score(pod, cand, pod_idx, state, graph)
                        if cand_score > best_score:
                            best_score = cand_score
                            best_idx = j
    if best_idx >= 0:
        if best_score > current_score + 5.0:
            return best_idx
    return -1

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cpu = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    head = float(min(cpu, mem))
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_util: float = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(cpu_after) / float(node.cpu_capacity)
    mem_util: float = 0.0
    if node.mem_capacity > 0:
        mem_util = float(mem_after) / float(node.mem_capacity)
    util: float = cpu_util
    if mem_util > util:
        util = mem_util
    if util > 1.0:
        util = 1.0
    queue_penalty: float = util * util * 200.0
    power: float = node.power_idle_w
    if node.cpu_capacity > 0 and node.mem_capacity > 0:
        power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * util
    power_penalty: float = power * 0.005
    idx: int = find_pod_index_ctx(pod, ctx)
    lat: float = avg_latency_node(node)
    if idx >= 0:
        lat = edge_latency_ctx(idx, node, ctx)
    latency_penalty: float = lat * 2.0
    suspended_penalty: float = 0.0
    if node.suspended:
        suspended_penalty = 500.0
    return head - queue_penalty - power_penalty - latency_penalty - suspended_penalty

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    used_targets: list[int] = []
    moves_made: int = 0
    for i in range(len(state.pods)):
        if moves_made >= budget:
            return out
        pod = state.pods[i]
        if pod.current_node >= 0 and pod.stateful == False and pod.has_pdb == False:
            src = state.nodes[pod.current_node]
            if src.suspendable and src.suspended == False:
                if src.cpu_allocated == pod.cpu_request and src.mem_allocated == pod.mem_request:
                    pod_idx = find_pod_index_state(pod, state)
                    target = select_target(pod, src, pod_idx, state, graph, used_targets)
                    if target >= 0:
                        out.append(move_pod(pod.id, target))
                        used_targets.append(target)
                        moves_made = moves_made + 1
    return out
# EVOLVE-BLOCK-END
