# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def pressure(allocated: int, requested: int, capacity: int) -> float:
    if capacity <= 0:
        return 1.0
    cap = max(capacity, 1)
    total = allocated + requested
    return float(total) / float(cap)

def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 45.0
    return 1.0 - min(scaled, 1.0)

def graph_proximity(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    weighted = 0.0
    weight = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * latency
                weight = weight + rate
    if weight <= 0.0:
        return 0.5
    return proximity_of(weighted / weight)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_after = pressure(node.cpu_allocated, pod.cpu_request, node.cpu_capacity)
    mem_after = pressure(node.mem_allocated, pod.mem_request, node.mem_capacity)
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0
    headroom = 1.0 - peak
    proximity = graph_proximity(pod, node, ctx)
    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    return headroom * 0.50 + proximity * 0.45 + efficiency * 0.05

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    proposed: list[int] = []
    moved = 0
    if budget <= 0:
        return out
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            return out
        src_pod = state.pods[graph.src[e]]
        dst_pod = state.pods[graph.dst[e]]
        movable = src_pod.current_node >= 0 and dst_pod.current_node >= 0 and src_pod.current_node != dst_pod.current_node and not src_pod.stateful and not src_pod.has_pdb
        if movable:
            target = state.nodes[dst_pod.current_node]
            cpu_after = pressure(target.cpu_allocated, src_pod.cpu_request, target.cpu_capacity)
            mem_after = pressure(target.mem_allocated, src_pod.mem_request, target.mem_capacity)
            peak = max(cpu_after, mem_after)
            if not target.suspended and peak < 0.70:
                dup = False
                for p in proposed:
                    if p == src_pod.id:
                        dup = True
                if not dup:
                    out.append(move_pod(src_pod.id, dst_pod.current_node))
                    proposed.append(src_pod.id)
                    moved = moved + 1
    return out
# EVOLVE-BLOCK-END
