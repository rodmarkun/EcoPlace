# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def pressure(utilization: float) -> float:
    reserve = max(1.0 - utilization, 0.02)
    return utilization * utilization / reserve

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000000.0

    cpu_added = pod.cpu_request
    mem_added = pod.mem_request
    if pod.current_node == node.id:
        cpu_added = 0
        mem_added = 0

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_before = float(node.cpu_allocated) / cpu_cap
    cpu_after = float(node.cpu_allocated + cpu_added) / cpu_cap
    mem_after = float(node.mem_allocated + mem_added) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000000.0

    local_pressure = pressure(peak)
    weighted_path = 0.0
    total_rate = 0.0
    worst_path = 0.0
    incoming_path = 0.0
    outgoing_path = 0.0

    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        outgoing = False
        if source == pod.id and destination != pod.id:
            other = destination
            outgoing = True
        elif destination == pod.id and source != pod.id:
            other = source

        rate = max(ctx.graph.rate[e], 0.0)
        if other >= 0 and rate > 0.0:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                neighbor_node = ctx.nodes[neighbor.current_node]
                latency = 0.0
                neighbor_peak = peak
                if neighbor.current_node != node.id:
                    latency = neighbor_node.latency_to_ms[node.id]
                    if outgoing:
                        latency = node.latency_to_ms[neighbor.current_node]

                    neighbor_cpu_allocated = neighbor_node.cpu_allocated
                    neighbor_mem_allocated = neighbor_node.mem_allocated
                    if pod.current_node == neighbor.current_node:
                        neighbor_cpu_allocated = max(neighbor_cpu_allocated - pod.cpu_request, 0)
                        neighbor_mem_allocated = max(neighbor_mem_allocated - pod.mem_request, 0)

                    neighbor_cpu = float(neighbor_cpu_allocated) / float(max(neighbor_node.cpu_capacity, 1))
                    neighbor_mem = float(neighbor_mem_allocated) / float(max(neighbor_node.mem_capacity, 1))
                    neighbor_peak = max(neighbor_cpu, neighbor_mem)

                neighbor_pressure = pressure(neighbor_peak)
                path = latency / 8.0
                path = path * (1.0 + local_pressure + neighbor_pressure)
                path = path + neighbor_pressure
                weighted_path = weighted_path + rate * path
                total_rate = total_rate + rate
                worst_path = max(worst_path, path)
                if outgoing:
                    outgoing_path = max(outgoing_path, path)
                else:
                    incoming_path = max(incoming_path, path)

    mean_path = 0.0
    if total_rate > 0.0:
        mean_path = weighted_path / total_rate
    critical_path = max(worst_path, incoming_path + outgoing_path)

    # Strengthen burst reserve and critical-path protection after SLO shortfall.
    # Offered-request outcomes and application targets remain unavailable;
    # these safeguards are proxies rather than feasibility certificates.
    reserve_excess = max(peak - 0.65, 0.0)
    reserve_cost = 1000.0 * reserve_excess + 2000.0 * reserve_excess * reserve_excess
    queue_cost = 10.0 * local_pressure
    path_cost = 2.0 * mean_path + 3.0 * critical_path

    # Prefer efficient active capacity with a bounded marginal energy term.
    dynamic_span = max(node.power_max_w - node.power_idle_w, 0.0)
    incremental_power = dynamic_span * max(cpu_after - cpu_before, 0.0)
    if (cpu_added > 0 or mem_added > 0) and node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        incremental_power = incremental_power + node.power_idle_w

    released_power = 0.0
    if pod.current_node >= 0 and pod.current_node != node.id:
        old_node = ctx.nodes[pod.current_node]
        old_cpu_cap = float(max(old_node.cpu_capacity, 1))
        old_cpu_before = float(old_node.cpu_allocated) / old_cpu_cap
        old_cpu_after = float(max(old_node.cpu_allocated - pod.cpu_request, 0)) / old_cpu_cap
        old_dynamic_span = max(old_node.power_max_w - old_node.power_idle_w, 0.0)
        released_power = old_dynamic_span * max(old_cpu_before - old_cpu_after, 0.0)
        if old_node.suspendable and old_node.cpu_allocated <= pod.cpu_request and old_node.mem_allocated <= pod.mem_request:
            released_power = released_power + old_node.power_idle_w

    marginal_power = incremental_power - released_power
    energy_cost = marginal_power / (40.0 + max(marginal_power, -marginal_power))

    cost = reserve_cost + queue_cost + path_cost + energy_cost
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    # Remaining cumulative migration, byte and unavailability allowances are
    # unavailable. Abstention preserves them and adds no migration shortfall.
    return out
# EVOLVE-BLOCK-END
