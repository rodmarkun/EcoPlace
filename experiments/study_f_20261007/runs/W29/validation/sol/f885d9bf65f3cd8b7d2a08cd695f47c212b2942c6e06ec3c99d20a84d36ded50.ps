# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def queue_pressure(utilization: float) -> float:
    return utilization * utilization / max(1.0 - utilization, 0.025)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended or node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return -1000000.0

    cpu_capacity = float(node.cpu_capacity)
    mem_capacity = float(node.mem_capacity)
    cpu_before = float(node.cpu_allocated) / cpu_capacity
    mem_before = float(node.mem_allocated) / mem_capacity
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_capacity
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_capacity
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    cpu_queue = queue_pressure(cpu_after)
    mem_queue = queue_pressure(mem_after)
    pressure = max(cpu_queue, mem_queue)
    pressure_before = max(queue_pressure(cpu_before), queue_pressure(mem_before))
    pressure_increment = max(pressure - pressure_before, 0.0)

    total_rate = 0.0
    latency_sum = 0.0
    latency_square_sum = 0.0
    interaction_sum = 0.0
    incoming_tail = 0.0
    outgoing_tail = 0.0
    for e in range(len(ctx.graph.src)):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            peer_index = ctx.pods[other].current_node
            rate = ctx.graph.rate[e]
            if peer_index >= 0 and rate > 0.0:
                peer = ctx.nodes[peer_index]
                latency = node.latency_to_ms[peer_index]
                if destination == pod.id:
                    latency = peer.latency_to_ms[node.id]
                if peer_index == node.id:
                    latency = 0.0
                scaled = max(latency, 0.0) / 45.0
                peer_cpu = float(peer.cpu_allocated) / float(max(peer.cpu_capacity, 1))
                peer_mem = float(peer.mem_allocated) / float(max(peer.mem_capacity, 1))
                peer_pressure = max(queue_pressure(peer_cpu), queue_pressure(peer_mem))
                if peer_index == node.id:
                    peer_pressure = pressure
                total_rate = total_rate + rate
                latency_sum = latency_sum + rate * scaled
                latency_square_sum = latency_square_sum + rate * scaled * scaled
                interaction_sum = interaction_sum + rate * scaled * (pressure + peer_pressure)
                if destination == pod.id:
                    incoming_tail = max(incoming_tail, scaled)
                else:
                    outgoing_tail = max(outgoing_tail, scaled)

    mean_latency = 0.0
    mean_square = 0.0
    interaction = 0.0
    if total_rate > 0.0:
        mean_latency = latency_sum / total_rate
        mean_square = latency_square_sum / total_rate
        interaction = interaction_sum / total_rate

    path_latency = incoming_tail + outgoing_tail
    burst_excess = max(peak - 0.60, 0.0)
    path_excess = max(path_latency - 0.60, 0.0)

    # Charge marginal power and the idle cost of activating suspendable capacity.
    dynamic_power = max(node.power_max_w - node.power_idle_w, 0.0)
    incremental_power = dynamic_power * max(cpu_after - cpu_before, 0.0)
    if node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        incremental_power = incremental_power + node.power_idle_w
    energy_cost = incremental_power / 120.0

    # Energy influences placement most when resource and path margins are ample.
    resource_margin = max(1.0 - peak / 0.65, 0.0)
    path_margin = max(1.0 - path_latency / 1.0, 0.0)
    energy_weight = 0.02 + 0.40 * resource_margin * path_margin

    cost = (
        0.45 * peak
        + 0.45 * pressure
        + 0.15 * pressure_increment
        + 4.0 * burst_excess * burst_excess
        + 0.65 * mean_latency
        + 0.25 * mean_square
        + 0.55 * path_latency
        + 0.65 * path_excess * path_excess
        + 0.15 * interaction
        + 0.15 * path_latency * cpu_queue
        + energy_weight * energy_cost
    )
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # No remaining cumulative disruption allowance or offered-load SLO margin
    # is exposed; preserve serving capacity without adding migration disruption.
    return out
# EVOLVE-BLOCK-END
