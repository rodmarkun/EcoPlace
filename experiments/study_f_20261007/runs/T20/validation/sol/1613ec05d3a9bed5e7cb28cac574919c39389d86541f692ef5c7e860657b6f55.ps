# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity <= 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def queue_cost(utilization: float) -> float:
    excess = max(utilization - 0.50, 0.0)
    pressure = 16.0 * utilization * utilization / max(1.0 - utilization, 0.025)
    return pressure + 240.0 * excess * excess

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cpu_capacity = float(max(node.cpu_capacity, 1))
    mem_capacity = float(max(node.mem_capacity, 1))
    cpu_before = float(node.cpu_allocated) / cpu_capacity
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_capacity
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_capacity
    cpu_pressure = queue_cost(cpu_after)

    total_latency = 0.0
    longest = 0.0
    incoming = 0.0
    outgoing = 0.0
    colocated_pressure = 0.0
    incident_count = 0

    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source

        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                neighbor_node = ctx.nodes[neighbor.current_node]
                neighbor_utilization = float(neighbor_node.cpu_allocated) / float(max(neighbor_node.cpu_capacity, 1))
                if neighbor.current_node == node.id:
                    neighbor_utilization = cpu_after
                    colocated_pressure = max(colocated_pressure, cpu_pressure)

                neighbor_pressure = queue_cost(neighbor_utilization)
                latency = node.latency_to_ms[neighbor.current_node]
                if destination == pod.id:
                    latency = neighbor_node.latency_to_ms[node.id]

                latency *= 1.0 + 0.006 * min(neighbor_pressure, 200.0)
                total_latency += latency
                longest = max(longest, latency)
                incident_count += 1
                if source == pod.id:
                    outgoing = max(outgoing, latency)
                else:
                    incoming = max(incoming, latency)

    mean_latency = total_latency / float(max(incident_count, 1))
    communication_cost = total_latency + 3.0 * (incoming + outgoing)
    communication_cost += 1.5 * longest + 0.5 * mean_latency
    communication_cost *= 1.0 + cpu_after * cpu_after

    mem_excess = max(mem_after - 0.65, 0.0)
    mem_pressure = 100.0 * mem_excess * mem_excess / max(1.0 - mem_after, 0.025)
    headroom = float(min(resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity), resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity))) / 100.0

    power_range = max(node.power_max_w - node.power_idle_w, 0.0)
    marginal_power = power_range * max(cpu_after - cpu_before, 0.0)
    if node.cpu_allocated == 0 or node.suspended:
        marginal_power += node.power_idle_w

    cost = communication_cost + cpu_pressure + mem_pressure
    cost += 0.25 * colocated_pressure
    cost += 0.03 * headroom * headroom * marginal_power
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    return out
# EVOLVE-BLOCK-END
