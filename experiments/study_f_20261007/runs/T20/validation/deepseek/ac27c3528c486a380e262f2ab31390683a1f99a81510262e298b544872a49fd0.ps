# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity <= 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def contains_int(items: list[int], value: int) -> bool:
    for item in items:
        if item == value:
            return True
    return False

def graph_latency(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    total = 0.0
    maxlat = 0.0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                lat = node.latency_to_ms[neighbor.current_node]
                total += lat
                if lat > maxlat:
                    maxlat = lat
    return total * 1.5 + maxlat * 3.0

def node_score_alloc(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx, cpu_used: int, mem_used: int) -> float:
    cpu_head = resource_score(cpu_used, node.cpu_capacity)
    mem_head = resource_score(mem_used, node.mem_capacity)
    headroom = cpu_head
    if mem_head < headroom:
        headroom = mem_head
    cpu_util = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(cpu_used) / float(node.cpu_capacity)
    mem_util = 0.0
    if node.mem_capacity > 0:
        mem_util = float(mem_used) / float(node.mem_capacity)
    queue_penalty = 0.0
    if cpu_util > 0.50:
        queue_penalty += (cpu_util - 0.50) * 800.0
    if mem_util > 0.70:
        queue_penalty += (mem_util - 0.70) * 400.0
    overload = 0.0
    if headroom < 40:
        overload = float(40 - headroom) * 20.0
    active_bonus = 0.0
    if node.cpu_allocated > 0 or node.mem_allocated > 0:
        if headroom >= 40:
            active_bonus = 15.0
    power_penalty = node.power_idle_w * 0.01
    latency_penalty = graph_latency(pod, node, pods, graph) * 60.0
    return float(headroom) * 0.7 + active_bonus - overload - queue_penalty - power_penalty - latency_penalty

def node_score(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    cpu_used = node.cpu_allocated + pod.cpu_request
    mem_used = node.mem_allocated + pod.mem_request
    return node_score_alloc(pod, node, pods, graph, cpu_used, mem_used)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return node_score(pod, node, ctx.pods, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    used_targets: list[int] = []
    moves_made = 0
    for pod in state.pods:
        if moves_made >= budget:
            return out
        current = pod.current_node
        if current >= 0:
            current_node = state.nodes[current]
            current_cpu_used = current_node.cpu_allocated
            current_mem_used = current_node.mem_allocated
            current_score = node_score_alloc(pod, current_node, state.pods, graph, current_cpu_used, current_mem_used)
            move_threshold = 6.0
            if pod.stateful:
                move_threshold += 30.0
            if pod.has_pdb:
                move_threshold += 15.0
            move_threshold += float(pod.mem_request) * 0.01
            move_threshold += float(pod.image_mb) * 0.001
            if current_node.cpu_capacity > 0:
                current_util = float(current_cpu_used) / float(current_node.cpu_capacity)
                if current_util > 0.85:
                    move_threshold = 0.0
                elif current_util > 0.70:
                    move_threshold = move_threshold * 0.5
            best_score = current_score + move_threshold
            best_node = -1
            for i in range(len(state.nodes)):
                node = state.nodes[i]
                fits = (i != current) and (node.suspended == False) and (node.cpu_allocated + pod.cpu_request <= node.cpu_capacity) and (node.mem_allocated + pod.mem_request <= node.mem_capacity)
                if fits:
                    if contains_int(used_targets, i) == False:
                        target_cpu_used = node.cpu_allocated + pod.cpu_request
                        target_mem_used = node.mem_allocated + pod.mem_request
                        s = node_score_alloc(pod, node, state.pods, graph, target_cpu_used, target_mem_used)
                        if s > best_score:
                            best_score = s
                            best_node = i
            if best_node >= 0:
                out.append(move_pod(pod.id, best_node))
                used_targets.append(best_node)
                moves_made += 1
    return out
# EVOLVE-BLOCK-END
