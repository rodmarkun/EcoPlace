# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 45.0
    return 1.0 - min(scaled, 1.0)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    # Retain the seed's balanced headroom preference, with a steeper cost
    # only as contention begins to threaten burst handling.
    headroom = max(1.0 - peak, 0.01)
    queue_cost = peak / headroom
    burst_excess = max(peak - 0.65, 0.0)
    resource_cost = peak * 0.50 + queue_cost * 0.04
    resource_cost = resource_cost + burst_excess * burst_excess * 8.0

    weighted = 0.0
    weight = 0.0
    traffic_latency = 0.0
    traffic_weight = 0.0
    worst_latency = 0.0
    incoming_worst = 0.0
    outgoing_worst = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id and ctx.graph.rate[e] > 0.0:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                peer = ctx.nodes[neighbor.current_node]
                latency = node.latency_to_ms[neighbor.current_node]
                if destination == pod.id:
                    latency = peer.latency_to_ms[node.id]
                if neighbor.current_node == node.id:
                    latency = 0.0
                rate = ctx.graph.rate[e]
                traffic = rate * max(ctx.graph.payload_kb[e], 1.0)
                weighted = weighted + rate * latency
                weight = weight + rate
                traffic_latency = traffic_latency + traffic * latency
                traffic_weight = traffic_weight + traffic
                worst_latency = max(worst_latency, latency)
                if destination == pod.id:
                    incoming_worst = max(incoming_worst, latency)
                if source == pod.id:
                    outgoing_worst = max(outgoing_worst, latency)

    # Means protect busy links; directional maxima keep a low-rate
    # predecessor-to-successor path visible during placement.
    latency_cost = 0.175
    if weight > 0.0:
        latency_cost = weighted / weight / 45.0 * 0.35
        latency_cost = latency_cost + worst_latency / 60.0 * 0.12
        path_latency = incoming_worst + outgoing_worst
        latency_cost = latency_cost + max(path_latency - 45.0, 0.0) / 45.0 * 0.20
    if traffic_weight > 0.0:
        latency_cost = latency_cost + traffic_latency / traffic_weight / 120.0 * 0.05

    # Activation costs apply only when an empty node can otherwise sleep.
    marginal_power = max(node.power_max_w - node.power_idle_w, 0.0)
    marginal_power = marginal_power * float(pod.cpu_request) / cpu_cap
    if node.cpu_allocated == 0 and node.mem_allocated == 0 and node.suspendable:
        marginal_power = marginal_power + node.power_idle_w

    # Reduce consolidation pressure when either contention or a long
    # critical link already places service quality at risk.
    energy_weight = 0.08
    if peak > 0.65 or worst_latency > 45.0:
        energy_weight = 0.01
    energy_cost = marginal_power / 120.0 * energy_weight
    return -(resource_cost + latency_cost + energy_cost)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # Remaining cumulative migration, byte and downtime allowances are
    # unavailable. Zero moves preserve those budgets across every window.
    return out
# EVOLVE-BLOCK-END
