# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    # Sharper proximity scale: SLO shortfall is driven by dependency latency,
    # so short links should dominate mid-range ones.
    scaled = mean_latency_ms / 25.0
    return 1.0 - min(scaled, 1.0)

def peak_after(node: NodeState, pod: Pod) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after)

def node_util(node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu = float(node.cpu_allocated) / cpu_cap
    mem = float(node.mem_allocated) / mem_cap
    return max(cpu, mem)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    peak = peak_after(node, pod)
    if peak > 1.0:
        return -1000000.0

    # Cubic burst margin: strongly prefer nodes with real slack so that
    # queueing pressure does not erase the dependency-latency gain.
    headroom = 1.0 - peak
    burst = headroom * headroom * headroom

    weighted = 0.0
    weight = 0.0
    worst = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * latency
                weight = weight + rate
                if latency > worst:
                    worst = latency

    proximity = 0.5
    if weight > 0.0:
        mean = weighted / weight
        mean_prox = proximity_of(mean)
        worst_prox = proximity_of(worst)
        proximity = mean_prox * 0.55 + worst_prox * 0.45

    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    return burst * 0.40 + proximity * 0.50 + efficiency * 0.10

def contains_id(ids: list[int], pid: int) -> bool:
    for i in range(len(ids)):
        if ids[i] == pid:
            return True
    return False

def is_movable(pod: Pod, moved_ids: list[int]) -> bool:
    if pod.current_node < 0:
        return False
    if pod.stateful or pod.has_pdb:
        return False
    if contains_id(moved_ids, pod.id):
        return False
    return True

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    moved_ids: list[int] = []
    edges = len(graph.src)
    for e in range(edges):
        if moved < budget:
            source_pod = state.pods[graph.src[e]]
            dest_pod = state.pods[graph.dst[e]]
            different = source_pod.current_node != dest_pod.current_node
            placed = source_pod.current_node >= 0 and dest_pod.current_node >= 0
            if different and placed:
                source_ok = is_movable(source_pod, moved_ids)
                dest_ok = is_movable(dest_pod, moved_ids)
                if source_ok or dest_ok:
                    src_node = state.nodes[source_pod.current_node]
                    dst_node = state.nodes[dest_pod.current_node]
                    src_util = node_util(src_node)
                    dst_util = node_util(dst_node)
                    peak_sd = peak_after(dst_node, source_pod)
                    peak_ds = peak_after(src_node, dest_pod)
                    source_can = source_ok and not dst_node.suspended and peak_sd < 0.60
                    dest_can = dest_ok and not src_node.suspended and peak_ds < 0.60
                    # Prefer moving from the more loaded node to the less loaded one.
                    if source_can and dst_util + 0.05 < src_util:
                        out.append(move_pod(source_pod.id, dest_pod.current_node))
                        moved_ids.append(source_pod.id)
                        moved = moved + 1
                    elif dest_can and src_util + 0.05 < dst_util:
                        out.append(move_pod(dest_pod.id, source_pod.current_node))
                        moved_ids.append(dest_pod.id)
                        moved = moved + 1
                    elif source_can and dest_can:
                        if peak_sd <= peak_ds:
                            out.append(move_pod(source_pod.id, dest_pod.current_node))
                            moved_ids.append(source_pod.id)
                            moved = moved + 1
                        else:
                            out.append(move_pod(dest_pod.id, source_pod.current_node))
                            moved_ids.append(dest_pod.id)
                            moved = moved + 1
                    elif source_can:
                        out.append(move_pod(source_pod.id, dest_pod.current_node))
                        moved_ids.append(source_pod.id)
                        moved = moved + 1
                    elif dest_can:
                        out.append(move_pod(dest_pod.id, source_pod.current_node))
                        moved_ids.append(dest_pod.id)
                        moved = moved + 1
    return out
# EVOLVE-BLOCK-END
