# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def placement_score(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx, add_request: int) -> float:
    if node.suspended:
        return -1000000.0
    cpu_used = node.cpu_allocated
    mem_used = node.mem_allocated
    if add_request == 1:
        cpu_used = cpu_used + pod.cpu_request
        mem_used = mem_used + pod.mem_request
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(cpu_used) / cpu_cap
    mem_after = float(mem_used) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    headroom = 1.0 - peak
    headroom = headroom * headroom

    weighted = 0.0
    weight = 0.0
    edges = len(graph.src)
    for e in range(edges):
        source = graph.src[e]
        destination = graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                rate = graph.rate[e]
                weighted = weighted + rate * node.latency_to_ms[neighbor.current_node]
                weight = weight + rate

    proximity = 0.5
    if weight > 0.0:
        proximity = 1.0 - min(weighted / weight / 45.0, 1.0)

    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    return headroom * 0.55 + proximity * 0.35 + efficiency * 0.10

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return placement_score(pod, node, ctx.pods, ctx.graph, 1)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    for i in range(len(state.pods)):
        if moved >= budget:
            return out
        pod = state.pods[i]
        movable = pod.current_node >= 0 and not pod.stateful and not pod.has_pdb
        if movable:
            current_node = state.nodes[pod.current_node]
            current_score = placement_score(pod, current_node, state.pods, graph, 0)

            cpu_cap = float(max(current_node.cpu_capacity, 1))
            mem_cap = float(max(current_node.mem_capacity, 1))
            cpu_after = float(current_node.cpu_allocated) / cpu_cap
            mem_after = float(current_node.mem_allocated) / mem_cap
            current_peak = max(cpu_after, mem_after)

            best_score = current_score
            best_node = -1
            for n in range(len(state.nodes)):
                if n != pod.current_node:
                    candidate = state.nodes[n]
                    if not candidate.suspended:
                        candidate_score = placement_score(pod, candidate, state.pods, graph, 1)
                        if candidate_score > best_score + 0.05:
                            best_score = candidate_score
                            best_node = n

            if best_node >= 0:
                if current_peak > 0.75 or best_score > current_score + 0.15:
                    out.append(move_pod(pod.id, best_node))
                    moved = moved + 1
    return out
# EVOLVE-BLOCK-END
