# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 30.0
    return 1.0 - min(scaled, 1.0)

def node_peak_after(node: NodeState, pod: Pod) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    peak = node_peak_after(node, pod)
    if peak > 1.0:
        return -1000000.0

    headroom = 1.0 - peak

    weighted = 0.0
    weight = 0.0
    max_latency = 0.0
    placed_neighbors = 0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * latency
                weight = weight + rate
                if latency > max_latency:
                    max_latency = latency
                placed_neighbors = placed_neighbors + 1

    mean_prox = 0.5
    if weight > 0.0:
        mean_prox = proximity_of(weighted / weight)
    max_prox = 0.5
    if placed_neighbors > 0:
        max_prox = proximity_of(max_latency)
    proximity = (mean_prox * 0.7 + max_prox * 0.3)

    power_after = node.power_idle_w + (node.power_max_w - node.power_idle_w) * peak
    efficiency = 1.0 - min(power_after / 200.0, 1.0)
    return headroom * 0.25 + proximity * 0.35 + efficiency * 0.40

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        source_pod = state.pods[graph.src[e]]
        destination_pod = state.pods[graph.dst[e]]
        movable_edge = (
            moved < budget
            and source_pod.current_node >= 0
            and destination_pod.current_node >= 0
            and source_pod.current_node != destination_pod.current_node
        )
        if movable_edge:
            source_node = state.nodes[source_pod.current_node]
            target_node = state.nodes[destination_pod.current_node]
            latency = source_node.latency_to_ms[destination_pod.current_node]
            peak_dest = node_peak_after(target_node, source_pod)
            peak_src = node_peak_after(source_node, destination_pod)
            best_peak = 2.0
            best_target = -1
            best_pod = -1

            source_empty_after = (source_node.cpu_allocated - source_pod.cpu_request <= 0) and (source_node.mem_allocated - source_pod.mem_request <= 0)
            source_can_suspend = source_node.suspendable and source_empty_after
            target_cheaper = target_node.power_idle_w <= source_node.power_idle_w
            if not source_pod.stateful and not source_pod.has_pdb:
                if latency > 10.0 or target_cheaper or source_can_suspend:
                    if peak_dest < best_peak:
                        best_peak = peak_dest
                        best_target = destination_pod.current_node
                        best_pod = source_pod.id

            target_empty_after = (target_node.cpu_allocated - destination_pod.cpu_request <= 0) and (target_node.mem_allocated - destination_pod.mem_request <= 0)
            target_can_suspend = target_node.suspendable and target_empty_after
            source_cheaper = source_node.power_idle_w <= target_node.power_idle_w
            if not destination_pod.stateful and not destination_pod.has_pdb:
                if latency > 10.0 or source_cheaper or target_can_suspend:
                    if peak_src < best_peak:
                        best_peak = peak_src
                        best_target = source_pod.current_node
                        best_pod = destination_pod.id

            if best_pod >= 0 and best_peak < 0.70:
                target = state.nodes[best_target]
                if not target.suspended:
                    out.append(move_pod(best_pod, best_target))
                    moved = moved + 1
    return out
# EVOLVE-BLOCK-END
