# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def node_score_for_pod(state: ClusterState, graph: CallGraphCtx, pod_index: int, node_index: int) -> float:
    pod = state.pods[pod_index]
    node = state.nodes[node_index]
    cpu = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    headroom = float((cpu + mem) // 2)
    lat = 0.0
    edges = 0
    for edge in range(len(graph.src)):
        src = graph.src[edge]
        dst = graph.dst[edge]
        other = -1
        if src == pod.id:
            other = dst
        elif dst == pod.id:
            other = src
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                neighbor_node = state.nodes[neighbor.current_node]
                edge_lat = node.latency_to_ms[neighbor.current_node]
                if neighbor_node.tier != node.tier:
                    edge_lat = edge_lat * 2.0
                lat += edge_lat
                edges += 1
    avg_lat = 0.0
    if edges > 0:
        avg_lat = lat / float(edges)
    cpu_util = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(node.cpu_allocated + pod.cpu_request) / float(node.cpu_capacity)
    power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * cpu_util
    return headroom * 3.0 - avg_lat * 4.0 - power * 0.05

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cpu = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    headroom = float((cpu + mem) // 2)
    lat = 0.0
    edges = 0
    for edge in range(len(ctx.graph.src)):
        src = ctx.graph.src[edge]
        dst = ctx.graph.dst[edge]
        other = -1
        if src == pod.id:
            other = dst
        elif dst == pod.id:
            other = src
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                neighbor_node = ctx.nodes[neighbor.current_node]
                edge_lat = node.latency_to_ms[neighbor.current_node]
                if neighbor_node.tier != node.tier:
                    edge_lat = edge_lat * 2.0
                lat += edge_lat
                edges += 1
    avg_lat = 0.0
    if edges > 0:
        avg_lat = lat / float(edges)
    cpu_util = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(node.cpu_allocated + pod.cpu_request) / float(node.cpu_capacity)
    power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * cpu_util
    return headroom * 3.0 - avg_lat * 4.0 - power * 0.05

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    count = 0
    for i in range(len(state.pods)):
        if count >= budget:
            return out
        pod = state.pods[i]
        if pod.current_node >= 0 and not pod.stateful and not pod.has_pdb:
            current = pod.current_node
            current_score = node_score_for_pod(state, graph, i, current)
            best_node = current
            best_score = current_score
            for j in range(len(state.nodes)):
                node = state.nodes[j]
                fits = node.cpu_allocated + pod.cpu_request <= node.cpu_capacity and node.mem_allocated + pod.mem_request <= node.mem_capacity and not node.suspended
                if fits and j != current:
                    score_val = node_score_for_pod(state, graph, i, j)
                    if score_val > best_score:
                        best_score = score_val
                        best_node = j
            if best_node != current and best_score > current_score + 1.0:
                out.append(move_pod(pod.id, best_node))
                count += 1
    return out
# EVOLVE-BLOCK-END
