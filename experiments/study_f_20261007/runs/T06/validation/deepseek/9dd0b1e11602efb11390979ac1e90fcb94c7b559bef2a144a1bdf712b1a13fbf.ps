# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def cpu_util(node: NodeState, pod: Pod) -> float:
    if node.cpu_capacity <= 0:
        return 1.0
    used = node.cpu_allocated + pod.cpu_request
    if used >= node.cpu_capacity:
        return 1.0
    return float(used) / float(node.cpu_capacity)

def mem_util(node: NodeState, pod: Pod) -> float:
    if node.mem_capacity <= 0:
        return 1.0
    used = node.mem_allocated + pod.mem_request
    if used >= node.mem_capacity:
        return 1.0
    return float(used) / float(node.mem_capacity)

def latency_penalty(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    count = 0
    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
                count += 1
    if count > 0:
        return total / float(count)
    return 0.0

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    util = cpu_util(node, pod)
    mem = mem_util(node, pod)
    span = node.power_max_w - node.power_idle_w
    if span < 0.0:
        span = 0.0
    power_after = node.power_idle_w + span * util
    power_cost = 0.0
    if node.power_max_w > 0.0:
        power_cost = power_after / node.power_max_w
    else:
        power_cost = power_after
    lat = latency_penalty(pod, node, ctx)
    pressure = util * util + mem * mem
    load_frac = 0.0
    if node.cpu_capacity > 0:
        load_frac = float(node.cpu_allocated) / float(node.cpu_capacity)
    pack_bonus = load_frac * 10.0
    if node.cpu_allocated > 0:
        pack_bonus = pack_bonus + 3.0
    cost = power_cost * 8.0 + lat * 1.5 + pressure * 30.0 - pack_bonus
    return -cost

def latency_penalty_state(pod: Pod, node: NodeState, state: ClusterState, graph: CallGraphCtx) -> float:
    total = 0.0
    count = 0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
                count += 1
    if count > 0:
        return total / float(count)
    return 0.0

def move_cost(pod: Pod, node: NodeState, state: ClusterState, graph: CallGraphCtx) -> float:
    if node.suspended:
        return 1000000.0
    util = cpu_util(node, pod)
    mem = mem_util(node, pod)
    span = node.power_max_w - node.power_idle_w
    if span < 0.0:
        span = 0.0
    power_after = node.power_idle_w + span * util
    power_cost = 0.0
    if node.power_max_w > 0.0:
        power_cost = power_after / node.power_max_w
    else:
        power_cost = power_after
    lat = latency_penalty_state(pod, node, state, graph)
    pressure = util * util + mem * mem
    load_frac = 0.0
    if node.cpu_capacity > 0:
        load_frac = float(node.cpu_allocated) / float(node.cpu_capacity)
    pack_bonus = load_frac * 10.0
    if node.cpu_allocated > 0:
        pack_bonus = pack_bonus + 3.0
    cost = power_cost * 8.0 + lat * 1.5 + pressure * 30.0 - pack_bonus
    return cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    for pod in state.pods:
        if len(out) >= budget:
            return out
        current = pod.current_node
        if current < 0:
            best_node = -1
            best_cost = 1000000.0
            for i in range(len(state.nodes)):
                node = state.nodes[i]
                fits = node.suspended == False and node.cpu_allocated + pod.cpu_request <= node.cpu_capacity and node.mem_allocated + pod.mem_request <= node.mem_capacity
                if fits:
                    cost = move_cost(pod, node, state, graph)
                    if cost < best_cost:
                        best_cost = cost
                        best_node = i
            if best_node >= 0:
                out.append(move_pod(pod.id, best_node))
        else:
            current_node = state.nodes[current]
            current_cost = move_cost(pod, current_node, state, graph)
            remaining_cpu = current_node.cpu_allocated - pod.cpu_request
            remaining_mem = current_node.mem_allocated - pod.mem_request
            vacate = 0.0
            if remaining_cpu <= 0 and remaining_mem <= 0 and current_node.suspendable:
                vacate = 8.0
            best_node = -1
            best_cost = current_cost
            for i in range(len(state.nodes)):
                node = state.nodes[i]
                fits = i != current and node.suspended == False and node.cpu_allocated + pod.cpu_request <= node.cpu_capacity and node.mem_allocated + pod.mem_request <= node.mem_capacity
                if fits:
                    cost = move_cost(pod, node, state, graph) - vacate
                    if cost < best_cost - 0.5:
                        best_cost = cost
                        best_node = i
            if best_node >= 0:
                out.append(move_pod(pod.id, best_node))
    return out
# EVOLVE-BLOCK-END
