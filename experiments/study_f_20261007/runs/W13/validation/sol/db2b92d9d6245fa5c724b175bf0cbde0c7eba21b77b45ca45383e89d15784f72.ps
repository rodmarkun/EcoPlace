# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def queue_cost(utilization: float) -> float:
    remaining = max(1.0 - utilization, 0.001)
    return utilization * utilization / remaining

def dependency_delay(pod: Pod, neighbor: Pod, node: NodeState, ctx: ClusterCtx, outgoing: bool) -> float:
    if neighbor.current_node >= 0:
        neighbor_node = ctx.nodes[neighbor.current_node]
        latency = neighbor_node.latency_to_ms[node.id]
        if outgoing:
            latency = node.latency_to_ms[neighbor.current_node]

        neighbor_cpu = neighbor_node.cpu_allocated
        neighbor_mem = neighbor_node.mem_allocated
        if neighbor.current_node == node.id:
            neighbor_cpu = neighbor_cpu + pod.cpu_request
            neighbor_mem = neighbor_mem + pod.mem_request

        neighbor_cpu_util = float(neighbor_cpu) / float(max(neighbor_node.cpu_capacity, 1))
        neighbor_mem_util = float(neighbor_mem) / float(max(neighbor_node.mem_capacity, 1))
        neighbor_peak = max(neighbor_cpu_util, neighbor_mem_util)
        return latency + 8.0 * queue_cost(neighbor_peak)

    best_future_cost = 1000000.0
    second_future_cost = 1000000.0
    feasible_options = 0
    candidate_cpu = node.cpu_allocated + pod.cpu_request
    candidate_mem = node.mem_allocated + pod.mem_request
    candidate_cpu_util = float(candidate_cpu) / float(max(node.cpu_capacity, 1))
    candidate_mem_util = float(candidate_mem) / float(max(node.mem_capacity, 1))
    candidate_peak = max(candidate_cpu_util, candidate_mem_util)

    for n in range(len(ctx.nodes)):
        future_node = ctx.nodes[n]
        future_cpu = future_node.cpu_allocated + neighbor.cpu_request
        future_mem = future_node.mem_allocated + neighbor.mem_request
        if future_node.id == node.id:
            future_cpu = future_cpu + pod.cpu_request
            future_mem = future_mem + pod.mem_request

        future_cpu_util = float(future_cpu) / float(max(future_node.cpu_capacity, 1))
        future_mem_util = float(future_mem) / float(max(future_node.mem_capacity, 1))
        future_peak = max(future_cpu_util, future_mem_util)
        if not future_node.suspended and future_peak < 0.75:
            future_latency = future_node.latency_to_ms[node.id]
            if outgoing:
                future_latency = node.latency_to_ms[future_node.id]

            future_cost = future_latency + 8.0 * queue_cost(future_peak)
            if future_node.id == node.id:
                added_pressure = max(queue_cost(future_peak) - queue_cost(candidate_peak), 0.0)
                future_cost = future_cost + 8.0 * added_pressure

            if future_cost < best_future_cost:
                second_future_cost = best_future_cost
                best_future_cost = future_cost
            else:
                second_future_cost = min(second_future_cost, future_cost)
            feasible_options = feasible_options + 1

    if feasible_options == 0:
        return 180.0
    if feasible_options == 1:
        return best_future_cost + 8.0

    alternative_gap = min(max(second_future_cost - best_future_cost, 0.0), 30.0)
    return best_future_cost + 2.0 + 0.25 * alternative_gap

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000000000.0

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak >= 1.0:
        return -1000000000000.0

    # Preserve burst and timeout margins before rewarding consolidation.
    cpu_pressure = queue_cost(cpu_after)
    peak_pressure = queue_cost(peak)
    pressure = 40.0 * peak_pressure + 14.0 * cpu_pressure
    excess = max(peak - 0.55, 0.0)
    pressure = pressure + 450.0 * excess * excess
    high_excess = max(peak - 0.75, 0.0)
    pressure = pressure + 2000.0 * high_excess * high_excess

    weighted_latency = 0.0
    weighted_squared_latency = 0.0
    weight = 0.0
    longest_latency = 0.0
    longest_incoming = 0.0
    longest_outgoing = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        outgoing = False
        if source == pod.id:
            other = destination
            outgoing = True
        elif destination == pod.id:
            other = source

        if other >= 0 and other != pod.id and ctx.graph.rate[e] > 0.0:
            neighbor = ctx.pods[other]
            rate = ctx.graph.rate[e]
            latency = dependency_delay(pod, neighbor, node, ctx, outgoing)
            weighted_latency = weighted_latency + rate * latency
            weighted_squared_latency = weighted_squared_latency + rate * latency * latency
            weight = weight + rate
            longest_latency = max(longest_latency, latency)
            if outgoing:
                longest_outgoing = max(longest_outgoing, latency)
            else:
                longest_incoming = max(longest_incoming, latency)

    mean_latency = 22.5
    mean_squared_latency = 506.25
    tail_latency = 22.5
    path_delay = 22.5
    if weight > 0.0:
        mean_latency = weighted_latency / weight
        mean_squared_latency = weighted_squared_latency / weight
        tail_latency = longest_latency
        path_delay = longest_incoming + longest_outgoing

    # Protect rare slow edges and both sides of intermediate services.
    path_excess = max(path_delay - tail_latency, 0.0)
    network_cost = 1.20 * mean_latency + 1.20 * tail_latency
    network_cost = network_cost + 0.025 * mean_squared_latency
    network_cost = network_cost + 0.80 * path_excess
    network_cost = network_cost + 0.008 * path_delay * path_delay
    network_cost = network_cost + 0.30 * path_delay * cpu_pressure

    dynamic_range = max(node.power_max_w - node.power_idle_w, 0.0)
    incremental_power = dynamic_range * float(pod.cpu_request) / cpu_cap
    if node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        incremental_power = incremental_power + node.power_idle_w

    # Retain the parent's energy preference with stronger delay protection.
    energy_cost = incremental_power / 24.0
    return -(pressure + network_cost + energy_cost)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # Remaining cumulative disruption allowances and native migration feasibility
    # are unavailable. Avoid speculative moves that could consume those allowances
    # or interrupt offered requests near the end of the horizon.
    return out
# EVOLVE-BLOCK-END
