# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def find_pod_index(pod: Pod, pods: list[Pod]) -> int:
    n: int = len(pods)
    for idx in range(n):
        if pods[idx].id == pod.id:
            return idx
    return -1

def latency_penalty_idx(pod_idx: int, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    if pod_idx < 0:
        return 0.0
    max_lat: float = 0.0
    m: int = len(graph.src)
    for e in range(m):
        s: int = graph.src[e]
        d: int = graph.dst[e]
        if s == pod_idx:
            other: int = d
            if other < len(pods):
                other_node: int = pods[other].current_node
                if other_node >= 0 and other_node < len(node.latency_to_ms):
                    l: float = node.latency_to_ms[other_node]
                    if l > max_lat:
                        max_lat = l
        if d == pod_idx:
            other2: int = s
            if other2 < len(pods):
                other_node2: int = pods[other2].current_node
                if other_node2 >= 0 and other_node2 < len(node.latency_to_ms):
                    l2: float = node.latency_to_ms[other_node2]
                    if l2 > max_lat:
                        max_lat = l2
    return max_lat

def node_score_idx(pod: Pod, pod_idx: int, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    cpu_after: int = node.cpu_allocated + pod.cpu_request
    mem_after: int = node.mem_allocated + pod.mem_request
    cpu_util: float = 0.0
    if node.cpu_capacity > 0:
        cpu_util = float(cpu_after) / float(node.cpu_capacity)
    mem_util: float = 0.0
    if node.mem_capacity > 0:
        mem_util = float(mem_after) / float(node.mem_capacity)
    queue: float = cpu_util
    if mem_util > queue:
        queue = mem_util
    queue_penalty: float = queue * queue * 200.0
    headroom_penalty: float = 0.0
    if queue > 0.70:
        headroom_penalty = (queue - 0.70) * 800.0
    power: float = node.power_idle_w + (node.power_max_w - node.power_idle_w) * cpu_util
    power_penalty: float = power * 0.03
    lat: float = latency_penalty_idx(pod_idx, node, pods, graph)
    latency_penalty_val: float = lat * 8.0
    suspended_penalty: float = 0.0
    if node.suspended:
        suspended_penalty = 10000.0
    cost: float = power_penalty + queue_penalty + headroom_penalty + latency_penalty_val + suspended_penalty
    return -cost

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    pod_idx: int = find_pod_index(pod, ctx.pods)
    return node_score_idx(pod, pod_idx, node, ctx.pods, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    pod_count: int = len(state.pods)
    node_count: int = len(state.nodes)
    moves: int = 0
    for p_idx in range(pod_count):
        if moves < budget:
            pod: Pod = state.pods[p_idx]
            cur: int = pod.current_node
            if cur >= 0 and cur < node_count:
                cur_node: NodeState = state.nodes[cur]
                cur_score: float = node_score_idx(pod, p_idx, cur_node, state.pods, graph)
                best_idx: int = cur
                best_score: float = cur_score
                for n_idx in range(node_count):
                    node: NodeState = state.nodes[n_idx]
                    fits = n_idx != cur and node.cpu_allocated + pod.cpu_request <= node.cpu_capacity and node.mem_allocated + pod.mem_request <= node.mem_capacity
                    if fits and not node.suspended:
                        cpu_after: int = node.cpu_allocated + pod.cpu_request
                        mem_after: int = node.mem_allocated + pod.mem_request
                        cpu_util: float = 0.0
                        if node.cpu_capacity > 0:
                            cpu_util = float(cpu_after) / float(node.cpu_capacity)
                        mem_util: float = 0.0
                        if node.mem_capacity > 0:
                            mem_util = float(mem_after) / float(node.mem_capacity)
                        queue: float = cpu_util
                        if mem_util > queue:
                            queue = mem_util
                        if queue < 0.80:
                            cand: float = node_score_idx(pod, p_idx, node, state.pods, graph)
                            if cand > best_score:
                                best_score = cand
                                best_idx = n_idx
                threshold: float = 15.0
                if pod.stateful or pod.has_pdb:
                    threshold = 40.0
                cur_cpu_util: float = 0.0
                if cur_node.cpu_capacity > 0:
                    cur_cpu_util = float(cur_node.cpu_allocated) / float(cur_node.cpu_capacity)
                cur_mem_util: float = 0.0
                if cur_node.mem_capacity > 0:
                    cur_mem_util = float(cur_node.mem_allocated) / float(cur_node.mem_capacity)
                cur_queue: float = cur_cpu_util
                if cur_mem_util > cur_queue:
                    cur_queue = cur_mem_util
                if cur_queue > 0.85:
                    threshold = threshold * 0.25
                if cur_queue < 0.60:
                    threshold = threshold * 2.0
                if best_idx != cur and best_score > cur_score + threshold:
                    out.append(move_pod(pod.id, best_idx))
                    moves = moves + 1
    return out
# EVOLVE-BLOCK-END
