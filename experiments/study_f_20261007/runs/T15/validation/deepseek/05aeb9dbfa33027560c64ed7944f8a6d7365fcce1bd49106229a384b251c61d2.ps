# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    if node.suspended:
        total += 1000000.0
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_slack = node.cpu_capacity - cpu_after
    mem_slack = node.mem_capacity - mem_after
    if cpu_slack < 0:
        total += 1000000.0
    elif cpu_slack < 512:
        total += float(512 - cpu_slack) * 0.02
    if mem_slack < 0:
        total += 1000000.0
    elif mem_slack < 512:
        total += float(512 - mem_slack) * 0.01
    total += node.power_idle_w * 0.00002
    total += node.power_max_w * 0.00002
    m = len(ctx.graph.src)
    for e in range(m):
        s = ctx.graph.src[e]
        d = ctx.graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                total += rate * latency
    return -total

def already_moved(moved_ids: list[int], pid: int) -> bool:
    found = False
    for i in range(len(moved_ids)):
        if moved_ids[i] == pid:
            found = True
    return found

def node_pod_count(state: ClusterState, node_id: int) -> int:
    count = 0
    for i in range(len(state.pods)):
        if state.pods[i].current_node == node_id:
            count += 1
    return count

def fits(node: NodeState, pod: Pod) -> bool:
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    cpu_ok = cpu_after <= node.cpu_capacity
    mem_ok = mem_after <= node.mem_capacity
    return cpu_ok and mem_ok

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved_ids: list[int] = []
    moved = 0
    m = len(graph.src)
    for e in range(m):
        if moved >= budget:
            return out
        rate = graph.rate[e]
        if rate > 2.0:
            sp = state.pods[graph.src[e]]
            dp = state.pods[graph.dst[e]]
            placed = sp.current_node >= 0 and dp.current_node >= 0
            different = sp.current_node != dp.current_node
            sp_movable = not sp.stateful and not sp.has_pdb
            sp_new = not already_moved(moved_ids, sp.id)
            if placed and different and sp_movable and sp_new:
                src_count = node_pod_count(state, sp.current_node)
                if src_count <= 1:
                    dest = state.nodes[dp.current_node]
                    if fits(dest, sp) and not dest.suspended:
                        out.append(move_pod(sp.id, dp.current_node))
                        moved_ids.append(sp.id)
                        moved += 1
    for e in range(m):
        if moved >= budget:
            return out
        rate = graph.rate[e]
        if rate > 1.0:
            sp = state.pods[graph.src[e]]
            dp = state.pods[graph.dst[e]]
            placed = sp.current_node >= 0 and dp.current_node >= 0
            different = sp.current_node != dp.current_node
            sp_moved = already_moved(moved_ids, sp.id)
            dp_moved = already_moved(moved_ids, dp.id)
            edge_free = not sp_moved and not dp_moved
            if placed and different and edge_free:
                sp_movable = not sp.stateful and not sp.has_pdb
                sp_moved_now = False
                if sp_movable:
                    dest = state.nodes[dp.current_node]
                    if fits(dest, sp) and not dest.suspended:
                        out.append(move_pod(sp.id, dp.current_node))
                        moved_ids.append(sp.id)
                        moved += 1
                        sp_moved_now = True
                if moved < budget and not sp_moved_now:
                    dp_movable = not dp.stateful and not dp.has_pdb
                    if dp_movable:
                        dest = state.nodes[sp.current_node]
                        if fits(dest, dp) and not dest.suspended:
                            out.append(move_pod(dp.id, sp.current_node))
                            moved_ids.append(dp.id)
                            moved += 1
    return out
# EVOLVE-BLOCK-END
