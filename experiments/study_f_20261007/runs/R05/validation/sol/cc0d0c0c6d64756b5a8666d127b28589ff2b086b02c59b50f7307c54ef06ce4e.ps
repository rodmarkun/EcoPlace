# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000000.0

    cpu_allocated = node.cpu_allocated
    mem_allocated = node.mem_allocated
    if pod.current_node == node.id:
        cpu_allocated = max(cpu_allocated - pod.cpu_request, 0)
        mem_allocated = max(mem_allocated - pod.mem_request, 0)

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000000.0

    total_latency = 0.0
    weighted_latency = 0.0
    total_rate = 0.0
    longest_latency = 0.0
    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        incoming = False
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source
            incoming = True
        if other >= 0 and other != pod.id and ctx.graph.rate[edge] > 0.0:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                latency = node.latency_to_ms[neighbor.current_node]
                if incoming:
                    latency = ctx.nodes[neighbor.current_node].latency_to_ms[node.id]
                rate = ctx.graph.rate[edge]
                total_latency = total_latency + latency
                weighted_latency = weighted_latency + rate * latency
                total_rate = total_rate + rate
                longest_latency = max(longest_latency, latency)

    mean_latency = 0.0
    if total_rate > 0.0:
        mean_latency = weighted_latency / total_rate

    # Preserve graph locality while protecting busy links and long path segments.
    network_cost = total_latency + mean_latency * 0.25
    network_cost = network_cost + longest_latency * 0.50

    # Increasing marginal contention cost discourages consolidation near saturation.
    headroom = max(1.0 - peak, 0.02)
    queue_cost = 6.0 * peak * peak / headroom
    excess = max(peak - 0.65, 0.0)
    queue_cost = queue_cost + 12.0 * excess / headroom

    dynamic_w = max(node.power_max_w - node.power_idle_w, 0.0)
    incremental_w = dynamic_w * float(pod.cpu_request) / cpu_cap
    if node.suspendable and cpu_allocated == 0 and mem_allocated == 0:
        incremental_w = incremental_w + node.power_idle_w

    # Energy is a modest preference after locality and contention protection.
    cost = network_cost + queue_cost + incremental_w * 0.025
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # Remaining cumulative disruption allowances are not exposed. Placement can
    # improve energy without consuming migration, transfer, or outage allowances.
    return out
# EVOLVE-BLOCK-END
