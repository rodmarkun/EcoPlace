# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def latency_sum_for(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    total = 0.0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                total += node.latency_to_ms[neighbor.current_node]
    return total

def find_best_target(pod: Pod, state: ClusterState, graph: CallGraphCtx, current_lat: float, source_util: int) -> int:
    best_target = -1
    best_score = -1.0
    for i in range(len(state.nodes)):
        node = state.nodes[i]
        if i != pod.current_node and not node.suspended:
            if node.cpu_allocated + pod.cpu_request <= node.cpu_capacity and node.mem_allocated + pod.mem_request <= node.mem_capacity:
                target_lat = latency_sum_for(pod, node, state.pods, graph)
                target_util = node.cpu_allocated + node.mem_allocated
                lat_better = target_lat < current_lat * 0.9
                util_better = target_util > source_util
                if target_lat <= current_lat * 1.15 and (lat_better or util_better):
                    target_score = float(target_util) * 0.5 - target_lat * 3.0
                    if target_score > best_score:
                        best_score = target_score
                        best_target = i
    return best_target

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    lat = latency_sum_for(pod, node, ctx.pods, ctx.graph)
    cpu_free = resource_score(node.cpu_allocated + pod.cpu_request, node.cpu_capacity)
    mem_free = resource_score(node.mem_allocated + pod.mem_request, node.mem_capacity)
    headroom = float((cpu_free + mem_free) // 2)
    packing = 0.0
    if node.cpu_allocated > 0:
        packing = 10.0
    suspend_penalty = 0.0
    if node.suspended:
        suspend_penalty = 100.0
    return -lat * 4.0 + headroom * 0.5 + packing - suspend_penalty

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    for pod in state.pods:
        if len(out) >= budget:
            return out
        if pod.current_node >= 0 and not pod.stateful and not pod.has_pdb:
            source = state.nodes[pod.current_node]
            if source.suspendable and not source.suspended:
                current_lat = latency_sum_for(pod, source, state.pods, graph)
                source_util = source.cpu_allocated + source.mem_allocated
                best_target = find_best_target(pod, state, graph, current_lat, source_util)
                if best_target >= 0:
                    out.append(move_pod(pod.id, best_target))
    return out
# EVOLVE-BLOCK-END
