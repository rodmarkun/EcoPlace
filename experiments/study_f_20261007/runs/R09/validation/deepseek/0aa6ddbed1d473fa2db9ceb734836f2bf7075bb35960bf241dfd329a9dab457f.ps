# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def contains(ids: list[int], target: int) -> bool:
    for i in range(len(ids)):
        if ids[i] == target:
            return True
    return False

def headroom_ok(node: NodeState, pod: Pod) -> bool:
    if node.suspended:
        return False
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    return peak < 0.70

def latency_cost(pod: Pod, node_idx: int, state: ClusterState, graph: CallGraphCtx) -> float:
    total = 0.0
    edges = len(graph.src)
    for e in range(edges):
        s = graph.src[e]
        d = graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = state.pods[other]
            if neighbor.current_node >= 0:
                rate = graph.rate[e]
                lat = state.nodes[node_idx].latency_to_ms[neighbor.current_node]
                total = total + rate * lat
    return total

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    headroom = 1.0 - peak

    queue = 1.0
    if peak > 0.7:
        queue = 1.0 - (peak - 0.7) * 2.0
        if queue < 0.0:
            queue = 0.0

    weighted = 0.0
    weight = 0.0
    max_latency = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        s = ctx.graph.src[e]
        d = ctx.graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                lat = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * lat
                weight = weight + rate
                if lat > max_latency:
                    max_latency = lat

    proximity = 0.5
    if weight > 0.0:
        mean = weighted / weight
        scaled = mean / 45.0
        proximity = 1.0 - min(scaled, 1.0)

    worst = 0.5
    if max_latency > 0.0:
        scaled_worst = max_latency / 100.0
        worst = 1.0 - min(scaled_worst, 1.0)

    proximity_total = proximity * 0.7 + worst * 0.3

    idle = node.power_idle_w
    maxw = node.power_max_w
    power = idle + (maxw - idle) * peak
    efficiency = 1.0 - min(power / 150.0, 1.0)

    util = headroom * 0.45 + proximity_total * 0.35 + efficiency * 0.15 + queue * 0.05
    return util

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    moved_ids: list[int] = []
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            return out
        rate = graph.rate[e]
        if rate > 1.0:
            sp = state.pods[graph.src[e]]
            dp = state.pods[graph.dst[e]]
            placed = sp.current_node >= 0 and dp.current_node >= 0
            if placed and sp.current_node != dp.current_node:
                target_dp = state.nodes[dp.current_node]
                target_sp = state.nodes[sp.current_node]
                sp_movable = not sp.stateful and not sp.has_pdb and not contains(moved_ids, sp.id)
                dp_movable = not dp.stateful and not dp.has_pdb and not contains(moved_ids, dp.id)
                sp_ok = sp_movable and headroom_ok(target_dp, sp)
                dp_ok = dp_movable and headroom_ok(target_sp, dp)
                if sp_ok and dp_ok and target_dp.power_idle_w < target_sp.power_idle_w:
                    cur_cost = latency_cost(sp, sp.current_node, state, graph)
                    new_cost = latency_cost(sp, dp.current_node, state, graph)
                    if new_cost <= cur_cost * 1.10:
                        out.append(move_pod(sp.id, dp.current_node))
                        moved_ids.append(sp.id)
                        moved = moved + 1
                elif sp_ok and dp_ok and target_sp.power_idle_w < target_dp.power_idle_w:
                    cur_cost = latency_cost(dp, dp.current_node, state, graph)
                    new_cost = latency_cost(dp, sp.current_node, state, graph)
                    if new_cost <= cur_cost * 1.10:
                        out.append(move_pod(dp.id, sp.current_node))
                        moved_ids.append(dp.id)
                        moved = moved + 1
                elif sp_ok and dp_ok:
                    if sp.image_mb <= dp.image_mb:
                        cur_cost = latency_cost(sp, sp.current_node, state, graph)
                        new_cost = latency_cost(sp, dp.current_node, state, graph)
                        if new_cost <= cur_cost * 1.10:
                            out.append(move_pod(sp.id, dp.current_node))
                            moved_ids.append(sp.id)
                            moved = moved + 1
                    else:
                        cur_cost = latency_cost(dp, dp.current_node, state, graph)
                        new_cost = latency_cost(dp, sp.current_node, state, graph)
                        if new_cost <= cur_cost * 1.10:
                            out.append(move_pod(dp.id, sp.current_node))
                            moved_ids.append(dp.id)
                            moved = moved + 1
                elif sp_ok and target_dp.power_idle_w < target_sp.power_idle_w:
                    cur_cost = latency_cost(sp, sp.current_node, state, graph)
                    new_cost = latency_cost(sp, dp.current_node, state, graph)
                    if new_cost <= cur_cost * 1.10:
                        out.append(move_pod(sp.id, dp.current_node))
                        moved_ids.append(sp.id)
                        moved = moved + 1
                elif dp_ok and target_sp.power_idle_w < target_dp.power_idle_w:
                    cur_cost = latency_cost(dp, dp.current_node, state, graph)
                    new_cost = latency_cost(dp, sp.current_node, state, graph)
                    if new_cost <= cur_cost * 1.10:
                        out.append(move_pod(dp.id, sp.current_node))
                        moved_ids.append(dp.id)
                        moved = moved + 1
    return out
# EVOLVE-BLOCK-END
