# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 40.0
    return 1.0 - min(scaled, 1.0)

def peak_after(node: NodeState, pod: Pod) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after)

def fits_with_margin(node: NodeState, pod: Pod, limit: float) -> bool:
    if node.suspended:
        return False
    peak = peak_after(node, pod)
    return peak <= limit

def move_benefit(state: ClusterState, pod: Pod, to_node: int, rate: float) -> float:
    if pod.current_node < 0 or to_node < 0 or pod.current_node == to_node:
        return 0.0
    if pod.stateful or pod.has_pdb:
        return 0.0
    target = state.nodes[to_node]
    if target.suspended:
        return 0.0
    target_peak = peak_after(target, pod)
    if target_peak > 0.60:
        return 0.0
    from_node = state.nodes[pod.current_node]
    current_latency = from_node.latency_to_ms[to_node]
    if current_latency <= 0.0:
        return 0.0
    benefit = rate * current_latency

    cpu_cap_from = float(max(from_node.cpu_capacity, 1))
    mem_cap_from = float(max(from_node.mem_capacity, 1))
    source_cpu_after = float(max(from_node.cpu_allocated - pod.cpu_request, 0)) / cpu_cap_from
    source_mem_after = float(max(from_node.mem_allocated - pod.mem_request, 0)) / mem_cap_from
    source_peak_after = max(source_cpu_after, source_mem_after)
    source_peak_before = max(float(from_node.cpu_allocated) / cpu_cap_from, float(from_node.mem_allocated) / mem_cap_from)

    if source_peak_before > 0.70:
        benefit = benefit * (1.0 + (source_peak_before - 0.70) * 3.0)
    if target_peak < source_peak_after:
        benefit = benefit * (1.0 + (source_peak_after - target_peak) * 2.5)
    else:
        benefit = benefit * max(0.5, 1.0 - (target_peak - source_peak_after) * 2.0)

    if target.tier != from_node.tier:
        benefit = benefit * 0.70
    if target.power_idle_w < from_node.power_idle_w:
        benefit = benefit * 1.15
    if target.power_max_w < from_node.power_max_w:
        benefit = benefit * 1.15
    return benefit

def was_moved(moved_ids: list[int], pod_id: int) -> bool:
    found = False
    for i in range(len(moved_ids)):
        if moved_ids[i] == pod_id:
            found = True
    return found

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    peak = peak_after(node, pod)
    if peak > 1.0:
        return -1000000.0

    headroom = 1.0 - peak
    headroom2 = headroom * headroom
    queue_penalty = 1.0 - min(max(peak - 0.55, 0.0) * 4.5, 1.0)
    burst_penalty = 1.0 - min(max(peak - 0.70, 0.0) * 5.0, 1.0)

    weighted = 0.0
    weight = 0.0
    worst = 0.0
    tier_mismatch = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * latency
                weight = weight + rate
                term = rate * latency
                if term > worst:
                    worst = term
                if ctx.nodes[neighbor.current_node].tier != node.tier:
                    tier_mismatch = tier_mismatch + rate

    proximity = 0.5
    worst_prox = 0.5
    if weight > 0.0:
        proximity = proximity_of(weighted / weight)
        worst_prox = 1.0 - min(worst / 120.0, 1.0)

    tier_penalty = 1.0 - min(tier_mismatch / (weight + 1.0), 1.0)

    power_est = node.power_idle_w + (node.power_max_w - node.power_idle_w) * peak
    efficiency = 1.0 - min(power_est / 160.0, 1.0)

    return headroom2 * 0.20 * burst_penalty + queue_penalty * 0.20 + proximity * 0.30 * tier_penalty + worst_prox * 0.20 + efficiency * 0.10

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved_ids: list[int] = []
    moved = 0
    edges = len(graph.src)

    for e in range(edges):
        if moved < budget:
            source_pod = state.pods[graph.src[e]]
            destination_pod = state.pods[graph.dst[e]]
            involved = was_moved(moved_ids, source_pod.id) or was_moved(moved_ids, destination_pod.id)
            if not involved:
                rate = graph.rate[e]
                benefit_source = move_benefit(state, source_pod, destination_pod.current_node, rate)
                benefit_dest = move_benefit(state, destination_pod, source_pod.current_node, rate)
                if benefit_source > 45.0 and benefit_source >= benefit_dest:
                    out.append(move_pod(source_pod.id, destination_pod.current_node))
                    moved_ids.append(source_pod.id)
                    moved_ids.append(destination_pod.id)
                    moved = moved + 1
                elif benefit_dest > 45.0:
                    out.append(move_pod(destination_pod.id, source_pod.current_node))
                    moved_ids.append(source_pod.id)
                    moved_ids.append(destination_pod.id)
                    moved = moved + 1

    for e in range(edges):
        if moved < budget:
            source_pod = state.pods[graph.src[e]]
            destination_pod = state.pods[graph.dst[e]]
            involved = was_moved(moved_ids, source_pod.id) or was_moved(moved_ids, destination_pod.id)
            if not involved:
                rate = graph.rate[e]
                benefit_source = move_benefit(state, source_pod, destination_pod.current_node, rate)
                benefit_dest = move_benefit(state, destination_pod, source_pod.current_node, rate)
                if benefit_source > 18.0 and benefit_source >= benefit_dest:
                    out.append(move_pod(source_pod.id, destination_pod.current_node))
                    moved_ids.append(source_pod.id)
                    moved_ids.append(destination_pod.id)
                    moved = moved + 1
                elif benefit_dest > 18.0:
                    out.append(move_pod(destination_pod.id, source_pod.current_node))
                    moved_ids.append(source_pod.id)
                    moved_ids.append(destination_pod.id)
                    moved = moved + 1

    return out
# EVOLVE-BLOCK-END
