# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def queue_pressure(peak: float) -> float:
    return peak / max(1.0 - peak, 0.01)

def allocated_peak(node: NodeState) -> float:
    cpu = float(node.cpu_allocated) / float(max(node.cpu_capacity, 1))
    mem = float(node.mem_allocated) / float(max(node.mem_capacity, 1))
    return max(cpu, mem)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak >= 1.0:
        return -1000000.0

    pressure = queue_pressure(peak)
    old_pressure = queue_pressure(allocated_peak(node))
    shared_increase = 0.0
    weighted_latency = 0.0
    weighted_transport = 0.0
    weighted_coupling = 0.0
    total_rate = 0.0
    incoming_tail = 0.0
    outgoing_tail = 0.0

    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source

        if other >= 0 and other != pod.id:
            location = ctx.pods[other].current_node
            rate = ctx.graph.rate[e]
            if location >= 0 and rate > 0.0:
                latency = node.latency_to_ms[location]
                if source != pod.id:
                    latency = ctx.nodes[location].latency_to_ms[node.id]
                peer_pressure = queue_pressure(allocated_peak(ctx.nodes[location]))
                if location == node.id:
                    latency = 0.0
                    peer_pressure = pressure
                    shared_increase = max(pressure - old_pressure, 0.0)
                latency = max(latency, 0.0)

                if source == pod.id:
                    outgoing_tail = max(outgoing_tail, latency)
                else:
                    incoming_tail = max(incoming_tail, latency)

                payload = max(ctx.graph.payload_kb[e], 0.0)
                weighted_latency = weighted_latency + rate * latency
                weighted_transport = weighted_transport + rate * payload * latency
                weighted_coupling = weighted_coupling + rate * latency * (pressure + peer_pressure)
                total_rate = total_rate + rate

    mean_latency = 22.5
    mean_transport = 0.0
    mean_coupling = mean_latency * pressure
    if total_rate > 0.0:
        mean_latency = weighted_latency / total_rate
        mean_transport = weighted_transport / total_rate
        mean_coupling = weighted_coupling / total_rate

    # Reserve capacity for bursts; saturation has an unbounded cost.
    reserve_excess = max(peak - 0.60, 0.0)
    reserve_penalty = reserve_excess * 14.0
    reserve_penalty = reserve_penalty + reserve_excess * reserve_excess * 40.0

    # A request through this pod can pay both incoming and outgoing latency.
    path_latency = incoming_tail + outgoing_tail
    path_excess = max(path_latency / 90.0 - 1.0, 0.0)
    latency_cost = mean_latency / 45.0 + path_latency / 90.0
    latency_cost = latency_cost + path_excess * path_excess
    coupling_cost = mean_coupling / 450.0
    transport_cost = mean_transport / 45000.0

    # Prefer economical consolidation only within the headroom and path margin.
    power_span = max(node.power_max_w - node.power_idle_w, 0.0)
    incremental_power = power_span * float(pod.cpu_request) / cpu_cap
    if node.cpu_allocated == 0 and node.mem_allocated == 0:
        incremental_power = incremental_power + node.power_idle_w
    energy_cost = max(incremental_power, 0.0) / 120.0
    energy_preference = energy_cost / (1.0 + energy_cost)

    cost = pressure * 0.50 + reserve_penalty
    cost = cost + latency_cost * 0.80 + coupling_cost
    cost = cost + shared_increase * 0.20
    cost = cost + transport_cost * 0.05 + energy_preference * 0.15
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # A per-window limit cannot enforce cumulative disruption constraints.
    # Without cumulative counters, preserve serving capacity and add no moves.
    return out
# EVOLVE-BLOCK-END
