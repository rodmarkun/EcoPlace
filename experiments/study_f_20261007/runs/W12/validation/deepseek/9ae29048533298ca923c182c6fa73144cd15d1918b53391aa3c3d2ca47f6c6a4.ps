# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 25.0
    return 1.0 - min(scaled, 1.0)

def compute_score(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    headroom = 1.0 - peak
    burst = headroom * headroom

    weighted = 0.0
    weight = 0.0
    max_lat = 0.0
    edges = len(graph.src)
    for e in range(edges):
        source = graph.src[e]
        destination = graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                rate = graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * latency
                weight = weight + rate
                if latency > max_lat:
                    max_lat = latency

    proximity = 0.5
    if weight > 0.0:
        mean_latency = weighted / weight
        mean_prox = proximity_of(mean_latency)
        max_prox = 1.0 - min(max_lat / 25.0, 1.0)
        proximity = mean_prox * 0.30 + max_prox * 0.70

    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)
    return burst * 0.55 + proximity * 0.40 + efficiency * 0.05

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return compute_score(pod, node, ctx.pods, ctx.graph)

def find_best_target(pod: Pod, state: ClusterState, graph: CallGraphCtx) -> int:
    best_target = -1
    best_score = -1000000.0
    for n_idx in range(len(state.nodes)):
        node = state.nodes[n_idx]
        if n_idx != pod.current_node and not node.suspended:
            cpu_after = float(node.cpu_allocated + pod.cpu_request) / float(max(node.cpu_capacity, 1))
            mem_after = float(node.mem_allocated + pod.mem_request) / float(max(node.mem_capacity, 1))
            peak = max(cpu_after, mem_after)
            if peak < 0.80:
                s = compute_score(pod, node, state.pods, graph)
                if s > best_score:
                    best_score = s
                    best_target = n_idx
    return best_target

def can_place(pod: Pod, target_node: NodeState, state: ClusterState, moved_pods: list[int], moved_targets: list[int], target_idx: int) -> bool:
    already_moved = False
    for i in range(len(moved_pods)):
        if moved_pods[i] == pod.id:
            already_moved = True
    if already_moved:
        return False
    cpu_used = float(target_node.cpu_allocated + pod.cpu_request)
    mem_used = float(target_node.mem_allocated + pod.mem_request)
    for i in range(len(moved_pods)):
        if moved_targets[i] == target_idx:
            p = state.pods[moved_pods[i]]
            cpu_used = cpu_used + float(p.cpu_request)
            mem_used = mem_used + float(p.mem_request)
    cpu_cap = float(max(target_node.cpu_capacity, 1))
    mem_cap = float(max(target_node.mem_capacity, 1))
    cpu_after = cpu_used / cpu_cap
    mem_after = mem_used / mem_cap
    peak = max(cpu_after, mem_after)
    if peak < 0.75:
        return True
    return False

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    moved_pods: list[int] = []
    moved_targets: list[int] = []
    edges = len(graph.src)
    for e in range(edges):
        if moved < budget:
            source_pod = state.pods[graph.src[e]]
            destination_pod = state.pods[graph.dst[e]]
            if source_pod.current_node >= 0 and destination_pod.current_node >= 0 and source_pod.current_node != destination_pod.current_node:
                if not source_pod.stateful and not source_pod.has_pdb:
                    target_node_idx = destination_pod.current_node
                    target_node = state.nodes[target_node_idx]
                    source_node = state.nodes[source_pod.current_node]
                    current_latency = source_node.latency_to_ms[target_node_idx]
                    if current_latency > 4.0 and not target_node.suspended:
                        if can_place(source_pod, target_node, state, moved_pods, moved_targets, target_node_idx):
                            out.append(move_pod(source_pod.id, target_node_idx))
                            moved = moved + 1
                            moved_pods.append(source_pod.id)
                            moved_targets.append(target_node_idx)
            if moved < budget:
                if source_pod.current_node >= 0 and destination_pod.current_node >= 0 and source_pod.current_node != destination_pod.current_node:
                    if not destination_pod.stateful and not destination_pod.has_pdb:
                        target_node_idx = source_pod.current_node
                        target_node = state.nodes[target_node_idx]
                        destination_node = state.nodes[destination_pod.current_node]
                        current_latency = destination_node.latency_to_ms[target_node_idx]
                        if current_latency > 4.0 and not target_node.suspended:
                            if can_place(destination_pod, target_node, state, moved_pods, moved_targets, target_node_idx):
                                out.append(move_pod(destination_pod.id, target_node_idx))
                                moved = moved + 1
                                moved_pods.append(destination_pod.id)
                                moved_targets.append(target_node_idx)
    if moved < budget:
        for p_idx in range(len(state.pods)):
            if moved < budget:
                pod = state.pods[p_idx]
                if pod.current_node >= 0 and not pod.stateful and not pod.has_pdb:
                    current_node = state.nodes[pod.current_node]
                    cpu_alloc = float(current_node.cpu_allocated)
                    cpu_cap = float(max(current_node.cpu_capacity, 1))
                    if current_node.suspendable and cpu_alloc < cpu_cap * 0.5:
                        best_target = find_best_target(pod, state, graph)
                        if best_target >= 0:
                            target_node = state.nodes[best_target]
                            if can_place(pod, target_node, state, moved_pods, moved_targets, best_target):
                                out.append(move_pod(pod.id, best_target))
                                moved = moved + 1
                                moved_pods.append(pod.id)
                                moved_targets.append(best_target)
    return out
# EVOLVE-BLOCK-END
