# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    weighted = 0.0
    weight = 0.0
    worst = 0.0
    for e in range(len(ctx.graph.src)):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor_index = ctx.pods[other].current_node
            if neighbor_index >= 0 and ctx.graph.rate[e] > 0.0:
                latency = node.latency_to_ms[neighbor_index]
                weighted = weighted + ctx.graph.rate[e] * latency
                weight = weight + ctx.graph.rate[e]
                worst = max(worst, latency)

    mean_latency = 22.5
    if weight > 0.0:
        mean_latency = weighted / weight

    dynamic = max(node.power_max_w - node.power_idle_w, 0.0)
    marginal_power = dynamic * float(pod.cpu_request) / cpu_cap
    if node.suspendable and node.cpu_allocated == 0 and node.mem_allocated == 0:
        marginal_power = marginal_power + node.power_idle_w

    excess = max(peak - 0.65, 0.0)
    congestion = 12.0 * peak + 30.0 * peak * peak
    congestion = congestion + 160.0 * excess * excess / max(1.0 - peak, 0.05)
    cost = congestion + 0.8 * mean_latency + 0.15 * worst
    cost = cost + 0.3 * marginal_power
    return -cost

def relocation_latency_safe(pod: Pod, target_index: int, state: ClusterState, graph: CallGraphCtx) -> bool:
    origin_index = pod.current_node
    if origin_index < 0:
        return False
    for e in range(len(graph.src)):
        other = -1
        if graph.src[e] == pod.id:
            other = graph.dst[e]
        if graph.dst[e] == pod.id:
            other = graph.src[e]
        if other >= 0 and other != pod.id and graph.rate[e] > 0.0:
            neighbor_node = state.pods[other].current_node
            if neighbor_node >= 0:
                before = state.nodes[origin_index].latency_to_ms[neighbor_node]
                after = state.nodes[target_index].latency_to_ms[neighbor_node]
                reverse_before = state.nodes[neighbor_node].latency_to_ms[origin_index]
                reverse_after = state.nodes[neighbor_node].latency_to_ms[target_index]
                if after > before or reverse_after > reverse_before:
                    return False
    return True

def relocation_saving(pod: Pod, target_index: int, state: ClusterState) -> float:
    origin_index = pod.current_node
    if origin_index < 0 or origin_index == target_index:
        return 0.0
    origin = state.nodes[origin_index]
    target = state.nodes[target_index]
    if target.suspended or not origin.suspendable:
        return 0.0
    if origin.cpu_allocated != pod.cpu_request or origin.mem_allocated != pod.mem_request:
        return 0.0

    residents = 0
    for i in range(len(state.pods)):
        if state.pods[i].current_node == origin_index:
            residents = residents + 1
    if residents != 1:
        return 0.0

    target_cpu_cap = float(max(target.cpu_capacity, 1))
    target_mem_cap = float(max(target.mem_capacity, 1))
    cpu_after = float(target.cpu_allocated + pod.cpu_request) / target_cpu_cap
    mem_after = float(target.mem_allocated + pod.mem_request) / target_mem_cap
    if max(cpu_after, mem_after) > 0.65:
        return 0.0

    origin_cpu_cap = float(max(origin.cpu_capacity, 1))
    origin_dynamic = max(origin.power_max_w - origin.power_idle_w, 0.0)
    target_dynamic = max(target.power_max_w - target.power_idle_w, 0.0)
    saved = origin.power_idle_w + origin_dynamic * float(pod.cpu_request) / origin_cpu_cap
    added = target_dynamic * float(pod.cpu_request) / target_cpu_cap
    if target.suspendable and target.cpu_allocated == 0 and target.mem_allocated == 0:
        added = added + target.power_idle_w
    return saved - added

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out

    best_pod = -1
    best_target = -1
    best_saving = 5.0
    for i in range(len(state.pods)):
        pod = state.pods[i]
        eligible = pod.current_node >= 0 and not pod.stateful and not pod.has_pdb
        if eligible:
            for target_index in range(len(state.nodes)):
                saving = relocation_saving(pod, target_index, state)
                if saving > best_saving:
                    latency_safe = relocation_latency_safe(pod, target_index, state, graph)
                    if latency_safe:
                        best_pod = pod.id
                        best_target = target_index
                        best_saving = saving

    # One move per window avoids stale allocations and limits disruption.
    if best_pod >= 0:
        out.append(move_pod(best_pod, best_target))
    return out
# EVOLVE-BLOCK-END
