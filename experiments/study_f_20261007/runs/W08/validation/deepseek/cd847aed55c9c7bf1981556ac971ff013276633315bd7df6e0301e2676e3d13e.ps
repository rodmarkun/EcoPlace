# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def node_power_with(node: NodeState, cpu_add: int, mem_add: int) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_util = float(node.cpu_allocated + cpu_add) / cpu_cap
    mem_util = float(node.mem_allocated + mem_add) / mem_cap
    util = max(cpu_util, mem_util)
    if util < 0.0:
        util = 0.0
    if util > 1.0:
        util = 1.0
    return node.power_idle_w + (node.power_max_w - node.power_idle_w) * util

def pods_on_node(state: ClusterState, node_id: int) -> int:
    count = 0
    n = len(state.pods)
    for i in range(n):
        p = state.pods[i]
        if p.current_node == node_id:
            count = count + 1
    return count

def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 40.0
    return 1.0 - min(scaled, 1.0)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0
    headroom = 1.0 - peak
    if peak > 0.92:
        return -100000.0 + headroom * 10.0
    if peak > 0.82:
        headroom = headroom * 0.6

    weighted = 0.0
    weight = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                weighted = weighted + rate * node.latency_to_ms[neighbor.current_node]
                weight = weight + rate

    proximity = 0.5
    if weight > 0.0:
        proximity = proximity_of(weighted / weight)

    power_est = node_power_with(node, pod.cpu_request, pod.mem_request)
    efficiency = 1.0 - min(power_est / 120.0, 1.0)
    return headroom * 0.52 + proximity * 0.40 + efficiency * 0.08

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            return out
        src_idx = graph.src[e]
        dst_idx = graph.dst[e]
        src_pod = state.pods[src_idx]
        dst_pod = state.pods[dst_idx]
        rate = graph.rate[e]

        if moved < budget and src_pod.current_node >= 0 and dst_pod.current_node >= 0 and src_pod.current_node != dst_pod.current_node and not src_pod.stateful and not src_pod.has_pdb:
            src_node = state.nodes[src_pod.current_node]
            dst_node = state.nodes[dst_pod.current_node]
            cpu_cap = float(max(dst_node.cpu_capacity, 1))
            mem_cap = float(max(dst_node.mem_capacity, 1))
            cpu_after = float(dst_node.cpu_allocated + src_pod.cpu_request) / cpu_cap
            mem_after = float(dst_node.mem_allocated + src_pod.mem_request) / mem_cap
            target_peak = max(cpu_after, mem_after)
            if not dst_node.suspended and target_peak < 0.80:
                src_power_before = node_power_with(src_node, 0, 0)
                src_power_after = node_power_with(src_node, -src_pod.cpu_request, -src_pod.mem_request)
                dst_power_before = node_power_with(dst_node, 0, 0)
                dst_power_after = node_power_with(dst_node, src_pod.cpu_request, src_pod.mem_request)
                energy_delta = dst_power_after - dst_power_before - (src_power_before - src_power_after)
                current_latency = src_node.latency_to_ms[dst_pod.current_node]
                latency_benefit = rate * current_latency
                beneficial = energy_delta < 0.0 or (latency_benefit > 30.0 and energy_delta < 2.0)
                if beneficial:
                    out.append(move_pod(src_pod.id, dst_pod.current_node))
                    moved = moved + 1

        if moved < budget and dst_pod.current_node >= 0 and src_pod.current_node >= 0 and dst_pod.current_node != src_pod.current_node and not dst_pod.stateful and not dst_pod.has_pdb:
            dst_node = state.nodes[dst_pod.current_node]
            src_node = state.nodes[src_pod.current_node]
            cpu_cap = float(max(src_node.cpu_capacity, 1))
            mem_cap = float(max(src_node.mem_capacity, 1))
            cpu_after = float(src_node.cpu_allocated + dst_pod.cpu_request) / cpu_cap
            mem_after = float(src_node.mem_allocated + dst_pod.mem_request) / mem_cap
            target_peak = max(cpu_after, mem_after)
            if not src_node.suspended and target_peak < 0.80:
                dst_power_before = node_power_with(dst_node, 0, 0)
                dst_power_after = node_power_with(dst_node, -dst_pod.cpu_request, -dst_pod.mem_request)
                src_power_before = node_power_with(src_node, 0, 0)
                src_power_after = node_power_with(src_node, dst_pod.cpu_request, dst_pod.mem_request)
                energy_delta = src_power_after - src_power_before - (dst_power_before - dst_power_after)
                current_latency = dst_node.latency_to_ms[src_pod.current_node]
                latency_benefit = rate * current_latency
                beneficial = energy_delta < 0.0 or (latency_benefit > 30.0 and energy_delta < 2.0)
                if beneficial:
                    out.append(move_pod(dst_pod.id, src_pod.current_node))
                    moved = moved + 1
    return out
# EVOLVE-BLOCK-END
