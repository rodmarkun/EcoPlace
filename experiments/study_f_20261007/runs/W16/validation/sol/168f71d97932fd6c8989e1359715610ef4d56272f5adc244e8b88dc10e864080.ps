# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_peak(node: NodeState, cpu: int, mem: int) -> float:
    cpu_fraction = float(cpu) / float(max(node.cpu_capacity, 1))
    mem_fraction = float(mem) / float(max(node.mem_capacity, 1))
    return max(cpu_fraction, mem_fraction)

def operating_cost(node: NodeState, cpu: int, mem: int) -> float:
    if cpu <= 0 and mem <= 0 and node.suspendable:
        return 0.0
    peak = resource_peak(node, cpu, mem)
    if peak >= 1.0:
        return 1000000.0
    cpu_fraction = float(cpu) / float(max(node.cpu_capacity, 1))
    dynamic = max(node.power_max_w - node.power_idle_w, 0.0)
    power = node.power_idle_w + dynamic * cpu_fraction
    queue_cost = peak * peak / max(1.0 - peak, 0.01)
    burst_cost = max(peak - 0.60, 0.0)
    return power / 120.0 + queue_cost * 1.5 + burst_cost * burst_cost * 80.0

def path_cost(pod: Pod, node: NodeState, graph: CallGraphCtx,
              placements: list[int], nodes: list[NodeState]) -> float:
    weighted = 0.0
    weight = 0.0
    worst = 0.0
    for e in range(len(graph.src)):
        source = graph.src[e]
        destination = graph.dst[e]
        other = -1
        outgoing = False
        if source == pod.id and destination != pod.id:
            other = destination
            outgoing = True
        elif destination == pod.id and source != pod.id:
            other = source
        if other >= 0 and placements[other] >= 0 and graph.rate[e] > 0.0:
            neighbor_node = placements[other]
            latency = nodes[neighbor_node].latency_to_ms[node.id]
            if outgoing:
                latency = node.latency_to_ms[neighbor_node]
            rate = graph.rate[e]
            weighted = weighted + rate * latency
            weight = weight + rate
            worst = max(worst, latency)
    if weight <= 0.0:
        return 0.0
    mean = weighted / weight
    return mean * 0.65 + worst * 0.35

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    peak = resource_peak(node, cpu_after, mem_after)
    if peak >= 1.0:
        return -1000000.0

    placements: list[int] = []
    for p in range(len(ctx.pods)):
        placements.append(ctx.pods[p].current_node)

    latency = path_cost(pod, node, ctx.graph, placements, ctx.nodes)
    before = operating_cost(node, node.cpu_allocated, node.mem_allocated)
    after = operating_cost(node, cpu_after, mem_after)
    cost = after - before + latency / 12.0
    if peak > 0.80:
        cost = cost + 100.0 + (peak - 0.80) * 1000.0
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out

    placements: list[int] = []
    for p in range(len(state.pods)):
        placements.append(state.pods[p].current_node)

    best_pod = -1
    best_target = -1
    best_gain = 0.50

    # A single strongly beneficial move limits disruption and avoids stale batches.
    for p in range(len(state.pods)):
        pod = state.pods[p]
        source_index = placements[p]
        eligible = source_index >= 0 and not pod.stateful and not pod.has_pdb
        if eligible:
            source = state.nodes[source_index]
            cpu_left = source.cpu_allocated - pod.cpu_request
            mem_left = source.mem_allocated - pod.mem_request
            accounted = cpu_left >= 0 and mem_left >= 0 and not source.suspended
            if accounted:
                source_before = operating_cost(source, source.cpu_allocated, source.mem_allocated)
                source_after = operating_cost(source, cpu_left, mem_left)
                latency_before = path_cost(pod, source, graph, placements, state.nodes)
                for n in range(len(state.nodes)):
                    target = state.nodes[n]
                    cpu_after = target.cpu_allocated + pod.cpu_request
                    mem_after = target.mem_allocated + pod.mem_request
                    fits = n != source_index and not target.suspended
                    fits = fits and resource_peak(target, cpu_after, mem_after) <= 0.65
                    if fits:
                        latency_after = path_cost(pod, target, graph, placements, state.nodes)
                        target_before = operating_cost(target, target.cpu_allocated, target.mem_allocated)
                        target_after = operating_cost(target, cpu_after, mem_after)
                        gain = source_before - source_after + target_before - target_after
                        gain = gain + (latency_before - latency_after) / 12.0
                        safe = latency_after <= latency_before and gain > best_gain
                        if safe:
                            best_gain = gain
                            best_pod = pod.id
                            best_target = n

    if best_pod >= 0:
        out.append(move_pod(best_pod, best_target))
    return out
# EVOLVE-BLOCK-END
