# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def contains_pod(ids: list[int], pid: int) -> bool:
    for i in range(len(ids)):
        if ids[i] == pid:
            return True
    return False

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    m = len(ctx.graph.src)
    for e in range(m):
        s = ctx.graph.src[e]
        d = ctx.graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                lat = node.latency_to_ms[neighbor.current_node]
                rate = ctx.graph.rate[e]
                total += rate * lat

    cpu_free = 0.0
    if node.cpu_capacity > 0:
        cpu_free = float(node.cpu_capacity - node.cpu_allocated - pod.cpu_request) / float(node.cpu_capacity)
    mem_free = 0.0
    if node.mem_capacity > 0:
        mem_free = float(node.mem_capacity - node.mem_allocated - pod.mem_request) / float(node.mem_capacity)
    headroom = cpu_free + mem_free

    power_ratio = 0.0
    if node.power_max_w > 0.0:
        power_ratio = node.power_idle_w / node.power_max_w

    return -total + headroom * 10.0 - power_ratio * 5.0

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    moved_ids: list[int] = []
    m = len(graph.src)
    for phase in range(2):
        threshold = 1.0
        if phase == 1:
            threshold = 0.0
        for e in range(m):
            eligible = moved < budget and graph.rate[e] > threshold
            if eligible:
                sp = state.pods[graph.src[e]]
                dp = state.pods[graph.dst[e]]
                placed = sp.current_node >= 0 and dp.current_node >= 0
                apart = placed and sp.current_node != dp.current_node
                sp_ok = apart and not sp.stateful and not sp.has_pdb
                sp_new = sp_ok and not contains_pod(moved_ids, sp.id)
                if sp_new:
                    dest = state.nodes[dp.current_node]
                    fits_cpu = dest.cpu_allocated + sp.cpu_request <= dest.cpu_capacity
                    fits_mem = dest.mem_allocated + sp.mem_request <= dest.mem_capacity
                    if fits_cpu and fits_mem and not dest.suspended:
                        out.append(move_pod(sp.id, dp.current_node))
                        moved_ids.append(sp.id)
                        moved += 1
                dp_ok = apart and not dp.stateful and not dp.has_pdb
                dp_new = dp_ok and not contains_pod(moved_ids, dp.id)
                if dp_new and moved < budget:
                    dest2 = state.nodes[sp.current_node]
                    fits_cpu2 = dest2.cpu_allocated + dp.cpu_request <= dest2.cpu_capacity
                    fits_mem2 = dest2.mem_allocated + dp.mem_request <= dest2.mem_capacity
                    if fits_cpu2 and fits_mem2 and not dest2.suspended:
                        out.append(move_pod(dp.id, sp.current_node))
                        moved_ids.append(dp.id)
                        moved += 1
    return out
# EVOLVE-BLOCK-END
