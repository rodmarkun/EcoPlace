# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def resource_score(requested: int, capacity: int) -> int:
    if capacity <= 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def peer_pressure(node: NodeState) -> float:
    if node.cpu_capacity <= 0:
        return 50.0
    utilization = float(node.cpu_allocated) / float(node.cpu_capacity)
    return utilization / max(1.0 - utilization, 0.02)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return -1000000000.0

    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    if cpu_after > node.cpu_capacity or mem_after > node.mem_capacity:
        return -1000000000.0

    cpu_headroom = resource_score(cpu_after, node.cpu_capacity)
    mem_headroom = resource_score(mem_after, node.mem_capacity)
    cpu_util = float(cpu_after) / float(node.cpu_capacity)
    mem_util = float(mem_after) / float(node.mem_capacity)
    cpu_before = float(node.cpu_allocated) / float(node.cpu_capacity)
    request_util = float(pod.cpu_request) / float(node.cpu_capacity)
    cpu_free = max(1.0 - cpu_util, 0.02)
    mem_free = max(1.0 - mem_util, 0.02)
    free_before = max(1.0 - cpu_before, 0.02)

    pressure = cpu_util / cpu_free
    pressure_before = cpu_before / free_before
    pressure_increase = max(pressure - pressure_before, 0.0)
    queue_cost = (24.0 * cpu_util + 48.0 * request_util) / cpu_free
    queue_cost = queue_cost + 16.0 * pressure_increase
    memory_cost = 3.0 * mem_util / mem_free

    cpu_excess = max(cpu_util - 0.68, 0.0)
    mem_excess = max(mem_util - 0.85, 0.0)
    burst_cost = 180.0 * cpu_excess * cpu_excess / cpu_free
    burst_cost = burst_cost + 60.0 * mem_excess * mem_excess / mem_free
    headroom_cost = float(200 - cpu_headroom - mem_headroom) * 0.04

    latency_sum: float = 0.0
    latency_peak: float = 0.0
    edge_count: float = 0.0
    for e in range(len(ctx.graph.src)):
        source = ctx.pods[ctx.graph.src[e]]
        destination = ctx.pods[ctx.graph.dst[e]]
        peer_index: int = -1
        incoming: bool = False
        if source.service == pod.service and source.app == pod.app:
            peer_index = destination.current_node
        elif destination.service == pod.service and destination.app == pod.app:
            peer_index = source.current_node
            incoming = True

        if peer_index >= 0 and peer_index < len(node.latency_to_ms):
            latency = node.latency_to_ms[peer_index]
            peer_load: float = 0.0
            if peer_index < len(ctx.nodes):
                peer_load = peer_pressure(ctx.nodes[peer_index])
            adjusted_latency = latency * (1.0 + 0.25 * peer_load)
            latency_sum = latency_sum + adjusted_latency
            latency_peak = max(latency_peak, adjusted_latency)
            edge_count = edge_count + 1.0
            if incoming:
                queue_cost = queue_cost + 4.0 * request_util / cpu_free

    latency_mean = latency_sum / max(edge_count, 1.0)
    communication_cost = 16.0 * latency_peak + 4.0 * latency_mean
    communication_cost = communication_cost + 2.0 * latency_sum
    pressure_cost = communication_cost * pressure

    power_span = max(node.power_max_w - node.power_idle_w, 0.0)
    marginal_power = power_span * request_util
    empty = node.cpu_allocated == 0 and node.mem_allocated == 0
    if empty and (node.suspendable or node.suspended):
        marginal_power = marginal_power + node.power_idle_w

    wake_cost: float = 0.0
    if node.suspended:
        wake_cost = 25.0

    safety_cost = communication_cost + pressure_cost + queue_cost
    safety_cost = safety_cost + memory_cost + burst_cost + headroom_cost
    safety_cost = safety_cost + wake_cost
    energy_weight = 0.10 / (1.0 + cpu_excess / cpu_free + mem_excess / mem_free)
    cost = safety_cost + energy_weight * marginal_power
    return -cost

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    # Cumulative disruption usage and application SLO slack are unavailable.
    # Preserve serving capacity and cumulative disruption headroom.
    return out
# EVOLVE-BLOCK-END
