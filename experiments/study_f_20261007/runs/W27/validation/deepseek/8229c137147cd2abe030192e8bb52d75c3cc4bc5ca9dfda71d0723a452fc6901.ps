# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 15.0
    return 1.0 - min(scaled, 1.0)

def tail_of(max_latency_ms: float) -> float:
    scaled = max_latency_ms / 30.0
    return 1.0 - min(scaled, 1.0)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    # Headroom on the bottleneck resource: the queueing term.  Contention, not
    # capacity admission, is what breaks the SLO here, so the *margin* is what
    # matters.  Cubic emphasis keeps near-saturation placements expensive.
    headroom = 1.0 - peak
    queue_score = headroom * headroom
    queue_pen = queue_score * headroom

    # Rate-weighted mean latency to this pod's already-placed call-graph neighbours,
    # the worst single link, and the fraction of traffic crossing tiers.
    weighted = 0.0
    weight = 0.0
    max_latency = 0.0
    cross_penalty = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                lat = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * lat
                weight = weight + rate
                if lat > max_latency:
                    max_latency = lat
                neighbor_node = ctx.nodes[neighbor.current_node]
                if neighbor_node.tier != node.tier:
                    cross_penalty = cross_penalty + rate

    # A pod with no placed neighbours yet gets a neutral 0.5 rather than a free 1.0:
    # rewarding "no neighbours" would bias the very first replica of every service.
    proximity = 0.5
    if weight > 0.0:
        proximity = proximity_of(weighted / weight)

    tail = 1.0
    if max_latency > 0.0:
        tail = tail_of(max_latency)

    cross = 1.0
    if weight > 0.0:
        cross = 1.0 - min(cross_penalty / weight, 1.0)

    # Idle draw spans 1.8 W (far edge) to 108 W (the dev-1 fog server); the divisor
    # keeps the term bounded without hard-coding a tier test.
    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)

    return (
        queue_pen * 0.40
        + queue_score * 0.25
        + proximity * 0.20
        + tail * 0.10
        + cross * 0.03
        + efficiency * 0.02
    )

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            return out
        source_pod = state.pods[graph.src[e]]
        destination_pod = state.pods[graph.dst[e]]
        placed = source_pod.current_node >= 0 and destination_pod.current_node >= 0
        different = source_pod.current_node != destination_pod.current_node
        if placed and different:
            moved_before = moved
            src_node = state.nodes[source_pod.current_node]
            dst_node = state.nodes[destination_pod.current_node]

            src_cpu_cap = float(max(src_node.cpu_capacity, 1))
            src_mem_cap = float(max(src_node.mem_capacity, 1))
            src_cpu_now = float(src_node.cpu_allocated) / src_cpu_cap
            src_mem_now = float(src_node.mem_allocated) / src_mem_cap
            src_now = max(src_cpu_now, src_mem_now)

            dst_cpu_cap = float(max(dst_node.cpu_capacity, 1))
            dst_mem_cap = float(max(dst_node.mem_capacity, 1))
            dst_cpu_now = float(dst_node.cpu_allocated) / dst_cpu_cap
            dst_mem_now = float(dst_node.mem_allocated) / dst_mem_cap
            dst_now = max(dst_cpu_now, dst_mem_now)

            src_cpu_next = float(src_node.cpu_allocated + destination_pod.cpu_request) / src_cpu_cap
            src_mem_next = float(src_node.mem_allocated + destination_pod.mem_request) / src_mem_cap
            src_next = max(src_cpu_next, src_mem_next)

            dst_cpu_next = float(dst_node.cpu_allocated + source_pod.cpu_request) / dst_cpu_cap
            dst_mem_next = float(dst_node.mem_allocated + source_pod.mem_request) / dst_mem_cap
            dst_next = max(dst_cpu_next, dst_mem_next)

            src_movable = not source_pod.stateful and not source_pod.has_pdb
            dst_movable = not destination_pod.stateful and not destination_pod.has_pdb

            # Move source_pod onto destination_pod's node only when the target keeps
            # real burst margin afterwards and the source is genuinely hot.
            src_ok = (
                moved < budget
                and src_movable
                and not dst_node.suspended
                and dst_next < 0.50
                and src_now > 0.70
                and dst_next + 0.10 < src_now
            )

            # Symmetric move: destination_pod onto source_pod's node.
            dst_ok = (
                moved < budget
                and dst_movable
                and not src_node.suspended
                and src_next < 0.50
                and dst_now > 0.70
                and src_next + 0.10 < dst_now
            )

            if src_ok:
                out.append(move_pod(source_pod.id, destination_pod.current_node))
                moved = moved + 1
            if dst_ok and moved == moved_before:
                out.append(move_pod(destination_pod.id, source_pod.current_node))
                moved = moved + 1
    return out
# EVOLVE-BLOCK-END
