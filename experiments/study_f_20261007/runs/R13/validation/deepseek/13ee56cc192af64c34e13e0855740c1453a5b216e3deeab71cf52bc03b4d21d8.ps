# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_of(mean_latency_ms: float) -> float:
    scaled = mean_latency_ms / 45.0
    return 1.0 - min(scaled, 1.0)

def contains_int(values: list[int], target: int) -> bool:
    for v in values:
        if v == target:
            return True
    return False

def pod_movable(pod: Pod) -> bool:
    return not pod.stateful and not pod.has_pdb and pod.current_node >= 0

def node_has_room(node: NodeState, pod: Pod, limit: float) -> bool:
    if node.suspended:
        return False
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    return max(cpu_after, mem_after) < limit

def node_load(node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_util = float(node.cpu_allocated) / cpu_cap
    mem_util = float(node.mem_allocated) / mem_cap
    return max(cpu_util, mem_util)

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0
    headroom = 1.0 - peak
    queue = headroom
    if peak > 0.80:
        queue = headroom * 0.5

    weighted = 0.0
    weight = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                weighted = weighted + rate * node.latency_to_ms[neighbor.current_node]
                weight = weight + rate

    proximity = 0.5
    if weight > 0.0:
        proximity = proximity_of(weighted / weight)

    power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * peak
    energy = 1.0 - min(power / 120.0, 1.0)

    stability = 0.0
    if pod.current_node == node.id:
        stability = 0.05

    return queue * 0.45 + proximity * 0.40 + energy * 0.15 + stability

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    moved_ids: list[int] = []
    target_ids: list[int] = []
    edges = len(graph.src)

    for e in range(edges):
        if moved >= budget:
            return out
        rate = graph.rate[e]
        if rate >= 1.0 and moved < budget:
            source_pod = state.pods[graph.src[e]]
            destination_pod = state.pods[graph.dst[e]]
            placed = source_pod.current_node >= 0 and destination_pod.current_node >= 0
            different = source_pod.current_node != destination_pod.current_node
            if placed and different:
                src_movable = pod_movable(source_pod)
                dst_movable = pod_movable(destination_pod)
                src_new = not contains_int(moved_ids, source_pod.id)
                dst_new = not contains_int(moved_ids, destination_pod.id)

                if src_movable and src_new:
                    target_node = state.nodes[destination_pod.current_node]
                    target_new = not contains_int(target_ids, target_node.id)
                    if node_has_room(target_node, source_pod, 0.75) and target_new:
                        out.append(move_pod(source_pod.id, target_node.id))
                        moved = moved + 1
                        moved_ids.append(source_pod.id)
                        target_ids.append(target_node.id)
                    elif dst_movable and dst_new and moved < budget:
                        target_node = state.nodes[source_pod.current_node]
                        target_new = not contains_int(target_ids, target_node.id)
                        if node_has_room(target_node, destination_pod, 0.75) and target_new:
                            out.append(move_pod(destination_pod.id, target_node.id))
                            moved = moved + 1
                            moved_ids.append(destination_pod.id)
                            target_ids.append(target_node.id)
                elif dst_movable and dst_new and moved < budget:
                    target_node = state.nodes[source_pod.current_node]
                    target_new = not contains_int(target_ids, target_node.id)
                    if node_has_room(target_node, destination_pod, 0.75) and target_new:
                        out.append(move_pod(destination_pod.id, target_node.id))
                        moved = moved + 1
                        moved_ids.append(destination_pod.id)
                        target_ids.append(target_node.id)

    for p in state.pods:
        if moved >= budget:
            return out
        movable = pod_movable(p) and not contains_int(moved_ids, p.id)
        if movable:
            current_node = state.nodes[p.current_node]
            load = node_load(current_node)
            if load > 0.85:
                target_id = -1
                nodes = len(state.nodes)
                for n in range(nodes):
                    if target_id < 0:
                        candidate = state.nodes[n]
                        target_new = not contains_int(target_ids, candidate.id)
                        if candidate.id != p.current_node and target_new and node_has_room(candidate, p, 0.60):
                            target_id = candidate.id
                if target_id >= 0:
                    out.append(move_pod(p.id, target_id))
                    moved = moved + 1
                    moved_ids.append(p.id)
                    target_ids.append(target_id)

    return out
# EVOLVE-BLOCK-END
