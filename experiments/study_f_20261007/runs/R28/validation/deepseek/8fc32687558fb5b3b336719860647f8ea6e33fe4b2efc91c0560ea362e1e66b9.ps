# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def proximity_score(mean_latency: float, max_latency: float) -> float:
    mean_score = 1.0 - min(mean_latency / 35.0, 1.0)
    max_score = 1.0 - min(max_latency / 90.0, 1.0)
    return mean_score * 0.65 + max_score * 0.35

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0

    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 1.0:
        return -1000000.0

    headroom = 1.0 - peak
    headroom = headroom * headroom

    weighted = 0.0
    weight = 0.0
    max_latency = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                latency = node.latency_to_ms[neighbor.current_node]
                weighted = weighted + rate * latency
                weight = weight + rate
                if latency > max_latency:
                    max_latency = latency

    proximity = 0.45
    if weight > 0.0:
        mean_latency = weighted / weight
        proximity = proximity_score(mean_latency, max_latency)

    cpu_ratio = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    power_after = node.power_idle_w + (node.power_max_w - node.power_idle_w) * cpu_ratio
    energy_score = 1.0 - min(power_after / 150.0, 1.0)

    return headroom * 0.40 + proximity * 0.35 + energy_score * 0.25

def node_power(node: NodeState, cpu_allocated: int) -> float:
    cap = float(max(node.cpu_capacity, 1))
    ratio = float(cpu_allocated) / cap
    return node.power_idle_w + (node.power_max_w - node.power_idle_w) * ratio

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out

    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        if moved < budget:
            rate = graph.rate[e]
            if rate > 1.0:
                sp = state.pods[graph.src[e]]
                dp = state.pods[graph.dst[e]]
                placed = sp.current_node >= 0 and dp.current_node >= 0
                if placed and sp.current_node != dp.current_node:
                    target = state.nodes[dp.current_node]
                    cpu_cap = float(max(target.cpu_capacity, 1))
                    mem_cap = float(max(target.mem_capacity, 1))
                    cpu_after = float(target.cpu_allocated + sp.cpu_request) / cpu_cap
                    mem_after = float(target.mem_allocated + sp.mem_request) / mem_cap
                    peak = max(cpu_after, mem_after)

                    current = state.nodes[sp.current_node]
                    source_before = node_power(current, current.cpu_allocated)
                    target_before = node_power(target, target.cpu_allocated)
                    source_after = node_power(current, current.cpu_allocated - sp.cpu_request)
                    target_after = node_power(target, target.cpu_allocated + sp.cpu_request)
                    delta = (source_after + target_after) - (source_before + target_before)

                    sp_movable = not sp.stateful and not sp.has_pdb
                    beneficial = delta < -0.5 or (rate > 3.0 and peak < 0.55 and delta < 0.5)
                    eligible = sp_movable and not target.suspended and peak < 0.70 and beneficial

                    if eligible:
                        out.append(move_pod(sp.id, dp.current_node))
                        moved = moved + 1

                    if not eligible and moved < budget:
                        target2 = state.nodes[sp.current_node]
                        cpu_cap2 = float(max(target2.cpu_capacity, 1))
                        mem_cap2 = float(max(target2.mem_capacity, 1))
                        cpu_after2 = float(target2.cpu_allocated + dp.cpu_request) / cpu_cap2
                        mem_after2 = float(target2.mem_allocated + dp.mem_request) / mem_cap2
                        peak2 = max(cpu_after2, mem_after2)

                        current2 = state.nodes[dp.current_node]
                        source_before2 = node_power(current2, current2.cpu_allocated)
                        target_before2 = node_power(target2, target2.cpu_allocated)
                        source_after2 = node_power(current2, current2.cpu_allocated - dp.cpu_request)
                        target_after2 = node_power(target2, target2.cpu_allocated + dp.cpu_request)
                        delta2 = (source_after2 + target_after2) - (source_before2 + target_before2)

                        dp_movable = not dp.stateful and not dp.has_pdb
                        beneficial2 = delta2 < -0.5 or (rate > 3.0 and peak2 < 0.55 and delta2 < 0.5)
                        eligible2 = moved < budget and dp_movable and not target2.suspended and peak2 < 0.70 and beneficial2

                        if eligible2:
                            out.append(move_pod(dp.id, sp.current_node))
                            moved = moved + 1

    return out
# EVOLVE-BLOCK-END
