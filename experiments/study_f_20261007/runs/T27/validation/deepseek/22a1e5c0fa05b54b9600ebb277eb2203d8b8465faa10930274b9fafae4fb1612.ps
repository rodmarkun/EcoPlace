# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    total = 0.0
    m = len(ctx.graph.src)
    for e in range(m):
        s = ctx.graph.src[e]
        d = ctx.graph.dst[e]
        other = -1
        if s == pod.id:
            other = d
        if d == pod.id:
            other = s
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                total += ctx.graph.rate[e] * node.latency_to_ms[neighbor.current_node]
    cpu_head = node.cpu_capacity - node.cpu_allocated - pod.cpu_request
    mem_head = node.mem_capacity - node.mem_allocated - pod.mem_request
    if cpu_head < 0 or mem_head < 0:
        return -1.0e9
    headroom = float(cpu_head) + float(mem_head)
    util_num = node.cpu_allocated + pod.cpu_request
    util_den = node.cpu_capacity
    util = float(util_num) / float(util_den)
    power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * util
    if node.suspended:
        return -1.0e9
    alloc_bonus = float(node.cpu_allocated) * 0.0005
    return -total * 0.5 + headroom * 0.001 - power * 0.05 + alloc_bonus

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    m = len(graph.src)
    for e in range(m):
        if moved < budget:
            s = graph.src[e]
            d = graph.dst[e]
            sp = state.pods[s]
            dp = state.pods[d]
            both_placed = sp.current_node >= 0 and dp.current_node >= 0
            diff_nodes = sp.current_node != dp.current_node
            if both_placed and diff_nodes:
                sp_movable = not sp.stateful and not sp.has_pdb
                dp_movable = not dp.stateful and not dp.has_pdb
                if sp_movable:
                    src = state.nodes[sp.current_node]
                    dest = state.nodes[dp.current_node]
                    fits = dest.cpu_capacity - dest.cpu_allocated >= sp.cpu_request and dest.mem_capacity - dest.mem_allocated >= sp.mem_request
                    better = src.power_idle_w > dest.power_idle_w or src.cpu_allocated < dest.cpu_allocated
                    if fits and not dest.suspended and better:
                        out.append(move_pod(sp.id, dp.current_node))
                        moved += 1
                elif dp_movable:
                    src = state.nodes[dp.current_node]
                    dest = state.nodes[sp.current_node]
                    fits = dest.cpu_capacity - dest.cpu_allocated >= dp.cpu_request and dest.mem_capacity - dest.mem_allocated >= dp.mem_request
                    better = src.power_idle_w > dest.power_idle_w or src.cpu_allocated < dest.cpu_allocated
                    if fits and not dest.suspended and better:
                        out.append(move_pod(dp.id, sp.current_node))
                        moved += 1
    return out
# EVOLVE-BLOCK-END
