# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.suspended:
        return -1000000.0
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_after = float(node.cpu_allocated + pod.cpu_request) / cpu_cap
    mem_after = float(node.mem_allocated + pod.mem_request) / mem_cap
    peak = max(cpu_after, mem_after)
    if peak > 0.85:
        return -1000000.0

    weighted = 0.0
    weight = 0.0
    edges = len(ctx.graph.src)
    for e in range(edges):
        source = ctx.graph.src[e]
        destination = ctx.graph.dst[e]
        other = -1
        if source == pod.id:
            other = destination
        if destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = ctx.pods[other]
            if neighbor.current_node >= 0:
                rate = ctx.graph.rate[e]
                weighted = weighted + rate * node.latency_to_ms[neighbor.current_node]
                weight = weight + rate
    proximity = 0.5
    if weight > 0.0:
        mean_lat = weighted / weight
        scaled = mean_lat / 45.0
        proximity = 1.0 - min(scaled, 1.0)

    active = 0.0
    if node.cpu_allocated > 0 or node.mem_allocated > 0:
        active = 1.0

    efficiency = 1.0 - min(node.power_idle_w / 120.0, 1.0)

    return proximity * 0.50 + active * 0.30 + efficiency * 0.20

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0:
        return out
    moved = 0
    edges = len(graph.src)
    for e in range(edges):
        if moved >= budget:
            return out
        src_pod = state.pods[graph.src[e]]
        dst_pod = state.pods[graph.dst[e]]
        placed = src_pod.current_node >= 0 and dst_pod.current_node >= 0
        same = src_pod.current_node == dst_pod.current_node
        movable = placed and not same and not src_pod.stateful and not src_pod.has_pdb and not dst_pod.stateful and not dst_pod.has_pdb
        if movable:
            src_node = state.nodes[src_pod.current_node]
            dst_node = state.nodes[dst_pod.current_node]
            src_cpu_cap = float(max(src_node.cpu_capacity, 1))
            src_mem_cap = float(max(src_node.mem_capacity, 1))
            src_cpu = float(src_node.cpu_allocated) / src_cpu_cap
            src_mem = float(src_node.mem_allocated) / src_mem_cap
            src_peak = max(src_cpu, src_mem)
            dst_cpu_cap = float(max(dst_node.cpu_capacity, 1))
            dst_mem_cap = float(max(dst_node.mem_capacity, 1))
            dst_cpu = float(dst_node.cpu_allocated) / dst_cpu_cap
            dst_mem = float(dst_node.mem_allocated) / dst_mem_cap
            dst_peak = max(dst_cpu, dst_mem)
            target_node_id = -1
            pod_to_move = src_pod
            target_node = dst_node
            if src_peak < dst_peak and src_peak < 0.40:
                target_node_id = dst_pod.current_node
                pod_to_move = src_pod
                target_node = dst_node
            elif dst_peak < src_peak and dst_peak < 0.40:
                target_node_id = src_pod.current_node
                pod_to_move = dst_pod
                target_node = src_node
            if target_node_id >= 0:
                t_cpu_cap = float(max(target_node.cpu_capacity, 1))
                t_mem_cap = float(max(target_node.mem_capacity, 1))
                cpu_after = float(target_node.cpu_allocated + pod_to_move.cpu_request) / t_cpu_cap
                mem_after = float(target_node.mem_allocated + pod_to_move.mem_request) / t_mem_cap
                peak_after = max(cpu_after, mem_after)
                if peak_after < 0.80 and not target_node.suspended:
                    out.append(move_pod(pod_to_move.id, target_node_id))
                    moved = moved + 1
    return out
# EVOLVE-BLOCK-END
