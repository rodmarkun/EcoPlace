# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def headroom_score(requested: int, capacity: int) -> int:
    if capacity == 0 or requested > capacity:
        return 0
    return ((capacity - requested) * 100) // capacity

def incremental_power(node: NodeState, cpu_after: int) -> float:
    if node.cpu_capacity == 0:
        return 1000000.0
    util = float(cpu_after) / float(node.cpu_capacity)
    if util > 1.0:
        util = 1.0
    power = node.power_idle_w + (node.power_max_w - node.power_idle_w) * util
    if node.suspended:
        power += 50.0
    return power

def critical_latency(pod: Pod, node: NodeState, pods: list[Pod], graph: CallGraphCtx) -> float:
    worst = 0.0
    for edge in range(len(graph.src)):
        source = graph.src[edge]
        destination = graph.dst[edge]
        other = -1
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source
        if other >= 0 and other != pod.id:
            neighbor = pods[other]
            if neighbor.current_node >= 0:
                lat = node.latency_to_ms[neighbor.current_node]
                if lat > worst:
                    worst = lat
    return worst

def placement_score(pod: Pod, node: NodeState, cpu_after: int, mem_after: int, pods: list[Pod], graph: CallGraphCtx) -> float:
    if node.suspended:
        return -1000000.0
    if node.cpu_capacity == 0 or node.mem_capacity == 0:
        return -1000000.0
    if cpu_after > node.cpu_capacity or mem_after > node.mem_capacity:
        return -1000000.0
    cpu_head = headroom_score(cpu_after, node.cpu_capacity)
    mem_head = headroom_score(mem_after, node.mem_capacity)
    head = float(min(cpu_head, mem_head))
    lat = critical_latency(pod, node, pods, graph)
    power = incremental_power(node, cpu_after)
    cpu_util = float(cpu_after) / float(node.cpu_capacity)
    mem_util = float(mem_after) / float(node.mem_capacity)
    queue = cpu_util
    if mem_util > queue:
        queue = mem_util
    if queue > 1.0:
        queue = 1.0
    cost = lat * 120.0 + power * 0.03 + queue * 200.0 - head * 0.5
    if head < 20.0:
        cost += 150.0
    if node.cpu_allocated == 0 and node.suspendable:
        cost += 30.0
    return -cost

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    return placement_score(pod, node, cpu_after, mem_after, ctx.pods, ctx.graph)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    moves = 0
    for i in range(len(state.pods)):
        if moves >= budget:
            return out
        pod = state.pods[i]
        if pod.current_node >= 0:
            current = state.nodes[pod.current_node]
            cpu_after = current.cpu_allocated
            mem_after = current.mem_allocated
            current_score = placement_score(pod, current, cpu_after, mem_after, state.pods, graph)
            best_score = current_score
            best_node = -1
            margin = 2.0
            if pod.stateful:
                margin = 12.0
            if pod.has_pdb:
                margin = margin + 6.0
            margin = margin + float(pod.image_mb) * 0.01
            for j in range(len(state.nodes)):
                if j != pod.current_node:
                    node = state.nodes[j]
                    cpu_after = node.cpu_allocated + pod.cpu_request
                    mem_after = node.mem_allocated + pod.mem_request
                    fits = cpu_after <= node.cpu_capacity and mem_after <= node.mem_capacity
                    if fits and not node.suspended:
                        cand = placement_score(pod, node, cpu_after, mem_after, state.pods, graph)
                        if cand > best_score + margin:
                            best_score = cand
                            best_node = j
            if best_node >= 0:
                out.append(move_pod(pod.id, best_node))
                moves += 1
    return out
# EVOLVE-BLOCK-END
