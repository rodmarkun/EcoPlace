# ruff: noqa: F821
# graph_headroom — evolution seed for the dev-continuum-* family.  Identity stays
# outside EVOLVE-BLOCKs; Shinka operators may change only the implementation below.
#
# Why this seed and not `least_allocated` (the dev-medium-hot seed): on this family the
# dependency-blind policies are *infeasible* (worst SLO 0.88 against a 0.90 target), so
# seeding from one would start every arm outside the feasible region and turn the first
# half of every campaign into a feasibility hunt rather than a search.  This seed is the
# most SLO-margined feasible hand-written policy (0.95); it is also the *expensive* one
# (1.27 normalized energy against `latency_greedy`'s 0.83), which is deliberate — the
# search starts feasible and has an explicit, large energy gap to close rather than
# starting at the best baseline with nowhere to go.
POLICY_NAME: str = "graph_headroom"
POLICY_VERSION: str = "1.0.0"

# EVOLVE-BLOCK-START
def queue_pressure(utilization: float) -> float:
    headroom = max(1.0 - utilization, 0.01)
    excess = max(utilization - 0.45, 0.0)
    burst = max(utilization - 0.65, 0.0)
    saturation = max(utilization - 0.80, 0.0)
    return 8.0 * utilization / headroom + 320.0 * excess * excess + 1800.0 * burst * burst + 6000.0 * saturation * saturation

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    if node.cpu_capacity <= 0 or node.mem_capacity <= 0:
        return -1000000000.0

    cpu_after = node.cpu_allocated + pod.cpu_request
    mem_after = node.mem_allocated + pod.mem_request
    if pod.current_node == node.id:
        cpu_after = node.cpu_allocated
        mem_after = node.mem_allocated

    if cpu_after > node.cpu_capacity or mem_after > node.mem_capacity:
        return -1000000000.0

    cpu_before = float(node.cpu_allocated) / float(node.cpu_capacity)
    cpu = float(cpu_after) / float(node.cpu_capacity)
    mem = float(mem_after) / float(node.mem_capacity)
    cpu_share = float(pod.cpu_request) / float(node.cpu_capacity)
    pressure = queue_pressure(cpu)

    link_total = 0.0
    incoming_peak = 0.0
    outgoing_peak = 0.0
    incoming_path = 0.0
    outgoing_path = 0.0
    degree = 0

    for edge in range(len(ctx.graph.src)):
        source = ctx.graph.src[edge]
        destination = ctx.graph.dst[edge]
        other = -1
        incoming = False
        if source == pod.id:
            other = destination
        elif destination == pod.id:
            other = source
            incoming = True

        if other >= 0 and other < len(ctx.pods) and other != pod.id:
            degree += 1
            location = ctx.pods[other].current_node
            latency = 0.0
            neighbor_pressure = 0.0

            if location >= 0 and location < len(node.latency_to_ms):
                latency = node.latency_to_ms[location]

            if location >= 0 and location < len(ctx.nodes):
                neighbor = ctx.nodes[location]
                if incoming and node.id >= 0 and node.id < len(neighbor.latency_to_ms):
                    latency = neighbor.latency_to_ms[node.id]
                if neighbor.cpu_capacity > 0:
                    neighbor_allocated = neighbor.cpu_allocated
                    if location == pod.current_node and location != node.id:
                        neighbor_allocated = max(neighbor_allocated - pod.cpu_request, 0)
                    neighbor_cpu = float(neighbor_allocated) / float(neighbor.cpu_capacity)
                    if location == node.id:
                        neighbor_cpu = cpu
                    neighbor_pressure = queue_pressure(neighbor_cpu)

            if location == node.id:
                latency = 0.0

            link_total += latency
            path = latency * (1.0 + 0.035 * neighbor_pressure)
            path += 0.25 * neighbor_pressure
            if incoming:
                incoming_peak = max(incoming_peak, latency)
                incoming_path = max(incoming_path, path)
            else:
                outgoing_peak = max(outgoing_peak, latency)
                outgoing_path = max(outgoing_path, path)

    connectivity = min(float(degree), 8.0)
    path_cost = 0.75 * link_total
    path_cost += 2.0 * (incoming_peak + outgoing_peak)
    path_cost += 2.0 * (incoming_path + outgoing_path)

    resident_count = 0
    for index in range(len(ctx.pods)):
        if ctx.pods[index].current_node == node.id and ctx.pods[index].id != pod.id:
            resident_count += 1

    exposure = min(float(resident_count), 8.0)
    queue_delta = max(pressure - queue_pressure(cpu_before), 0.0)
    queue_cost = pressure * (1.0 + 0.18 * connectivity)
    queue_cost += queue_delta * (2.5 + 0.20 * exposure)
    queue_cost += 16.0 * cpu_share / max(1.0 - cpu, 0.01)

    mem_excess = max(mem - 0.65, 0.0)
    mem_burst = max(mem - 0.80, 0.0)
    queue_cost += 500.0 * mem_excess * mem_excess
    queue_cost += 2400.0 * mem_burst * mem_burst

    dynamic_power = max(node.power_max_w - node.power_idle_w, 0.0)
    energy_cost = dynamic_power * cpu_share
    if pod.current_node == node.id:
        energy_cost = 0.0
    elif node.suspended:
        energy_cost += node.power_idle_w
    elif node.cpu_allocated == 0 and node.suspendable:
        energy_cost += node.power_idle_w

    cpu_margin = max(0.50 - cpu, 0.0) / 0.50
    mem_margin = max(0.65 - mem, 0.0) / 0.65
    safety_margin = min(cpu_margin, mem_margin)
    energy_weight = 0.001 + 0.16 * safety_margin * safety_margin

    return -(path_cost + queue_cost + energy_weight * energy_cost)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    return out
# EVOLVE-BLOCK-END
