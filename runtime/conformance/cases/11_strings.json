[
 {
  "name": "string_escapes",
  "source": "def f() -> str:\n    return \"a\\n\\t\\\"q\\\"\"\n",
  "expect": {
   "value": {
    "S": "a\n\t\"q\""
   }
  },
  "func": "f"
 },
 {
  "name": "string_single_quotes",
  "source": "def f() -> str:\n    return 'ok'\n",
  "expect": {
   "value": {
    "S": "ok"
   }
  },
  "func": "f"
 },
 {
  "name": "string_unicode",
  "source": "def f() -> str:\n    return \"\u03bb\u2192\"\n",
  "expect": {
   "value": {
    "S": "\u03bb\u2192"
   }
  },
  "func": "f"
 },
 {
  "name": "string_concat_rejected",
  "source": "def f() -> str:\n    return \"a\" + \"b\"\n",
  "expect": {
   "error": "type"
  }
 }
]
