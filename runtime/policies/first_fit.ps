# Per-pod FirstFit: native filtering removes nodes that cannot host the pending pod,
# and stable node id supplies the bin order. Full-queue decreasing order belongs to
# the contextual FFD assignment baseline, not this reusable scorer contract.
POLICY_NAME: str = "first_fit"
POLICY_VERSION: str = "1.0.0"

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return -float(node.id)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    return out
