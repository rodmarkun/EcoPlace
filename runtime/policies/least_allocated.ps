# least_allocated — a heuristic seed *inspired by* kube-scheduler's NodeResourcesFit
# "LeastAllocated" scoring (prefer the node with the most free capacity after placement;
# spreading). It is NOT a faithful reproduction of the plugin. Known divergences:
# continuous [0,1] scores instead of integer 0..100; actual requests instead of
# NonZeroRequested defaulting (100m CPU / 200Mi memory for zero requests); equal
# CPU/memory weighting instead of configured resource weights. Ties and final node
# choice can differ from the native plugin. The faithful reproduction with golden
# comparisons against the pinned Kubernetes plugin is TODO 6.1 (baselines phase);
# this file only seeds evolution and sanity-checks the runtime (TODO 1.7).
# Proposer: move movable pods from the most- to the least-utilized awake node when the
# imbalance is large.
POLICY_NAME: str = "least_allocated"
POLICY_VERSION: str = "1.0.0"

def free_fraction_after(pod: Pod, node: NodeState) -> float:
    cpu_cap = float(max(node.cpu_capacity, 1))
    mem_cap = float(max(node.mem_capacity, 1))
    cpu_free = cpu_cap - float(node.cpu_allocated + pod.cpu_request)
    mem_free = mem_cap - float(node.mem_allocated + pod.mem_request)
    cpu_frac = max(cpu_free, 0.0) / cpu_cap
    mem_frac = max(mem_free, 0.0) / mem_cap
    return (cpu_frac + mem_frac) / 2.0

def cpu_util(node: NodeState) -> float:
    return float(node.cpu_allocated) / float(max(node.cpu_capacity, 1))

def score(pod: Pod, node: NodeState, ctx: ClusterCtx) -> float:
    return free_fraction_after(pod, node)

def propose_moves(state: ClusterState, graph: CallGraphCtx, budget: int) -> list[Move]:
    out: list[Move] = []
    if budget <= 0 or len(state.nodes) < 2:
        return out
    hi = -1
    hi_u = -1.0
    lo = -1
    lo_u = 2.0
    for node in state.nodes:
        if not node.suspended:
            u = cpu_util(node)
            if u > hi_u:
                hi_u = u
                hi = node.id
            if u < lo_u:
                lo_u = u
                lo = node.id
    if hi < 0 or lo < 0 or hi == lo:
        return out
    if hi_u - lo_u < 0.25:
        return out
    moved = 0
    for pod in state.pods:
        if moved < budget and pod.current_node == hi:
            if not pod.stateful and not pod.has_pdb:
                out.append(move_pod(pod.id, lo))
                moved += 1
    return out
